<Xpf:GridTemplate   x:Class="SmartEMR.Application.Template.RCP_StatusTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk.SmartEMRDeskRCB"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:Label  Content="{Binding vRCP_Status}" 
                Foreground="{Binding RCP_Status, Converter={converter:RCPStatusToBrushConverter}}"
                BorderBrush="{Binding RCP_Status, Converter={converter:RCPStatusToBrushConverter}}"
                BorderThickness="1"
                Background="Transparent"
                Height="23"
                Margin="2">
    </Xpf:Label>
</Xpf:GridTemplate>
