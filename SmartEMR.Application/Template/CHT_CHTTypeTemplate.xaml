<Xpf:GridTemplate x:Class="SmartEMR.Application.Template.CHT_CHTTypeTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Template"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             mc:Ignorable="d"
             Width="32"
             Height="22"
             MouseLeftButtonDown="OnMouseLeftButtonDown_CHTTypeTemplate">
    
    <Xpf:GridTemplate.ContentTemplate>
        <DataTemplate>
            <Border Background="Transparent">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Black"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="2"></Setter>

                        <Style.Triggers>
                            <!-- 예약 -->
                            <DataTrigger Binding="{Binding CHT_CHTType}" Value="RES">
                                <Setter Property="Background" Value="#E0F2FE"/>
                                <Setter Property="BorderBrush" Value="#38BDF8"/>
                            </DataTrigger>

                            <!-- 접수 -->
                            <DataTrigger Binding="{Binding CHT_CHTType}" Value="CHT">
                                <Setter Property="Background" Value="#DCFCE7"/>
                                <Setter Property="BorderBrush" Value="#4ADE80"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Xpf:TextBlock  Text="{Binding vCHT_CHTType}"
                                FontSize="10"
                                Foreground="White"
                                FontWeight="SemiBold"/>
            </Border>

            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"></Setter>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Xpf:GridTemplate.ContentTemplate>

</Xpf:GridTemplate>

    