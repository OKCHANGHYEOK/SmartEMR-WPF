<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter">

    <DataTemplate x:Key="CalendarHeaderItemTemplate">
        <Xpf:StyleGrid LayoutDefinitions="1,2"
                       HorizontalAlignment="Stretch"
                       Background="{Binding DayOfWeek, Converter={converter:DayOfWeekToBackgroundConverter}}">

            <Xpf:TextBlock  Grid.Row="0"
                            Text="{Binding Date, Converter={converter:DateTimeToStringConverter DisplayFormat='yyyy-MM-dd'}}" 
                            FontWeight="Bold"
                            Foreground="#4B5563"
                            Margin="4"/>

            <Xpf:TextBlock  Grid.Row="1"
                            Text="{Binding DayOfWeek, Converter={converter:DayOfWeekToStringConverter}}"
                            FontWeight="Bold"
                            Foreground="{Binding DayOfWeek, Converter={converter:DayOfWeekToForegroundConverter}}"
                            Margin="4"/>
        </Xpf:StyleGrid>
    </DataTemplate>
</ResourceDictionary>