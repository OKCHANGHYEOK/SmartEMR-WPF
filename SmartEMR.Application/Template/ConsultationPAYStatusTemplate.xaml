<Xpf:GridTemplate   x:Class="SmartEMR.Application.Template.ConsultationPAYStatusTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Template"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    xmlns:domain="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800"
                    d:DataContext="{d:DesignInstance Type={x:Type domain:Consultation}}">

    <Xpf:StyleGrid>
        <Xpf:Label Content="{Binding vCST_PayStatus}"
                   Foreground="{Binding CST_PayStatus, Converter={converter:PAYStatusToBrushConverter}}"
                   BorderBrush="{Binding CST_PayStatus, Converter={converter:PAYStatusToBrushConverter}}"
                   BorderThickness="1"
                   Background="Transparent"
                   HorizontalContentAlignment="Center"
                   Margin="2">

            <Xpf:Label.Style>
                <Style TargetType="{x:Type Xpf:Label}">
                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CST_PayStatus}" Value="NON">
                            <Setter Property="Visibility" Value="Collapsed"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Xpf:Label.Style>
        </Xpf:Label>

        <Xpf:Label Content="-"
                   HorizontalContentAlignment="Center"
                   VerticalAlignment="Center">

            <Xpf:Label.Style>
                <Style TargetType="{x:Type Xpf:Label}">
                    <Setter Property="Visibility" Value="Collapsed"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CST_PayStatus}" Value="NON">
                            <Setter Property="Visibility" Value="Visible"></Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Xpf:Label.Style>
        </Xpf:Label>
    </Xpf:StyleGrid>
</Xpf:GridTemplate>
