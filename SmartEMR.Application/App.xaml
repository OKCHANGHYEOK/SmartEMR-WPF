<Application x:Class="SmartEMR.Application.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartEMR.Application"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
             xmlns:calendar="clr-namespace:SmartEMR.Application.Views.SmartEMRRES.SmartEMRRESCalendarTab"
             ShutdownMode="OnExplicitShutdown">
    
    <Application.Resources>
        <ResourceDictionary>
            <converter:SvgPathConverter x:Key="SvgPathConverter"/>
            <converter:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

            <DataTemplate x:Key="CalendarHeaderItemTemplate"> 
                <Xpf:StyleGrid LayoutDefinitions="1,2"
                               HorizontalAlignment="Stretch"
                               Background="{Binding DayOfWeek, Converter={converter:DayOfWeekToBackgroundConverter}}">
                    <Xpf:TextBlock  Grid.Row="0"
                                    Text="{Binding Date, Converter={converter:DateTimeToStringConverter DisplayFormat='yyyy-MM-dd'}}" 
                                    FontWeight="Bold"
                                    Foreground="#4B5563"
                                    Margin="4"/>

                    <Xpf:TextBlock  Grid.Row="1"
                                    Text="{Binding DayOfWeek, Converter={converter:DayOfWeekToStringConverter}}"
                                    FontWeight="Bold"
                                    Foreground="{Binding DayOfWeek, Converter={converter:DayOfWeekToForegroundConverter}}"
                                    Margin="4"/>
                </Xpf:StyleGrid>
            </DataTemplate>

            <Style TargetType="{x:Type Xpf:Label}">
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>

            <Style TargetType="{x:Type Xpf:TextBlock}">
                <Setter Property="MinWidth" Value="24"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#333333"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
