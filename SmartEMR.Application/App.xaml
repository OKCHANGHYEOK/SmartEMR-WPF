<Application x:Class="SmartEMR.Application.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SmartEMR.Application"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
             ShutdownMode="OnExplicitShutdown">
    
    <Application.Resources>
        <ResourceDictionary>
            <converter:SvgPathConverter x:Key="SvgPathConverter"/>
            <converter:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>

            <Style TargetType="{x:Type Xpf:Label}">
                <Setter Property="MinWidth" Value="10"/>
                <Setter Property="MinHeight" Value="10"/>
                <Setter Property="Foreground" Value="Black"/>
                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="Padding" Value="0"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
