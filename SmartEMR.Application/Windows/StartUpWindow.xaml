<Window   x:Class="SmartEMR.Application.Windows.StartUpWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:views="clr-namespace:SmartEMR.Application.Views"
          xmlns:auth="clr-namespace:SmartEMR.Application.Views.Authentication"
          mc:Ignorable="d" 
          Title="SmartEMR"
          Width="1100"
          Height="780"    
          WindowStyle="None"
          AllowsTransparency="True"
          Background="Transparent"
          ResizeMode="NoResize"
          WindowStartupLocation="CenterScreen"
          ShowInTaskbar="False">

    <Border Margin="20"
            CornerRadius="12"
            BorderBrush="#D9E1EA"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect   BlurRadius="25"
                                ShadowDepth="0"
                                Opacity="0.18"/>
        </Border.Effect>

        <auth:vStartUp/>
    </Border>
</Window>
    
    