<Window   x:Class="SmartEMR.Application.Windows.StartUpWindow"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:views="clr-namespace:SmartEMR.Application.Views"
          xmlns:auth="clr-namespace:SmartEMR.Application.Views.Authentication"
          xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
          mc:Ignorable="d" 
          Title="SmartEMR"
          Width="1100"
          Height="780"    
          WindowStyle="None"
          AllowsTransparency="True"
          Background="Transparent"
          ResizeMode="NoResize"
          WindowStartupLocation="CenterScreen">

    <Border CornerRadius="12"
            BorderBrush="#D9E1EA"
            BorderThickness="1">

        <Border.Effect>
            <DropShadowEffect   BlurRadius="25"
                                ShadowDepth="0"
                                Opacity="0.18"/>
        </Border.Effect>

        <Xpf:StyleGrid  LayoutDefinitions="1,2"
                        RowSizeDefinitions="36,*">

            <Border x:Name="HeaderBorder"
                    Grid.Row="0"
                    Background="#F8FAFC"
                    CornerRadius="12,12,0,0"
                    MouseLeftButtonDown="OnMouseLeftButtonDown_Header">

                <Xpf:StyleGrid LayoutDefinitions="3,1"
                               ColumnSizeDefinitions="Auto,*,Auto">

                    <StackPanel Orientation="Horizontal"
                                Margin="5,0,0,0">
                        <Border Width="16"
                                Height="16">
                            <Border.Background>
                                <ImageBrush ImageSource="/Images/smartemr_logo.png"/>
                            </Border.Background>
                        </Border>
                        
                        <Xpf:TextBlock Grid.Column="0"
                                       Text="SmartEMR"
                                       VerticalAlignment="Center"
                                       Foreground="#193458"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal">

                        <dxc:SimpleButton   x:Name="btnMinimize"
                                            Content="-"
                                            FontSize="15"
                                            Width="40"
                                            Height="36"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Click="OnClick_SimpleButton">

                            <dxc:SimpleButton.Style>
                                <Style TargetType="{x:Type dxc:SimpleButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#607A9A"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8EDF3"/>
                                            <Setter Property="Foreground" Value="#193458"/>
                                        </Trigger>

                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#D9E1EA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxc:SimpleButton.Style>
                        </dxc:SimpleButton>

                        <dxc:SimpleButton   x:Name="btnClose"
                                            Content="X"
                                            FontSize="15"
                                            Width="40"
                                            Height="36"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            CornerRadius="0,12,0,0"
                                            Cursor="Hand"
                                            Click="OnClick_SimpleButton">
                            
                            <dxc:SimpleButton.Style>
                                <Style TargetType="{x:Type dxc:SimpleButton}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#607A9A"/>
                                    <Setter Property="BorderThickness" Value="0"/>

                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#E8EDF3"/>
                                            <Setter Property="Foreground" Value="#193458"/>
                                        </Trigger>

                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#D9E1EA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </dxc:SimpleButton.Style>
                        </dxc:SimpleButton>
                    </StackPanel>
                </Xpf:StyleGrid>
            </Border>

            <auth:vStartUp  x:Name="StartUpView"
                            Grid.Row="1"/>
        </Xpf:StyleGrid>
    </Border>
</Window>
    
    