<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.SmartEMRRES.vSmartEMRRESInfo"
                        x:TypeArguments="vm:ReservationInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRRES"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:resources="clr-namespace:SmartEMR.Application.Resources"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        xmlns:template="clr-namespace:SmartEMR.Application.Template"
                        xmlns:selections="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                        mc:Ignorable="d" 
                        d:DesignHeight="600" d:DesignWidth="500"
                        ViewSize="580,650">

    <dxd:DockLayoutManager x:Name="DockLayoutManager">
        <dxd:LayoutGroup Orientation="Vertical">
            <Xpf:LayoutPanel ItemHeight="0.7*">
                <Xpf:StyleGrid  LayoutDefinitions="1,3"
                                RowSizeDefinitions="Auto,Auto,*">

                    <Xpf:StyleGrid LayoutDefinitions="2,1"
                                   ColumnSizeDefinitions="Auto,*"
                                   VerticalContentAlignment="Center"
                                   Margin="0,0,0,2">
                        
                        <Xpf:CheckEdit x:Name="chkIsNewPAT"
                                       Grid.Column="0" 
                                       Content="신환예약" 
                                       FontWeight="SemiBold" 
                                       Margin="2,0,2,0" 
                                       EditValueChanged="OnEditValueChanged_CheckEdit"/>
                        <Xpf:SearchPanel Grid.Column="1" NullText="환자명/차트번호로 검색하세요." Margin="2,0,2,0"/>
                    </Xpf:StyleGrid>

                    <Border Grid.Column="0" 
                            Grid.ColumnSpan="2" 
                            Grid.Row="1" 
                            Height="4" 
                            BorderThickness="0,1,0,1"
                            BorderBrush="{x:Static resources:SmartBrush.SMART_BRUSH_SECTION_BORDER}"
                            Background="{x:Static resources:SmartBrush.SMART_BRUSH_SECTION_BACKGROUND}"
                            Margin="0,2,0,2"/>

                    <Xpf:BindGrid  Grid.Column="0"
                                   Grid.ColumnSpan="2"
                                   Grid.Row="2"
                                   BindStyle="DataCell"
                                   LayoutDefinitions="6,6"
                                   DataContext="{Binding SelectedPatient}">

                        <Xpf:BindItem FieldName="PAT_ImageSource"
                                      BindType="Image"
                                      Col="0"
                                      Row="0"
                                      ColSpan="2"
                                      RowSpan="6"
                                      Margin="2"
                                      IsHeader="False"
                                      IsBottomLine="False"/>

                        <Xpf:BindItem FieldName="PAT_ChartNo"
                                      Header="차 트 번 호"
                                      BindType="Label"
                                      Col="2"
                                      Row="0"
                                      ColSpan="2"
                                      FontWeight="Bold"/>

                        <Xpf:BindItem FieldName="PAT_Name"
                                      Header="성       명"
                                      Col="4"
                                      ColSpan="2"
                                      Row="0">

                            <StackPanel Orientation="Horizontal">
                                <Xpf:TextLink Text="{Binding PAT_Name}" FontWeight="Bold" Margin="2,0,0,0"/>
                                <Xpf:TextBlock Margin="2,0,0,0">
                                    <Run Text="{Binding vPAT_Sex}"/>
                                    <Run Foreground="Gray">/</Run>
                                    <Run Text="{Binding PAT_Age}"/>
                                </Xpf:TextBlock>
                                <Xpf:Label Content="{Binding vPAT_IsAgreePersonalInfo}" Margin="2,0,0,0"/>
                            </StackPanel>
                        </Xpf:BindItem>

                        <Xpf:BindItem   FieldName="PAT_RegisterNum"
                                        Header="주 민 번 호"
                                        BindType="Label"
                                        Col="2"
                                        ColSpan="2"
                                        Row="1"/>

                        <Xpf:BindItem   FieldName="PAT_BirthDate"
                                        Header="생 년 월 일"
                                        BindType="Label"
                                        Col="4"
                                        ColSpan="2"
                                        Row="1"/>

                        <Xpf:BindItem   FieldName="PAT_PhoneNum"
                                        BindType="Label"
                                        Header="전 화 번 호"
                                        Col="2"
                                        ColSpan="2"
                                        Row="2"/>

                        <Xpf:BindItem   FieldName="PAT_Email"
                                        Header="이 메 일"
                                        BindType="Label"
                                        Col="4"
                                        ColSpan="2"
                                        Row="2"/>

                        <Xpf:BindItem   FieldName="PAT_FirstVisitDate"
                                        Header="최 초 내 원"
                                        BindType="Label"
                                        Col="2"
                                        ColSpan="2"
                                        Row="3"/>

                        <Xpf:BindItem   FieldName="PAT_LastVisitDate"
                                        Header="최 종 내 원"
                                        BindType="Label"
                                        Col="4"
                                        ColSpan="2"
                                        Row="3"/>

                        <Xpf:BindItem   FieldName="PAT_Bigo"
                                        Header="비       고"
                                        BindType="Label"
                                        Col="2"
                                        ColSpan="4"
                                        Row="4"
                                        RowSpan="2"
                                        IsBottomLine="False"/>
                    </Xpf:BindGrid>
                    <Xpf:MaskControl Grid.Column="0"
                                     Grid.ColumnSpan="2"
                                     Grid.Row="2"
                                     MaskText="환자 선택시 표시됩니다."
                                     Visibility="{Binding Model.PAT_Idx, Converter={converter:IntToVisibilityConverter invert=True}}"
                                     ShowButton="False"/>
                </Xpf:StyleGrid>
            </Xpf:LayoutPanel>
            
            <dxd:LayoutGroup Orientation="Horizontal">
                <Xpf:LayoutPanel ItemWidth="0.4*" Caption="에약현황" AllowSizing="False" Padding="2">
                    <Xpf:StyleGrid>
                        <dxe:ListBoxEdit  x:Name="ReservationSlotListBox"
                                          ItemsSource="{Binding Reservations}" 
                                          BorderBrush="LightGray"
                                          dx:ThemeManager.ThemeName="Win11Light"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.CanContentScroll="False"
                                          EditValueChanged="OnEditValueChanged_ListBoxEdit">
                            <dxe:ListBoxEdit.ItemTemplate>
                                <DataTemplate>
                                    <local:ReservationItemTemplate MinHeight="26" Height="26"/>
                                </DataTemplate>
                            </dxe:ListBoxEdit.ItemTemplate>
                        </dxe:ListBoxEdit>
                    </Xpf:StyleGrid>
                </Xpf:LayoutPanel>
                <Xpf:LayoutPanel ItemWidth="0.6*" Caption="에약정보">
                    <Xpf:BindGrid LayoutDefinitions="2,7"
                                  BindStyle="DataCell"
                                  ItemSpace="2">

                        <x:Array Type="{x:Type Xpf:BindItem}">
                            <Xpf:BindItem   FieldName="RES_ReservationDate"
                                            Header="예 약 일 시"
                                            BindType="DateEdit"
                                            Col="0"
                                            ColSpan="2"
                                            Row="0"/>

                            <Xpf:BindItem   FieldName="RES_ReservationTime"
                                            BindType="ComboBox"
                                            Width="100"
                                            ItemsSource="{x:Static selections:InputOptionItems.ReservationTimes}"
                                            DisplayMember="attrName"
                                            ValueMember="attrValue"/>
                        </x:Array>

                        <x:Array Type="{x:Type Xpf:BindItem}">
                            <Xpf:BindItem   FieldName="RES_Subject"
                                            Header="접 수 과 목"
                                            BindType="ComboBox"
                                            Col="0"
                                            Row="1"
                                            ColSpan="2"
                                            ItemsSource="{x:Static selections:InputOptionItems.Subjects}"
                                            DisplayMember="CCI_Name"
                                            ValueMember="CCI_Cd"/>

                            <Xpf:BindItem FieldName="RES_SubjectName"
                                          BindType="TextBox"
                                          Width="100"
                                          FontSize="12"
                                          Placeholder="직접입력"
                                          IsEnabled="False"/>
                        </x:Array>

                        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                                        Header="담  당  의"
                                        BindType="ComboBox"
                                        Col="0"
                                        Row="2"
                                        ItemsSource="{x:Static selections:InputOptionItems.Docters}"
                                        DisplayMember="MUR_Name"
                                        ValueMember="MUR_Idx"/>

                        <Xpf:BindItem   FieldName="MUR_Idx_STF"
                                        Header="담 당 직 원"
                                        BindType="ComboBox"
                                        Col="1"
                                        Row="2"
                                        ItemsSource="{x:Static selections:InputOptionItems.Staffs}"
                                        DisplayMember="MUR_Name"
                                        ValueMember="MUR_Idx"/>

                        <Xpf:BindItem   FieldName="RES_Route"
                                        Header="예 약 경 로"
                                        BindType="ComboBox"
                                        Col="0"
                                        Row="3"
                                        ItemsSource="{x:Static selections:InputOptionItems.RouteTypes}"
                                        DisplayMember="CCI_Name"
                                        ValueMember="CCI_Cd"/>

                        <Xpf:BindItem   FieldName="RES_Memo"
                                        Header="예 약 메 모"
                                        BindType="TextBox"
                                        Col="0"
                                        ColSpan="2"
                                        Row="4"
                                        RowSpan="3"
                                        Margin="1"
                                        ContentAlignment="LeftTop"
                                        IsBottomLine="False"/>
                    </Xpf:BindGrid>
                </Xpf:LayoutPanel>
            </dxd:LayoutGroup>
            <Xpf:LayoutPanel ItemHeight="Auto" ShowBorder="False" AllowSizing="False">
                <Xpf:StyleGrid  LayoutDefinitions="3,1"
                                ColumnSizeDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">

                    <Xpf:Button x:Name="btnCancel"
                                Grid.Column="0"
                                Width="85"
                                Height="27"
                                Content="예약취소"
                                FontWeight="SemiBold"
                                Glyph="/Images/smartemr_cancel.png"
                                VerticalContentAlignment="Center"
                                Margin="2,0,0,0"
                                Visibility="{Binding Model.RES_Idx, Converter={converter:IntToVisibilityConverter}}"/>

                    <dx:SimpleButton    x:Name="btnSave"
                                        Grid.Column="2"
                                        Content="{Binding ViewTitle, RelativeSource={RelativeSource AncestorType=local:vSmartEMRRESInfo}}"
                                        Padding="2"
                                        Width="85"
                                        Height="27"
                                        FontWeight="SemiBold"
                                        Glyph="/Images/smartemr_save.png"
                                        VerticalContentAlignment="Center"
                                        Margin="0"/>
                </Xpf:StyleGrid>
            </Xpf:LayoutPanel>
        </dxd:LayoutGroup>
    </dxd:DockLayoutManager>
</base:ModelViewLayout>
