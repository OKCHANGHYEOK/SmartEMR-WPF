<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.SmartEMRRES.vSmartEMRRESInfo"
                        x:TypeArguments="vm:ReservationInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRRES"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:resources="clr-namespace:SmartEMR.Application.Resources"
                        xmlns:common="clr-namespace:SmartEMR.Application.Common"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        xmlns:template="clr-namespace:SmartEMR.Application.Template"
                        xmlns:selections="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                        mc:Ignorable="d" 
                        d:DesignHeight="600" d:DesignWidth="500"
                        ViewSize="580,800">

    <dxd:DockLayoutManager x:Name="DockLayoutManager">
        <dxd:LayoutGroup Orientation="Vertical">
            <Xpf:LayoutPanel ItemHeight="0.8*">
                <Xpf:StyleGrid  LayoutDefinitions="1,3"
                                RowSizeDefinitions="Auto,Auto,*">

                    <Xpf:StyleGrid  x:Name="SearchGrid"
                                    LayoutDefinitions="2,1"
                                    ColumnSizeDefinitions="Auto,1*"
                                    VerticalContentAlignment="Center"
                                    Margin="0,0,0,2">

                        <Xpf:CheckEdit x:Name="chkIsNewPAT"
                                       Grid.Column="0" 
                                       FontWeight="SemiBold" 
                                       Margin="2,0,2,0" 
                                       HorizontalAlignment="Left"
                                       IsEnabled="{Binding CanChangingIsNewPatient}"
                                       IsChecked="{Binding IsNewPatient}"
                                       PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown_CheckEdit">

                            <Xpf:TextBlock>
                                <Run>신환예약</Run>
                                <Run Foreground="DimGray">(*신환 예약시 체크하세요)</Run>
                            </Xpf:TextBlock>
                        </Xpf:CheckEdit>

                        <Xpf:SearchPanel Grid.Column="1" 
                                         x:Name="SearchPanel"
                                         NullText="환자명/차트번호로 검색하세요." 
                                         SearchCommand="{Binding SearchCommand}"
                                         Margin="4,0,2,0"
                                         PreviewKeyDown="OnPreviewKeyDown_SearchPanel"/>

                        <Popup  x:Name="PatientPopup"
                                PlacementTarget="{Binding txtSearch, ElementName=SearchPanel}"
                                Placement="Bottom"
                                IsOpen="{Binding IsPopupOpen, RelativeSource={RelativeSource AncestorType=local:vSmartEMRRESInfo}}"
                                StaysOpen="False"
                                AllowsTransparency="True"
                                PopupAnimation="Fade"
                                MinWidth="{Binding txtSearch.ActualWidth, ElementName=SearchPanel}"
                                MinHeight="400"
                                HorizontalAlignment="Stretch"
                                PreviewKeyDown="OnPreviewKeyDown_Popup"
                                Closed="OnClosed_Popup">

                            <Border Background="#F0F8FF" 
                                    BorderBrush="LightBlue"
                                    BorderThickness="1,0,1,1"
                                    Margin="0,4,0,0">
                                
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" 
                                      Color="DimGray" 
                                      Opacity="0.1"
                                      ShadowDepth="3"/>
                                </Border.Effect>


                                <dxe:ListBoxEdit x:Name="PatientListBox"
                                                 ItemsSource="{Binding Patients}"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 PreviewKeyDown="OnPreviewKeyDown_ListBoxEdit"
                                                 PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp_ListBoxEdit"
                                                 VirtualizingStackPanel.IsVirtualizing="False">

                                    <dxe:ListBoxEdit.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        </Style>
                                    </dxe:ListBoxEdit.ItemContainerStyle>

                                    <dxe:ListBoxEdit.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="GhostWhite"
                                                    BorderBrush="DarkSlateGray"
                                                    BorderThickness="1"
                                                    Margin="1"
                                                    Height="80">

                                                <Xpf:StyleGrid  LayoutDefinitions="3,1"
                                                                ColumnSizeDefinitions="Auto,Auto,*">

                                                    <Border x:Name="PART_PATIMAGEBORDER"
                                                            Grid.Column="0"
                                                            Grid.Row="0"
                                                            BorderBrush="Black"
                                                            BorderThickness="1"
                                                            Width="60"
                                                            Margin="2">

                                                        <Xpf:Image  x:Name="PART_PATIMAGE"
                                                                    Stretch="UniformToFill" 
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Source="{Binding PAT_ImageSource}"/>
                                                    </Border>

                                                    <Border x:Name="SplitBorder"
                                                            Grid.Column="1"
                                                            Grid.Row="0"
                                                            Width="1"
                                                            Margin="2"
                                                            Background="Gray"/>

                                                    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                                                                    Grid.Column="2"
                                                                    Grid.Row="0"
                                                                    HorizontalAlignment="Stretch"
                                                                    Margin="2">

                                                        <StackPanel Grid.Column="0"
                                                                    Grid.Row="0"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Center"
                                                                    Margin="3,0,3,0">

                                                            <Xpf:TextBlock  x:Name="txtPAT_ChartNo"
                                                                            FontSize="12"
                                                                            FontWeight="Bold"
                                                                            Foreground="DarkSlateGray">
                                                                
                                                                <Run Text="No."/>
                                                                <Run Text="{Binding PAT_ChartNo}"/>
                                                            </Xpf:TextBlock>

                                                            <Xpf:Spliter/>

                                                            <Xpf:TextBlock  x:Name="txtPAT_Name"
                                                                            FontSize="11"
                                                                            Text="{Binding PAT_Name}"
                                                                            Margin="2,0,0,0"/>

                                                            <Xpf:Spliter/>

                                                            <Xpf:TextBlock  x:Name="txtvPAT_Info"
                                                                            FontSize="11"
                                                                            Text="{Binding vPAT_Info}"
                                                                            Foreground="DimGray"
                                                                            Margin="2,0,0,0"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0"
                                                                    Grid.Row="1"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Stretch"
                                                                    Margin="3,0,3,0">

                                                            <Xpf:TextBlock  x:Name="txtPAT_PhoneNum"
                                                                            FontSize="11"
                                                                            Text="{Binding PAT_PhoneNum}"
                                                                            VerticalAlignment="Center"/>

                                                            <Xpf:Spliter/>

                                                            <Xpf:TextBlock  x:Name="txtPAT_Address1"
                                                                            FontSize="11"
                                                                            Text="{Binding vPAT_Address}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="0"
                                                                    Grid.Row="2"
                                                                    Orientation="Horizontal"
                                                                    VerticalAlignment="Stretch">

                                                            <Xpf:TextBlock  Text="{Binding PAT_Bigo}"
                                                                            TextTrimming="CharacterEllipsis"
                                                                            Foreground="DimGray"
                                                                            FontSize="10"
                                                                            HorizontalAlignment="Left"
                                                                            VerticalAlignment="Center"
                                                                            Margin="3,0,3,0"/>
                                                        </StackPanel>
                                                    </Xpf:StyleGrid>
                                                </Xpf:StyleGrid>
                                            </Border>
                                        </DataTemplate>
                                    </dxe:ListBoxEdit.ItemTemplate>
                                </dxe:ListBoxEdit>
                            </Border>
                        </Popup>
                    </Xpf:StyleGrid>

                    <Border Grid.Column="0" 
                            Grid.ColumnSpan="2" 
                            Grid.Row="1" 
                            Height="4" 
                            BorderThickness="0,1,0,1"
                            BorderBrush="{x:Static resources:SmartBrush.SMART_BRUSH_SECTION_BORDER}"
                            Background="{x:Static resources:SmartBrush.SMART_BRUSH_SECTION_BACKGROUND}"
                            Margin="0,2,0,2"/>

                    <local:vSmartEMRRESInfo_PatientInfo Grid.Column="0"
                                                        Grid.ColumnSpan="2"
                                                        Grid.Row="2"
                                                        DataContext="{Binding InputPatient}"
                                                        Visibility="{Binding vm.IsNewPatient, RelativeSource={RelativeSource AncestorType=local:vSmartEMRRESInfo}, Converter={converter:BooleanToVisibilityConverter}}"/>

                    <local:vSmartEMRRESInfo_PatientView x:Name="RESInfo_PatientView"
                                                        Grid.Column="0" 
                                                        Grid.ColumnSpan="2"
                                                        Grid.Row="2"
                                                        DataContext="{Binding SelectedPatient}"
                                                        Visibility="{Binding vm.IsNewPatient, RelativeSource={RelativeSource AncestorType=local:vSmartEMRRESInfo},Converter={converter:BooleanToVisibilityConverter invert=True}}"/>

                </Xpf:StyleGrid>
            </Xpf:LayoutPanel>
            
            <dxd:LayoutGroup Orientation="Horizontal">
                <Xpf:LayoutPanel ItemWidth="0.4*" Caption="에약현황" AllowSizing="False" Padding="2">
                    <Xpf:StyleGrid>
                        <dxe:ListBoxEdit  x:Name="ReservationSlotListBox"
                                          ItemsSource="{Binding Reservations}" 
                                          BorderBrush="LightGray"
                                          dx:ThemeManager.ThemeName="Win11Light"
                                          VirtualizingStackPanel.IsVirtualizing="False"
                                          ScrollViewer.CanContentScroll="False"
                                          EditValueChanged="OnEditValueChanged_ListBoxEdit">
                            <dxe:ListBoxEdit.ItemTemplate>
                                <DataTemplate>
                                    <local:ReservationItemTemplate MinHeight="26" Height="26"/>
                                </DataTemplate>
                            </dxe:ListBoxEdit.ItemTemplate>
                        </dxe:ListBoxEdit>
                    </Xpf:StyleGrid>
                </Xpf:LayoutPanel>
                <Xpf:LayoutPanel ItemWidth="0.6*" Caption="에약정보">
                    <Xpf:BindGrid LayoutDefinitions="2,7"
                                  BindStyle="DataCell"
                                  ItemSpace="2">

                        <x:Array Type="{x:Type Xpf:BindItem}">
                            <Xpf:BindItem   FieldName="RES_ReservationDate"
                                            Header="예 약 일 시"
                                            BindType="DateEdit"
                                            Col="0"
                                            ColSpan="2"
                                            Row="0"/>

                            <Xpf:BindItem   FieldName="RES_ReservationTime"
                                            BindType="ComboBox"
                                            Width="100"
                                            ItemsSource="{x:Static selections:InputOptionItems.ReservationTimes}"
                                            DisplayMember="attrName"
                                            ValueMember="attrValue"/>
                        </x:Array>

                        <x:Array Type="{x:Type Xpf:BindItem}">
                            <Xpf:BindItem   FieldName="RES_Subject"
                                            Header="접 수 과 목"
                                            BindType="ComboBox"
                                            Col="0"
                                            Row="1"
                                            ColSpan="2"
                                            ItemsSource="{x:Static selections:InputOptionItems.Subjects}"
                                            DisplayMember="CCI_Name"
                                            ValueMember="CCI_Cd"/>

                            <Xpf:BindItem FieldName="RES_SubjectName"
                                          BindType="TextBox"
                                          Width="100"
                                          FontSize="12"
                                          Placeholder="직접입력"
                                          IsEnabled="False"/>
                        </x:Array>

                        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                                        Header="담  당  의"
                                        BindType="ComboBox"
                                        Col="0"
                                        Row="2"
                                        ItemsSource="{x:Static selections:InputOptionItems.Docters}"
                                        DisplayMember="MUR_Name"
                                        ValueMember="MUR_Idx"/>

                        <Xpf:BindItem   FieldName="MUR_Idx_STF"
                                        Header="담 당 직 원"
                                        BindType="ComboBox"
                                        Col="1"
                                        Row="2"
                                        ItemsSource="{x:Static selections:InputOptionItems.Staffs}"
                                        DisplayMember="MUR_Name"
                                        ValueMember="MUR_Idx"/>

                        <Xpf:BindItem   FieldName="RES_Route"
                                        Header="예 약 경 로"
                                        BindType="ComboBox"
                                        Col="0"
                                        Row="3"
                                        ItemsSource="{x:Static selections:InputOptionItems.RouteTypes}"
                                        DisplayMember="CCI_Name"
                                        ValueMember="CCI_Cd"/>

                        <Xpf:BindItem   FieldName="RES_Memo"
                                        Header="예 약 메 모"
                                        BindType="TextBox"
                                        Col="0"
                                        ColSpan="2"
                                        Row="4"
                                        RowSpan="3"
                                        Margin="1"
                                        ContentAlignment="LeftTop"
                                        IsBottomLine="False"/>
                    </Xpf:BindGrid>
                </Xpf:LayoutPanel>
            </dxd:LayoutGroup>
            <Xpf:LayoutPanel ItemHeight="Auto" ShowBorder="False" AllowSizing="False">
                <Xpf:StyleGrid  LayoutDefinitions="3,1"
                                ColumnSizeDefinitions="Auto,*,Auto"
                                VerticalAlignment="Center">

                    <Xpf:Button x:Name="btnCancel"
                                Grid.Column="0"
                                Width="85"
                                Height="27"
                                Content="예약취소"
                                FontWeight="SemiBold"
                                Glyph="/Images/smartemr_cancel.png"
                                VerticalContentAlignment="Center"
                                Margin="2,0,0,0"
                                Visibility="{Binding Model.RES_Idx, Converter={converter:IntToVisibilityConverter}}"/>

                    <dx:SimpleButton    x:Name="btnSave"
                                        Grid.Column="2"
                                        Content="{Binding ViewTitle, RelativeSource={RelativeSource AncestorType=local:vSmartEMRRESInfo}}"
                                        Padding="2"
                                        Width="85"
                                        Height="27"
                                        FontWeight="SemiBold"
                                        Glyph="/Images/smartemr_save.png"
                                        VerticalContentAlignment="Center"
                                        Margin="0"
                                        Command="{Binding SetReservationCommand}"
                                        CommandParameter="{x:Static common:SaveMode.SAVE}"/>
                </Xpf:StyleGrid>
            </Xpf:LayoutPanel>
        </dxd:LayoutGroup>
    </dxd:DockLayoutManager>
</base:ModelViewLayout>
