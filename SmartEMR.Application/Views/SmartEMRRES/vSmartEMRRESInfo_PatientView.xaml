<Xpf:CustomControl x:Class="SmartEMR.Application.Views.SmartEMRRES.vSmartEMRRESInfo_PatientView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRRES"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
             xmlns:resources="clr-namespace:SmartEMR.Application.Resources"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:StyleGrid>
        <Xpf:BindGrid   x:Name="PatientViewGrid"
                        Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="2"
                        BindStyle="DataCell"
                        LayoutDefinitions="6,6">

            <Xpf:BindItem   FieldName="PAT_ImageSource"
                            BindType="Image"
                            Col="0"
                            Row="0"
                            ColSpan="2"
                            RowSpan="6"
                            Margin="1"
                            IsBinding="False"
                            IsHeader="False"
                            IsBottomLine="False">

                <Xpf:StyleGrid LayoutDefinitions="1,3"
                               RowSizeDefinitions="*,Auto,Auto">
                    
                    <Border x:Name="PatientImageBorder" 
                            Grid.Row="0"
                            BorderBrush="Gray" 
                            BorderThickness="1"
                            Padding="1"
                            Margin="5">
                        
                        <Xpf:Image  x:Name="PatientImage" 
                                    Source="{Binding PAT_ImageSource, TargetNullValue='Images/smartemr_default_profile.png'}" 
                                    Stretch="UniformToFill"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"/>
                    </Border>

                    <Xpf:Button x:Name="btnMovePAT"
                                Grid.Row="1" 
                                Grid.ColumnSpan="4" 
                                Content="환자수정"
                                Glyph="/Images/smartemr_edit_patient.png"
                                Margin="5,2" 
                                Background="#F1F3F5" 
                                BorderBrush="LightGray" 
                                BorderThickness="1"
                                Click="OnClick_Button"/>

                    <Border x:Name="PersonalInfoBorder"
                            Grid.Row="2"
                            Height="40"
                            BorderThickness="2"
                            CornerRadius="5"
                            Margin="5">
                        <Border.Style>
                                <Style TargetType="Border">
                                <Style.Setters>
                                    <Setter Property="Background" Value="#E8F5E9"/>
                                    <Setter Property="BorderBrush" Value="#009688"/>
                                </Style.Setters>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PAT_IsAgreePersonalInfo}" Value="y">
                                            <Setter Property="BorderBrush" Value="{x:Static resources:SmartBrush.SMART_BRUSH_PERSONAL_INFO_AGREE}"/>
                                            <Setter Property="Background" Value="#E8F5E9"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding PAT_IsAgreePersonalInfo}" Value="n">
                                            <Setter Property="BorderBrush" Value="{x:Static resources:SmartBrush.SMART_BRUSH_PERSONAL_INFO_NOTAGREE}"/>
                                            <Setter Property="Background" Value="#FAFAFA"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Xpf:TextBlock Text="{Binding vPAT_IsAgreePersonalInfo}" 
                                           FontSize="13" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Padding="0,0,0,5"
                                           Margin="0,4,0,0">
                                <Xpf:TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PAT_IsAgreePersonalInfo}" Value="y">
                                                <Setter Property="Foreground" Value="White"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding PAT_IsAgreePersonalInfo}" Value="n">
                                                <Setter Property="Foreground" Value="DimGray"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Xpf:TextBlock.Style>
                            </Xpf:TextBlock>
                        </Border>
                </Xpf:StyleGrid>
            </Xpf:BindItem>

            <Xpf:BindItem FieldName="PAT_ChartNo"
                          Header="차 트 번 호"
                          BindType="Label"
                          Col="2"
                          Row="0"
                          ColSpan="2"
                          FontWeight="Bold"/>

            <Xpf:BindItem FieldName="PAT_Name"
                          Header="성       명"
                          Col="4"
                          ColSpan="2"
                          Row="0">

                <StackPanel Orientation="Horizontal">
                    <Xpf:TextLink Text="{Binding PAT_Name}" FontWeight="Bold" Margin="2,0,0,0"/>
                    <Xpf:TextBlock Margin="2,0,0,0">
                        <Run Text="(" Foreground="Gray" FontSize="10"/>
                        <Run Text="{Binding vPAT_Sex}" FontSize="11"/>
                        <Run Foreground="Gray" FontSize="8">/</Run>
                        <Run Text="{Binding PAT_Age}" FontSize="11"/>
                        <Run Text=")" Foreground="Gray" FontSize="10"/>
                    </Xpf:TextBlock>
                </StackPanel>
            </Xpf:BindItem>

            <Xpf:BindItem   FieldName="PAT_RegisterNum"
                            Header="주 민 번 호"
                            BindType="Label"
                            Col="2"
                            ColSpan="2"
                            Row="1"/>

            <Xpf:BindItem   FieldName="PAT_BirthDate"
                            Header="생 년 월 일"
                            BindType="Label"
                            Col="4"
                            ColSpan="2"
                            Row="1"/>

            <Xpf:BindItem   FieldName="PAT_PhoneNum"
                            BindType="Label"
                            Header="전 화 번 호"
                            Col="2"
                            ColSpan="2"
                            Row="2"/>

            <Xpf:BindItem   FieldName="PAT_Email"
                            Header="이 메 일"
                            BindType="Label"
                            Col="4"
                            ColSpan="2"
                            Row="2"/>

            <Xpf:BindItem   FieldName="PAT_FirstVisitDate"
                            Header="최 초 내 원"
                            BindType="Label"
                            Col="2"
                            ColSpan="2"
                            Row="3"/>

            <Xpf:BindItem   FieldName="PAT_LastVisitDate"
                            Header="최 종 내 원"
                            BindType="Label"
                            Col="4"
                            ColSpan="2"
                            Row="3"/>

            <Xpf:BindItem   FieldName="PAT_Bigo"
                            Header="비       고"
                            BindType="Label"
                            Col="2"
                            ColSpan="4"
                            Row="4"
                            RowSpan="2"
                            IsBottomLine="False"/>
        </Xpf:BindGrid>
        <Xpf:MaskControl MaskText="선택된 환자가 없습니다."
                         Visibility="{Binding PAT_Idx, Converter={converter:IntToVisibilityConverter invert=True}}"
                         ShowButton="False"/>
    </Xpf:StyleGrid>
</Xpf:CustomControl>
