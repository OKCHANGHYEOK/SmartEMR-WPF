<base:ModelViewLayout x:TypeArguments="vm:CalendarViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRRES.SmartEMRRESCalendarTab.vSmartEMRRESCalendar"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:core="clr-namespace:SmartEMR.Application.Core"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid>
        <Xpf:Calendar StartDay="{Binding StartDay}"
                      DisplayDays="{Binding DisplayDays}"
                      StartTime="00:00"
                      EndTime="23:59"
                      SlotInterval="{Binding ReservationTimeInterval, Source={x:Static core:SmartMVVM.AppSession}}">
        </Xpf:Calendar>
    </Xpf:StyleGrid>
</base:ModelViewLayout>