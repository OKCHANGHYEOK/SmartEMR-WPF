<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.SmartEMRRES.SmartEMRRESCalendarTab.CalendarHeaderItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRRES.SmartEMRRESCalendarTab"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800">

    <DataTemplate>
        <StackPanel Orientation="Vertical">
            <Xpf:TextBlock  Text="{Binding Date}" 
                            FontWeight="Bold"
                            Foreground="#4B5563"
                            Margin="4"/>

            <Xpf:TextBlock Text="{Binding DayOfWeek}"
                           FontWeight="Bold"
                           Foreground="{Binding DayOfWeek, Converter={local:DayOfWeekToForegroundConverter}}"
                           Margin="4"/>
        </StackPanel>
    </DataTemplate>
</Xpf:CustomControl>
