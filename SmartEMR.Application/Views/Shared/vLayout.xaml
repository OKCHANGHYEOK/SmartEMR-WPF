<Xpf:UIWindow x:Class="SmartEMR.Application.Views.vLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartEMR.Application.Views"
        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
        xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
        xmlns:v="clr-namespace:SmartEMR.Application.Views"
        mc:Ignorable="d"
        d:DesignHeight="1080" d:DesignWidth="1920"
        Title="SmartEMR"
        WindowState="Maximized"
        Closing="OnClosing_vLayout">

    <dxdo:DockLayoutManager>
        <!-- 2. 전체를 감싸는 루트 그룹 -->
        <dxdo:LayoutGroup Orientation="Vertical">

            <!-- 3. 상단 메뉴 영역 (고정) -->
            <dxdo:LayoutPanel Caption="Menu" 
                              ItemHeight="90" 
                              ShowCaption="False" 
                              ShowBorder="False" 
                              AllowClose="False" 
                              AllowDrag="False" 
                              AllowFloat="False"
                              AllowSizing="False">
                
                <dxdo:LayoutPanel.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2C3E50" Offset="0" />
                        <GradientStop Color="#1A252F" Offset="1" />
                    </LinearGradientBrush>
                </dxdo:LayoutPanel.Background>
                
                <v:vSmartEMRBarMenu/>
            </dxdo:LayoutPanel>

            <!-- 4. 메인 컨텐츠 영역 -->
            <dxdo:LayoutPanel Caption="MainContent" 
                              ShowCaption="False" 
                              AllowClose="False">
                <dxwui:NavigationFrame Content="{Binding MainContent}"
                                       AnimationType="Fade">
                </dxwui:NavigationFrame>
            </dxdo:LayoutPanel>

        </dxdo:LayoutGroup>
    </dxdo:DockLayoutManager>
</Xpf:UIWindow>
