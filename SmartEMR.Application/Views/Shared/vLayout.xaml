<Xpf:UIWindow x:Class="SmartEMR.Application.Views.vLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartEMR.Application.Views"
        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
        xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:v="clr-namespace:SmartEMR.Application.Views"
        xmlns:shared="clr-namespace:SmartEMR.Application.Views.Shared"      
        mc:Ignorable="d"
        d:DesignHeight="1080" d:DesignWidth="1920"
        WindowState="Maximized"
        Closing="OnClosing_vLayout"
        HeaderBackground="#A1C4FD"
        PreviewKeyDown="OnPreviewKeyDown_vLayout"
        Padding="0">

    <dx:ThemedWindow.HeaderItems>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="SMART EMR" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <Border Width="1" Height="16" Background="#55FFFFFF" Margin="15,0"/>
            <TextBlock Text="Medical Information System" FontSize="12" Foreground="GhostWhite" VerticalAlignment="Center"/>
        </StackPanel>
    </dx:ThemedWindow.HeaderItems>

    <Grid>
        <dxdo:DockLayoutManager Background="#F0F2F5" 
                            Margin="0" 
                            Padding="0" 
                            ViewStyle="Light"
                            UseLayoutRounding="True">
            <dxdo:LayoutGroup Orientation="Vertical" Padding="0">

                <dxdo:LayoutPanel ItemHeight="80" 
                              ShowCaption="False" 
                              ShowBorder="False" 
                              AllowClose="False" 
                              AllowDrag="False" 
                              AllowFloat="False"
                              AllowSizing="False"
                              Padding="0"
                              Margin="0"
                              Background="#E1EEFF">
                    <v:vSmartEMRBarMenu/>
                </dxdo:LayoutPanel>

                <dxdo:LayoutPanel ShowCaption="False"
                              AllowClose="False"
                              ShowBorder="False"
                              Padding="3">

                    <Border Background="White" 
                        CornerRadius="4" 
                        BorderBrush="#D6DBDF" 
                        BorderThickness="2">
                        <dxwui:NavigationFrame Content="{Binding MainContent, RelativeSource={RelativeSource AncestorType={x:Type v:vLayout}}}" AnimationType="Fade" Margin="1"/>
                    </Border>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>
        <shared:vSmartEMRNotificationView Width="400" Height="1000" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,5"/>
    </Grid>
</Xpf:UIWindow>
