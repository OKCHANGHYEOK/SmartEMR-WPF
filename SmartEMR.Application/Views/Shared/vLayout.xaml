<base:ViewLayout   x:Class="SmartEMR.Application.Views.Shared.vLayout"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
                   xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                   xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                   xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                   xmlns:v="clr-namespace:SmartEMR.Application.Views"
                   xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                   xmlns:shared="clr-namespace:SmartEMR.Application.Views.Shared"
                   xmlns:core="clr-namespace:SmartEMR.Application.Core"
                   xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                   xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                   xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
                   PreviewKeyDown="OnPreviewKeyDown_vLayout"
                   Focusable="True"
                   mc:Ignorable="d">
    <Grid>
        <dxdo:DockLayoutManager Background="#F0F2F5" 
                            Margin="0" 
                            Padding="0" 
                            ViewStyle="Light"
                            UseLayoutRounding="True">
            <dxdo:LayoutGroup Orientation="Vertical" Padding="0">

                <dxdo:LayoutPanel ItemHeight="80" 
                              ShowCaption="False" 
                              ShowBorder="False" 
                              AllowClose="False" 
                              AllowDrag="False" 
                              AllowFloat="False"
                              AllowSizing="False"
                              Padding="0"
                              Margin="0"
                              Background="#E1EEFF">
                    <v:vSmartEMRBarMenu/>
                </dxdo:LayoutPanel>

                <dxdo:LayoutPanel ShowCaption="False"
                              AllowClose="False"
                              ShowBorder="False"
                              Padding="3">

                    <Border Background="White" 
                        CornerRadius="4" 
                        BorderBrush="#D6DBDF" 
                        BorderThickness="2">
                        <dxwui:NavigationFrame Content="{Binding MainContent, RelativeSource={RelativeSource AncestorType={x:Type shared:vLayout}}}" AnimationType="Fade" Margin="1"/>
                    </Border>
                </dxdo:LayoutPanel>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>

        <Border x:Name="LayoutBorder"
                Background="#66000000" 
                HorizontalAlignment="Stretch" 
                VerticalAlignment="Stretch"
                IsHitTestVisible="True"
                Opacity="0.9">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>

                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Source={x:Static core:SmartUI.UIManager}, Path=Popups.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Xpf:StyleGrid x:Name="FloatLayout" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Source={x:Static core:SmartUI.UIManager}, Path=Popups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Grid></Grid>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Content="{Binding}">
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Xpf:StyleGrid>
        <shared:vSmartEMRNotificationView Width="420" MaxHeight="1000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10,5"/>

        <!-- 로딩 인디케이터 -->
        <dx:WaitIndicator   x:Name="LayoutWaitIndicator"
                            DeferedVisibility="False"
                            Content="화면을 불러오는 중입니다..."
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">

            <dx:WaitIndicator.ContentTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="13" FontWeight="SemiBold"/>
                </DataTemplate>
            </dx:WaitIndicator.ContentTemplate>
        </dx:WaitIndicator>
    </Grid>
</base:ViewLayout>
