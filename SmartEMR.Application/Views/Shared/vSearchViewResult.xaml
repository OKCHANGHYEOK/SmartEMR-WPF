<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.Shared.vSearchViewResult"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:common="clr-namespace:SmartEMR.Application.Common"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800"
                    Width="300">

    <ListBox x:Name="ResultListBox"
             ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type local:vSearchViewResult}}}"
             BorderThickness="0"
             Background="Transparent">

        <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            </Style>
        </ListBox.ItemContainerStyle>

        <ListBox.ItemTemplate>
            <DataTemplate>
                <Border Background="GhostWhite"
                        BorderBrush="DarkSlateGray"
                        BorderThickness="1"
                        Margin="2"
                        Height="80">

                    <Xpf:StyleGrid  LayoutDefinitions="3,1"
                                    ColumnSizeDefinitions="Auto,Auto,*">

                        <Border x:Name="PART_PATIMAGEBORDER"
                                Grid.Column="0"
                                Grid.Row="0"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Margin="2">

                            <Image  x:Name="PART_PATIMAGE"
                                    Stretch="UniformToFill" 
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    Width="48"
                                    Height="48"
                                    Source="{Binding PAT_ImageSource, Converter={common:PAT_ImageSourceToImageConverter}}"/>
                        </Border>

                        <Border x:Name="SplitBorder"
                                Grid.Column="1"
                                Grid.Row="0"
                                Width="1"
                                Margin="2"
                                Background="Gray"/>

                        <Xpf:StyleGrid  LayoutDefinitions="1,3"
                                        Grid.Column="2"
                                        Grid.Row="0"
                                        Margin="2">
                            
                            <StackPanel Grid.Column="0"
                                        Grid.Row="0"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="3,0,3,0">

                                <Xpf:TextBlock  x:Name="txtPAT_ChartNo"
                                                FontSize="12"
                                                Text="{Binding PAT_ChartNo}"
                                                FontWeight="Bold"
                                                Foreground="DarkSlateGray"/>

                                <Xpf:TextBlock  x:Name="txtPAT_Name"
                                                FontSize="11"
                                                Text="{Binding PAT_Name}"
                                                Margin="2,0,0,0"/>

                                <Xpf:TextBlock  x:Name="txtvPAT_Info"
                                                FontSize="11"
                                                Text="{Binding vPAT_Info}"
                                                Foreground="DimGray"
                                                Margin="2,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="0"
                                        Grid.Row="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="3,0,3,0">

                                <Xpf:TextBlock  x:Name="txtPAT_PhoneNum"
                                            FontSize="11"
                                            Text="{Binding PAT_PhoneNum}"/>

                                <Xpf:TextBlock  x:Name="txtPAT_Address1"
                                            FontSize="11"
                                            Text="{Binding PAT_Address1}"
                                            TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Xpf:TextBlock  Grid.Column="0"
                                            Grid.Row="2"
                                            VerticalAlignment="Center"
                                            Text="{Binding PAT_Bigo}"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="DimGray"
                                            Margin="3,0,3,0"/>
                        </Xpf:StyleGrid>
                    </Xpf:StyleGrid>
                </Border>
            </DataTemplate>
        </ListBox.ItemTemplate>
    </ListBox>
</Xpf:CustomControl>
