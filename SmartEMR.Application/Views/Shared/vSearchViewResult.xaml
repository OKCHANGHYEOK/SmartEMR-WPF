<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.Shared.vSearchViewResult"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:common="clr-namespace:SmartEMR.Application.Common"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800"
                    Width="300">

    <ItemsControl   x:Name="ResultItemsControl"
                    ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type local:vSearchViewResult}}}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" Margin="2">
                </StackPanel>
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="GhostWhite"
                        BorderBrush="DarkSlateGray"
                        BorderThickness="1"
                        Margin="2"
                        Height="65">
                    <Xpf:StyleGrid  LayoutDefinitions="3,4"
                                    ColumnSizeDefinitions="Auto,Auto,*">

                        <Border x:Name="PART_PATIMAGEBORDER"
                                Grid.Column="0"
                                Grid.Row="0"
                                Grid.RowSpan="4"
                                BorderBrush="Black"
                                BorderThickness="1"
                                Margin="2">

                            <Image  x:Name="PART_PATIMAGE"
                                    Width="36"
                                    Height="36"
                                    Stretch="Uniform"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Source="{Binding PAT_ImageSource, Converter={common:PAT_ImageSourceToImageConverter}}"/>
                        </Border>

                        <Border x:Name="SplitBorder"
                                Grid.Column="1"
                                Grid.Row="0"
                                Grid.RowSpan="4"
                                Width="1"
                                Margin="2"
                                Background="Gray"/>

                        <StackPanel Grid.Column="2"
                                    Grid.Row="1"
                                    Orientation="Horizontal">
                            
                            <Xpf:TextBlock  x:Name="txtPAT_ChartNo"
                                            FontSize="13"
                                            Text="{Binding PAT_ChartNo}"/>

                            <Xpf:TextBlock  x:Name="txtPAT_Name"
                                            FontSize="12"
                                            Text="{Binding PAT_Name}"/>

                            <Xpf:TextBlock  x:Name="txtvPAT_Info"
                                            FontSize="12"
                                            Text="{Binding vPAT_Info}"
                                            Foreground="DimGray"/>
                        </StackPanel>
                    </Xpf:StyleGrid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</Xpf:CustomControl>
