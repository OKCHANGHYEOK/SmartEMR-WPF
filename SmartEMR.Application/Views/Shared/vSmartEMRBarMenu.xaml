<Xpf:StyleGrid  x:Class="SmartEMR.Application.Views.vSmartEMRBarMenu"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                xmlns:shared="clr-namespace:SmartEMR.Application.Views.Shared"
                mc:Ignorable="d"
                HorizontalAlignment="Stretch"
                LayoutDefinitions="5,1"
                ColumnSizeDefinitions="0.3*,Auto,0.5*,Auto,*"
                d:DesignWidth="1280">
    <shared:vSearchView Grid.Column="0"/>
    
    <Border Grid.Column="1" 
            Width="1" 
            Background="LightBlue"
            Opacity="0.6"
            Margin="5"/>
    
    <shared:vSmartEMRChartSummary Grid.Column="2"/>
    
    <Border Grid.Column="3" 
            Width="1" 
            Background="LightBlue"
            Opacity="0.6"
            Margin="5"/>
    
</Xpf:StyleGrid>
