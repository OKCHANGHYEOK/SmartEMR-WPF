<Xpf:CustomControl x:Class="SmartEMR.Application.Views.Shared.vSmartEMRNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:bar="clr-namespace:SmartEMR.Application.Xpf.Bar"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             Height="80"
             d:DesignWidth="500"
             Margin="3">

    <bar:NavigationBar Height="80" Background="Transparent">
        <bar:BarItem    Content="예약" 
                        Glyph="/Images/Svg/smartemr_menu_calendar.svg" 
                        Tag="CALENDAR"/>

        <bar:BarItem    Content="접수" 
                        Glyph="/Images/Svg/smartemr_menu_desk.svg" 
                        Command="{Binding NavCommand}" 
                        Tag="DESK"/>

        <bar:BarItem    Content="진료"
                        Glyph="/Images/Svg/smartemr_menu_examination.svg"
                        Command="{Binding NavCommand}"
                        Tag="EXAM"/>


    </bar:NavigationBar>
</Xpf:CustomControl>
