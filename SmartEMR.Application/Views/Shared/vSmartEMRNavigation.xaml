<Xpf:CustomControl x:Class="SmartEMR.Application.Views.Shared.vSmartEMRNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:bar="clr-namespace:SmartEMR.Application.Xpf.Bar"
             xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
             mc:Ignorable="d" 
             Height="80"
             d:DesignWidth="500"
             Margin="3"
             Background="Transparent">

    <bar:BarManager VerticalAlignment="Stretch">
        <bar:BarItem Caption="TopMenu">
            <bar:BarButtonItem  Content="예약"
                                CommandParameter="DSK"
                                Command="{Binding NavCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
            </bar:BarButtonItem>

            <bar:BarButtonItem Content="접수">
                
            </bar:BarButtonItem>        
        </bar:BarItem>
    </bar:BarManager>
</Xpf:CustomControl>
