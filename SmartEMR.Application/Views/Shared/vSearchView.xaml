<base:ModelViewLayout   x:TypeArguments="vm:SearchViewModel"
                        x:Class="SmartEMR.Application.Views.Shared.vSearchView"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        mc:Ignorable="d" 
                        Background="Transparent"
                        BorderBrush="Black"
                        Margin="3"
                        PreviewKeyDown="OnPreviewKeyDown_SearchView">

    <Grid>
        <Xpf:StyleGrid LayoutDefinitions="3,2"
                       ColumnSizeDefinitions="*,*,*"
                       RowSizeDefinitions="*,25px">
            <Xpf:StyleTextBox   x:Name="txtSearch"
                                Grid.Column="0" 
                                Grid.Row="0" 
                                Grid.ColumnSpan="2" 
                                Grid.RowSpan="1"
                                TextBoxType="Text"
                                Text="{Binding Model.Keyword, UpdateSourceTrigger=PropertyChanged}"                                 
                                FontSize="16"
                                Placeholder="환자검색(F6)"
                                PlaceHolderHorizontalAlignment="Center"
                                PlaceHolderMargin="0"
                                PlaceHolderPadding="0"
                                BorderBrush="LightBlue"
                                BorderThickness="1"
                                CornerRadius="0"
                                Margin="2"
                                BoxMargin="0">

                <Xpf:StyleTextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                </Xpf:StyleTextBox.InputBindings>
            </Xpf:StyleTextBox>
            <Xpf:Button     Grid.Column="0" 
                            Grid.Row="1" 
                            Content="예약하기"
                            Glyph="/Images/smartemr_booking.png"
                            FontSize="10"
                            HorizontalContentAlignment="Center"
                            Padding="2"
                            Margin="2,0,0,0"
                            Background="#F1F3F5"
                            BorderBrush="LightGray"
                            Command="{Binding ClickCommand}"
                            CommandParameter="MoveRES"/>
            
            <Xpf:Button     Grid.Column="1"
                            Grid.Row="1"
                            Content="신환등록"
                            Glyph="/Images/smartemr_register.png"
                            FontSize="10"
                            HorizontalContentAlignment="Center"
                            Padding="2"
                            Margin="2,0,2,0"
                            Background="#F1F3F5"
                            BorderBrush="LightGray"/>

            <!-- 검색 버튼 (SimpleButton) -->
            <Xpf:Button    x:Name="SearchButton"
                           Grid.Column="2" Grid.Row="0"
                           Grid.RowSpan="2"
                           Content="검색"
                           Margin="0,2,0,1"
                           Padding="12,0"
                           Command="{Binding SearchCommand}"
                           FontWeight="SemiBold"
                           Foreground="#333333">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                        <GradientStop Color="#F8F9FA" Offset="0.4"/>
                        <GradientStop Color="#E9ECEF" Offset="0.5"/>
                        <GradientStop Color="#DDE2E6" Offset="1.0"/>
                    </LinearGradientBrush>
                </Button.Background>

                <Button.Effect>
                    <DropShadowEffect BlurRadius="5" 
                              Color="Black" 
                              Opacity="0.15" 
                              Direction="270" 
                              ShadowDepth="1.5"/>
                </Button.Effect>
            </Xpf:Button>
        </Xpf:StyleGrid>

        <Popup  x:Name="SearchPopup"
                PlacementTarget="{Binding ElementName=txtSearch}"
                Placement="Bottom"
                IsOpen="{Binding IsPopupOpen, RelativeSource={RelativeSource AncestorType=local:vSearchView}}"
                StaysOpen="False"
                AllowsTransparency="True"
                PopupAnimation="Fade"
                MinWidth="{Binding ElementName=txtSearch, Path=ActualWidth}"
                MinHeight="400"
                PreviewKeyDown="OnPreviewKeyDown_Popup"
                Closed="OnClosed_Popup">

            <Border Background="#F0F8FF" 
                    BorderBrush="LightBlue"
                    BorderThickness="1,0,1,1"
                    Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" 
                                      Color="DimGray" 
                                      Opacity="0.1"
                                      ShadowDepth="3"/>
                </Border.Effect>

                <local:vSearchViewResult x:Name="SearchViewResult"/>
            </Border>
        </Popup>
    </Grid>
</base:ModelViewLayout>
   