<base:ModelViewLayout   x:TypeArguments="vm:SearchViewModel"
                        x:Class="SmartEMR.Application.Views.Shared.vSearchView"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.Shared"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        mc:Ignorable="d" 
                        Background="Transparent"
                        BorderBrush="Black"
                        Margin="3">
    <Xpf:StyleGrid LayoutDefinitions="3,2"
                   ColumnSizeDefinitions="*,*,*"
                   RowSizeDefinitions="*,25px">
        <Xpf:StyleTextBox   x:Name="txtSearch"
                            TextBoxType="Text"
                            Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2" Grid.RowSpan="1" 
                            FontSize="16"
                            Placeholder="환자검색(F6)"
                            PlaceHolderHorizontalAlignment="Center"
                            PlaceHolderMargin="0"
                            PlaceHolderPadding="0"
                            BorderBrush="DarkSlateGray"
                            BorderThickness="1"
                            CornerRadius="0"
                            Text="{Binding SearchText, Source={RelativeSource AncestorType=local:vSearchView}}"
                            Margin="2">
        </Xpf:StyleTextBox>
        <dx:SimpleButton Grid.Column="0" 
                         Grid.Row="1" 
                         Content="환자수정"
                         FontSize="10"
                         Foreground="Black"
                         HorizontalContentAlignment="Center"
                         Padding="2"
                         Margin="2,0,0,0"
                         Background="White"
                         BorderBrush="DimGray"/>
        <dx:SimpleButton Grid.Column="1"
                         Grid.Row="1"
                         Content="신환등록"
                         FontSize="10"
                         Foreground="Black"
                         HorizontalContentAlignment="Center"
                         Padding="2"
                         Margin="2,0,2,0"
                         Background="White"
                         BorderBrush="DimGray"/>

        <!-- 검색 버튼 (SimpleButton) -->
        <dx:SimpleButton    x:Name="SearchButton"
                            Grid.Column="2" Grid.Row="0"
                            Grid.RowSpan="2"
                            Content="검색"
                            Margin="0,2,0,2"
                            Padding="12,0"
                            Command="{Binding SearchCommand}"
                            FontWeight="SemiBold"
                            Foreground="#333333">
            <dx:SimpleButton.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFFFFF" Offset="0.0"/>
                    <GradientStop Color="#F8F9FA" Offset="0.4"/>
                    <GradientStop Color="#E9ECEF" Offset="0.5"/>
                    <GradientStop Color="#DDE2E6" Offset="1.0"/>
                </LinearGradientBrush>
            </dx:SimpleButton.Background>
            <dx:SimpleButton.BorderBrush>
                <SolidColorBrush Color="#CFD4D9"/>
            </dx:SimpleButton.BorderBrush>

            <dx:SimpleButton.Effect>
                <DropShadowEffect BlurRadius="5" 
                          Color="Black" 
                          Opacity="0.15" 
                          Direction="270" 
                          ShadowDepth="1.5"/>
            </dx:SimpleButton.Effect>
        </dx:SimpleButton>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
