<Xpf:UIWindow x:Class="SmartEMR.Application.Views.vLayout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartEMR.Application.Views"
        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
        xmlns:dxwui="http://schemas.devexpress.com/winfx/2008/xaml/windowsui"
        xmlns:v="clr-namespace:SmartEMR.Application.Views"
        mc:Ignorable="d"
        Title="SmartEMR"
        WindowState="Maximized">
    <dxlc:DockLayoutControl>
        <dxlc:LayoutGroup Orientation="Vertical">
            <dxlc:LayoutItem dxlc:DockLayoutControl.Dock="Top" Height="80">
                <v:vBarMenu/>
            </dxlc:LayoutItem>
            <dxlc:LayoutItem>
                <dxwui:NavigationFrame Content="{Binding MainContent}"
                                       AnimationType="Fade">
                </dxwui:NavigationFrame>
            </dxlc:LayoutItem>
        </dxlc:LayoutGroup>
    </dxlc:DockLayoutControl>
</Xpf:UIWindow>
