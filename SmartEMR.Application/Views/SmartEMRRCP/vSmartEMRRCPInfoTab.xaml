<base:ModelViewLayout x:TypeArguments="vm:ReceptionViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRRCP.vSmartEMRRCPInfoTab"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRRCP"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800"
                      ViewSize="500,800"
                      ViewTitle="{Binding Model.RCP_Idx, Converter={local:RCP_IdxToContentConverter}}">

    <dxd:DockLayoutManager>
        <dxd:LayoutGroup Orientation="Vertical">
            <Xpf:LayoutPanel Caption="접수정보">
                <local:vSmartEMRRCPInfo x:Name="SmartEMRRCPInfo"/>
            </Xpf:LayoutPanel>
            <Xpf:LayoutPanel Caption="보험정보">
                <local:vSmartEMRIRCInfo x:Name="SmartEMRIRCInfo"/>
            </Xpf:LayoutPanel>
        </dxd:LayoutGroup>
    </dxd:DockLayoutManager>
</base:ModelViewLayout>