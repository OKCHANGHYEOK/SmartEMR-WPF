<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.SmartEMRRCP.vSmartEMRIRCInfo"
                        x:TypeArguments="vm:InsuranceInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRRCP"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:common="clr-namespace:SmartEMR.Application.Common"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800"
                        ViewSize="500,400">
    
    <Xpf:StyleGrid  x:Name="LayoutRoot"
                    LayoutDefinitions="1,1">

        <Xpf:BindGrid   Grid.Row="0"
                        LayoutDefinitions="2,8"
                        BindStyle="DataCell"
                        ItemSpace="2">

            <Xpf:BindItem   FieldName="vIRC_Type"
                            Header="보 험 구 분"
                            BindType="Label"
                            Col="0"
                            Row="0"
                            ColSpan="2"
                            FontSize="12"
                            HAlignment="Left"
                            FontWeight="Bold"/>

            <Xpf:BindItem   FieldName="IRC_CertNum"
                            Header="보험증번호"
                            BindType="TextBox"
                            Col="0"
                            Row="1"
                            ColSpan="2"/>


            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_ContractorName"
                                Header="보 험 관 계 자"
                                BindType="TextBox"
                                Col="0"
                                Row="2"
                                ColSpan="2"
                                Placeholder="가입자명"/>

                <Xpf:BindItem   FieldName="IRC_InsuredName"
                                BindType="TextBox"
                                Placeholder="피보험자명"/>

                <Xpf:BindItem   FieldName="chkIsSameAsContractor"
                                BindType="CheckBox"
                                TextValue="본인"
                                FontSize="11"
                                Foreground="DimGray"
                                FontWeight="DemiBold"
                                Width="42"
                                ToolTip="가입자가 본인과 동일함"
                                IsBinding="False"
                                IsBindClickEvent="True"/>
            </x:Array>

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_CoName"
                                Header="보 험 사 명"
                                BindType="ComboBox"
                                DisplayMember="IRC_CoName"
                                ValueMember="IRC_CoName"
                                Col="0"
                                Row="3"
                                ColSpan="2"/>

                <Xpf:BindItem   FieldName="vIRC_CoName"
                                BindType="TextBox"
                                Placeholder="직접입력"
                                Width="80"
                                IsEnabled="False"/>
            </x:Array>

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_EffectiveYYMMDD"
                                Header="유 효 기 간"
                                BindType="DateEdit"
                                Col="0"
                                Row="4"
                                ColSpan="2"/>

                <Xpf:BindItem   FieldName=""
                                BindType="Label"
                                TextValue="-"
                                FontSize="10"
                                Width="10"
                                IsBinding="False"/>

                <Xpf:BindItem   FieldName="IRC_ExpiredYYMMDDD"
                                BindType="DateEdit"/>
            </x:Array>

            <Xpf:BindItem   FieldName="IRC_Specific"
                            Header="특 정 내 역"
                            Col="0"
                            Row="5"
                            ColSpan="2"
                            RowSpan="3"
                            ContentAlignment="LeftTop"/>
        </Xpf:BindGrid>

        <Xpf:MaskControl x:Name="MaskControl" Grid.RowSpan="2" Visibility="{Binding Model.IRC_Type, Converter={converter:IRCTypeToVisibilityConverter}}">
            <Xpf:TextBlock TextAlignment="Center">
                <Run>접수정보에서 비보험외의 보험 선택 시 활성화됩니다.</Run>
            </Xpf:TextBlock>
        </Xpf:MaskControl>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
