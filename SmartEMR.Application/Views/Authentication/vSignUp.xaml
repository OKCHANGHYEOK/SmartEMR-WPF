<base:ModelViewLayout x:TypeArguments="vm:MemberViewModel"
                      x:Class="SmartEMR.Application.Views.Authentication.vSignUp"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.Authentication"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                      xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      mc:Ignorable="d"
                      d:DesignHeight="800"
                      d:DesignWidth="1100"
                      d:DataContext="{d:DesignInstance Type={x:Type vm:MemberViewModel}}">

    <Xpf:StyleGrid  LayoutDefinitions="2,1"
                    ColumnSizeDefinitions="0.3*,0.7*">

        <Border Grid.Column="0"
                CornerRadius="11,0,0,11">

            <Border.Background>
                <ImageBrush ImageSource="/Images/smartemr_hospital.png"
                            Stretch="UniformToFill"
                            AlignmentX="Left"
                            AlignmentY="Center"/>
            </Border.Background>

            <StackPanel Orientation="Vertical"
                        Margin="20,80,40,0">

                <Xpf:StyleGrid  LayoutDefinitions="2,1"
                                ColumnSizeDefinitions="Auto,*"
                                Margin="5,0,0,0">

                    <Border Grid.Column="0"
                            Width="28"
                            Height="28">

                        <Border.Background>
                            <ImageBrush ImageSource="/Images/smartemr_logo.png"
                                        Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>

                    <Xpf:TextBlock  Grid.Column="1"
                                    Text="SmartEMR"
                                    Foreground="#193458"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Left"
                                    Margin="8,0,0,0"/>
                </Xpf:StyleGrid>

                <Xpf:TextBlock  FontSize="14"
                                Foreground="#193458"
                                FontWeight="SemiBold"
                                Margin="10,10,0,0"
                                HorizontalAlignment="Left">
                    <Run>
                        더 나은 의료서비스를 위한
                    </Run>
                    <LineBreak/>
                    <Run>
                        스마트한 선택
                    </Run>
                </Xpf:TextBlock>

                <Xpf:TextBlock FontSize="12"
                               Foreground="#607A9A"
                               LineHeight="20"
                               HorizontalAlignment="Left"
                               Margin="10,10,0,0">
                    
                    <Run>
                        SmartEMR은 병원과 환자를 이어주는
                    </Run>
                    <LineBreak/>
                    <Run>
                        보다 편리하고 안전한 의료정보 시스템입니다.
                    </Run>
                </Xpf:TextBlock>
            </StackPanel>
        </Border>

        <Border Grid.Column="1"
                Background="#FFFFFF"
                CornerRadius="0,11,11,0">

            <StackPanel Orientation="Vertical"
                        Margin="20,40,10,20">

                <Xpf:TextBlock  Text="회원가입"
                                FontWeight="Bold"
                                FontSize="20"
                                Foreground="#193458"
                                HorizontalAlignment="Left"/>


                <Xpf:TextBlock  Text="SmartEMR과 함께 시작하세요."
                                FontSize="14"
                                FontWeight="DemiBold"
                                Foreground="#294A70"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0"/>

                <Xpf:TextBlock  Text="아래 정보를 입력하시면 회원가입이 완료됩니다."
                                FontSize="12"
                                FontWeight="Regular"
                                Foreground="#294A70"
                                HorizontalAlignment="Left"
                                Margin="0,5,0,0">
                </Xpf:TextBlock>

                <Xpf:StyleGrid  LayoutDefinitions="2,17"
                                ColumnSizeDefinitions="0.3*,*"
                                Margin="0,15,0,0">

                    <StackPanel Grid.Column="0"
                                Grid.Row="0"
                                Orientation="Horizontal">

                        <Border Width="18"
                                Height="18"
                                BorderBrush="Transparent">
                            <Border.Background>
                                <ImageBrush ImageSource="/Images/smartemr_person.png"
                                                Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Xpf:TextBlock  Text="기본 정보"
                                        FontSize="14"
                                        Foreground="#294A70"
                                        FontWeight="SemiBold"
                                        Margin="5,0,0,0"/>
                    </StackPanel>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="1"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            이름
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <Xpf:TextEdit   Grid.Column="1"
                                    Grid.Row="1"
                                    Text="{Binding MemberUser.MUR_Name}"
                                    NullText="이름을 입력하세요."
                                    HorizontalAlignment="Stretch"
                                    BorderBrush="#DDE5EF"
                                    BorderThickness="1.5"
                                    CornerRadius="4"
                                    Padding="5"/>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="2"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            아이디
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <Xpf:StyleGrid  Grid.Column="1"
                                    Grid.Row="2"
                                    LayoutDefinitions="3,1"
                                    ColumnSizeDefinitions="*,5,Auto"
                                    Margin="0,10,0,0">

                        <Xpf:TextEdit   Grid.Column="0"
                                        Text="{Binding MemberUser.MUR_Id}"
                                        NullText="사용하실 아이디를 입력하세요."
                                        HorizontalAlignment="Stretch"
                                        BorderBrush="#DDE5EF"
                                        BorderThickness="1.5"
                                        CornerRadius="4"
                                        Padding="5"/>

                        <Xpf:Button Grid.Column="2"
                                    Content="중복확인"
                                    Foreground="SlateBlue"
                                    FontWeight="SemiBold"
                                    Background="Transparent"
                                    BorderBrush="SlateBlue"
                                    CornerRadius="5"
                                    HorizontalAlignment="Center"
                                    Padding="4,0,4,0"
                                    Command="{Binding CheckDuplicateCommand}"/>
                    </Xpf:StyleGrid>


                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="3"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            비밀번호
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <dxe:PasswordBoxEdit    x:Name="pwMUR_Password"
                                            Grid.Column="1"
                                            Grid.Row="3"
                                            Text="{Binding MemberUser.MUR_PassWord}"
                                            NullText="비밀번호를 입력하세요."
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="#DDE5EF"
                                            BorderThickness="1.5"
                                            CornerRadius="4"
                                            PasswordChar="*"
                                            Padding="5"
                                            Margin="0,10,0,0"
                                            ShowPasswordButtonVisibility="Always">

                        <dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                            <DataTemplate>
                                <local:ShowPasswordButtonTemplate/>
                            </DataTemplate>
                        </dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                    </dxe:PasswordBoxEdit>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="4"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run    Foreground="#294A70"
                                FontSize="12"
                                FontWeight="SemiBold">
                            비밀번호 확인
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <dxe:PasswordBoxEdit    x:Name="pwMUR_PasswordCheck"
                                            Grid.Column="1"
                                            Grid.Row="4"
                                            NullText="비밀번호를 다시 입력하세요."
                                            HorizontalAlignment="Stretch"
                                            BorderBrush="#DDE5EF"
                                            BorderThickness="1.5"
                                            CornerRadius="4"
                                            PasswordChar="*"
                                            Padding="5"
                                            Margin="0,10,0,0"
                                            ShowPasswordButtonVisibility="Always"
                                            EditValueChanged="OnEditValueChanged_PasswordEdit">

                        <dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                            <DataTemplate>
                                <local:ShowPasswordButtonTemplate/>
                            </DataTemplate>
                        </dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                    </dxe:PasswordBoxEdit>

                    <StackPanel Grid.Column="0"
                                Grid.Row="5"
                                Orientation="Horizontal"
                                Margin="0,15,0,0">

                        <Border Width="18"
                                Height="18"
                                BorderBrush="Transparent">
                            <Border.Background>
                                <ImageBrush ImageSource="/Images/smartemr_office.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Xpf:TextBlock  Text="기관 정보"
                                        FontSize="14"
                                        Foreground="#294A70"
                                        FontWeight="SemiBold"
                                        Margin="5,0,0,0"/>
                    </StackPanel>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="6"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            병원정보
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <Xpf:ComboBoxEdit   Grid.Column="1"
                                        Grid.Row="6"
                                        EditValue="{Binding Model.MEM_Idx}"
                                        NullText="병원을 선택하거나 직접 입력하세요."
                                        ItemsSource="{x:Static selection:InputOptionItems.Members}"
                                        DisplayMember="MEM_Name"
                                        ValueMember="MEM_Idx"
                                        BorderBrush="#DDE5EF"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Padding="5"
                                        Margin="0,10,0,0"/>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="7"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            요양기관번호
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <Xpf:TextEdit   Grid.Column="1"
                                    Grid.Row="7"
                                    EditValue="{Binding Model.MEM_BizNum}"
                                    NullText="요양기관번호을 입력하세요."
                                    BorderBrush="#DDE5EF"
                                    CornerRadius="4"
                                    HorizontalAlignment="Stretch"
                                    Padding="5"
                                    Margin="0,10,0,0"/>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="8"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            기관종구분
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>


                    <Xpf:ComboBoxEdit   Grid.Column="1"
                                        Grid.Row="8"
                                        EditValue="{Binding Model.MEM_BizType}"
                                        NullText="기관종구분을 선택하세요."
                                        ItemsSource="{x:Static selection:InputOptionItems.BizTypes}"
                                        DisplayMember="CCI_Name"
                                        ValueMember="CCI_Cd"
                                        BorderBrush="#DDE5EF"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Padding="5"
                                        Margin="0,10,0,0"/>

                    <StackPanel Grid.Column="0"
                                Grid.Row="9"
                                Orientation="Horizontal"
                                Margin="0,15,0,0">

                        <Border Width="18"
                                Height="18"
                                BorderBrush="Transparent">
                            <Border.Background>
                                <ImageBrush ImageSource="/Images/smartemr_work.png"
                                            Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Xpf:TextBlock  Text="근무 정보"
                                        FontSize="14"
                                        Foreground="#294A70"
                                        FontWeight="SemiBold"
                                        Margin="5,0,0,0"/>
                    </StackPanel>


                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="10"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            부서
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>


                    <Xpf:ComboBoxEdit   Grid.Column="1"
                                        Grid.Row="10"
                                        NullText="부서를 선택하세요."
                                        BorderBrush="#DDE5EF"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Padding="5"
                                        Margin="0,10,0,0"/>


                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="11"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            직책
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <Xpf:ComboBoxEdit   Grid.Column="1"
                                        Grid.Row="11"
                                        NullText="직책을 선택하세요."
                                        BorderBrush="#DDE5EF"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Padding="5"
                                        Margin="0,10,0,0"/>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="12"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            의료면허번호
                        </Run>

                        <Run Text="*" 
                             Foreground="IndianRed"
                             FontWeight="Bold"/>
                    </Xpf:TextBlock>

                    <Xpf:TextEdit   Grid.Column="1"
                                    Grid.Row="12"
                                    NullText="의료면허번호를 입력하세요. (의료인인 경우에만 입력)"
                                    BorderBrush="#DDE5EF"
                                    CornerRadius="4"
                                    HorizontalAlignment="Stretch"
                                    Padding="5"
                                    Margin="0,10,0,0"/>

                    <StackPanel Grid.Column="0"
                                Grid.Row="13"
                                Orientation="Horizontal"
                                Margin="0,15,0,0">

                        <Border Width="18"
                                Height="18"
                                BorderBrush="Transparent">
                            <Border.Background>
                                <ImageBrush ImageSource="/Images/smartemr_contact.png"
                                                Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>

                        <Xpf:TextBlock  Text="개인정보(선택)"
                                        FontSize="14"
                                        Foreground="#294A70"
                                        FontWeight="SemiBold"
                                        Margin="5,0,0,0"/>
                    </StackPanel>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="14"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            주민등록번호
                        </Run>
                    </Xpf:TextBlock>

                    <Xpf:StyleGrid  Grid.Column="1"
                                    Grid.Row="14"
                                    LayoutDefinitions="3,1"
                                    ColumnSizeDefinitions="*,*,Auto"
                                    Margin="0,10,0,0">
                        
                        <Xpf:TextEdit   Grid.Column="0"
                                        Grid.Row="15"
                                        NullText="주민번호앞자리"
                                        MaskType="Numeric"
                                        Mask="n0"
                                        BorderBrush="#DDE5EF"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Padding="5"/>

                        <Xpf:TextEdit   Grid.Column="1"
                                        Grid.Row="15"
                                        NullText="주민번호뒷자리"
                                        MaskType="Numeric"
                                        Mask="n0"
                                        BorderBrush="#DDE5EF"
                                        CornerRadius="4"
                                        HorizontalAlignment="Stretch"
                                        Padding="5"
                                        Margin="2,0,0,0"/>

                        <Xpf:ComboBoxEdit   Grid.Column="2"
                                            Width="80"
                                            ItemsSource="{x:Static selection:InputOptionItems.Sexes}"
                                            NullText="성별선택"
                                            BorderBrush="#DDE5EF"
                                            BorderThickness="1.5"
                                            CornerRadius="4"
                                            Margin="2,0,0,0"/>
                    </Xpf:StyleGrid>

                    <Xpf:StyleGrid  Grid.Column="1"
                                    Grid.Row="14"
                                    LayoutDefinitions="3,1"
                                    ColumnSizeDefinitions="*,Auto,*">

                        <Xpf:StyleGrid Grid.Column="0"
                                       LayoutDefinitions="3,1">
                            
                        </Xpf:StyleGrid>
                    </Xpf:StyleGrid>

                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="15"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            휴대폰 번호
                        </Run>
                    </Xpf:TextBlock>


                    <Xpf:TextEdit   Grid.Column="1"
                                    Grid.Row="15"
                                    NullText="휴대폰번호를 입력하세요."
                                    BorderBrush="#DDE5EF"
                                    CornerRadius="4"
                                    HorizontalAlignment="Stretch"
                                    Padding="5"
                                    Margin="0,10,0,0"/>


                    <Xpf:TextBlock  Grid.Column="0"
                                    Grid.Row="16"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,10,0,0">

                        <Run Foreground="#294A70"
                             FontSize="12"
                             FontWeight="SemiBold">
                            이메일
                        </Run>
                    </Xpf:TextBlock>
                </Xpf:StyleGrid>
            </StackPanel>
        </Border>
    </Xpf:StyleGrid>
</base:ModelViewLayout>