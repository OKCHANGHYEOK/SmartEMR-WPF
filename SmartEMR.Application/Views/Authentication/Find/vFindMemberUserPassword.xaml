<base:ModelViewLayout   x:TypeArguments="vm:FindMemberUserViewModel"
                        x:Class="SmartEMR.Application.Views.Authentication.Find.vFindMemberUserPassword"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.Authentication"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        mc:Ignorable="d"
                        d:DesignHeight="600"
                        d:DesignWidth="800"
                        d:DataContext="{d:DesignInstance Type={x:Type vm:FindMemberUserViewModel}}">

    <Xpf:StyleGrid  LayoutDefinitions="1,5"
                    ColumnSizeDefinitions="*"
                    RowSizeDefinitions="Auto,24,*,Auto,Auto"
                    Margin="30,24,30,18">

        <!-- 화면 제목 -->
        <Xpf:StyleGrid  Grid.Row="0"
                        LayoutDefinitions="1,5"
                        ColumnSizeDefinitions="*"
                        RowSizeDefinitions="32,8,Auto,20,1">

            <TextBlock  Grid.Row="0"
                        Text="비밀번호 찾기"
                        FontSize="22"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryTextBrush}"
                        VerticalAlignment="Center"/>

            <TextBlock  Grid.Row="2"
                        Text="등록된 이메일로 본인 인증을 완료한 뒤 비밀번호를 재설정할 수 있습니다."
                        FontSize="12"
                        Foreground="{StaticResource SecondaryTextBrush}"
                        VerticalAlignment="Center"/>

            <Border Grid.Row="4"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"/>
        </Xpf:StyleGrid>

        <!-- 1단계: 계정 확인 및 이메일 본인 인증 -->
        <Xpf:StyleGrid  Grid.Row="2"
                        LayoutDefinitions="1,5"
                        ColumnSizeDefinitions="*"
                        RowSizeDefinitions="Auto,32,Auto,32,*">
            <Xpf:StyleGrid.Style>
                <Style TargetType="{x:Type Xpf:StyleGrid}">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPasswordResetStep}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Xpf:StyleGrid.Style>

            <Xpf:StyleGrid  Grid.Row="0"
                            LayoutDefinitions="1,9"
                            ColumnSizeDefinitions="*"
                            RowSizeDefinitions="24,12,1,20,38,10,38,10,38">

                <TextBlock  Grid.Row="0"
                            Text="계정 정보 확인"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center"/>

                <TextBlock  Grid.Row="0"
                            Text="비밀번호를 재설정할 계정 정보를 입력해 주세요."
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,1,0,0"/>

                <!-- 아이디 -->
                <TextBlock  Grid.Row="4"
                            Text="아이디"
                            Style="{StaticResource FieldLabelStyle}"/>

                <Xpf:TextEdit   x:Name="txtMUR_Id"
                                Grid.Row="4"
                                EditValue="{Binding Model.MUR_Id, UpdateSourceTrigger=PropertyChanged}"
                                NullText="가입한 아이디를 입력해 주세요."
                                Margin="90,0,0,0">

                    <Xpf:TextEdit.Style>
                        <Style TargetType="{x:Type Xpf:TextEdit}" BasedOn="{StaticResource FormEditorStyle}">
                            <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
                            <Setter Property="IsReadOnly" Value="False"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ReadOnlyBackgroundBrush}"/>
                                    <Setter Property="IsReadOnly" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Xpf:TextEdit.Style>
                </Xpf:TextEdit>

                <!-- 이름 -->
                <TextBlock  Grid.Row="6"
                            Text="이름"
                            Style="{StaticResource FieldLabelStyle}"/>

                <Xpf:TextEdit   x:Name="txtMUR_Name"
                                Grid.Row="6"
                                EditValue="{Binding Model.MUR_Name, UpdateSourceTrigger=PropertyChanged}"
                                NullText="이름을 입력해 주세요."
                                Margin="90,0,0,0">

                    <Xpf:TextEdit.Style>
                        <Style TargetType="{x:Type Xpf:TextEdit}" BasedOn="{StaticResource FormEditorStyle}">
                            <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
                            <Setter Property="IsReadOnly" Value="False"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource ReadOnlyBackgroundBrush}"/>
                                    <Setter Property="IsReadOnly" Value="True"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Xpf:TextEdit.Style>
                </Xpf:TextEdit>

                <!-- 등록 이메일 -->
                <TextBlock  Grid.Row="8"
                            Text="이메일"
                            Style="{StaticResource FieldLabelStyle}"/>

                <Xpf:StyleGrid  Grid.Row="8"
                                LayoutDefinitions="2,1"
                                ColumnSizeDefinitions="*,110"
                                RowSizeDefinitions="38">

                    <Xpf:TextEdit   x:Name="txtMUR_Email"
                                    Grid.Column="0"
                                    EditValue="{Binding Model.MUR_Email, UpdateSourceTrigger=PropertyChanged}"
                                    NullText="등록된 이메일 주소를 입력해 주세요."
                                    Margin="90,0,8,0">

                        <Xpf:TextEdit.Style>
                            <Style TargetType="{x:Type Xpf:TextEdit}" BasedOn="{StaticResource FormEditorStyle}">
                                <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
                                <Setter Property="IsReadOnly" Value="False"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ReadOnlyBackgroundBrush}"/>
                                        <Setter Property="IsReadOnly" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Xpf:TextEdit.Style>
                    </Xpf:TextEdit>

                    <dxc:SimpleButton   Grid.Column="1"
                                        Content="인증번호 발송"
                                        Command="{Binding RequestVerifyCodeCommand}">
                        <dxc:SimpleButton.Style>
                            <Style TargetType="{x:Type dxc:SimpleButton}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxc:SimpleButton.Style>
                    </dxc:SimpleButton>
                </Xpf:StyleGrid>
            </Xpf:StyleGrid>

            <!-- 이메일 인증 -->
            <Xpf:StyleGrid  Grid.Row="2"
                            LayoutDefinitions="1,5"
                            ColumnSizeDefinitions="*"
                            RowSizeDefinitions="24,12,1,20,38">

                <TextBlock  Grid.Row="0"
                            Text="이메일 인증"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center"/>

                <TextBlock  Grid.Row="0"
                            Text="등록된 이메일로 발송된 인증코드를 입력해 주세요."
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,1,0,0"/>

                <TextBlock  Grid.Row="4"
                            Text="인증코드"
                            Style="{StaticResource FieldLabelStyle}"/>

                <Xpf:StyleGrid  Grid.Row="4"
                                LayoutDefinitions="2,1"
                                ColumnSizeDefinitions="*,110"
                                RowSizeDefinitions="38">

                    <Xpf:TextEdit   x:Name="txtVerifyCode"
                                    Grid.Column="0"
                                    EditValue="{Binding VerifyManager.IdentityVerificationCode, UpdateSourceTrigger=PropertyChanged}"
                                    NullText="인증코드를 입력해 주세요."
                                    Margin="90,0,8,0">

                        <Xpf:TextEdit.Style>
                            <Style TargetType="{x:Type Xpf:TextEdit}" BasedOn="{StaticResource FormEditorStyle}">
                                <Setter Property="Background" Value="{StaticResource EditorBackgroundBrush}"/>
                                <Setter Property="IsReadOnly" Value="False"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource ReadOnlyBackgroundBrush}"/>
                                        <Setter Property="IsReadOnly" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Xpf:TextEdit.Style>
                    </Xpf:TextEdit>

                    <Xpf:TextBlock  x:Name="txtVerifyTimer"
                                    Grid.Column="0"
                                    FontSize="11"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="2,0,12,0">

                        <Xpf:TextBlock.Style>
                            <Style TargetType="{x:Type Xpf:TextBlock}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifyManager.IsRequestVerifyCode}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Xpf:TextBlock.Style>

                        <Run Text="남은시간 :"/>
                        <Run Text="{Binding VerifyManager.VerifyLimitTimeText}"/>
                    </Xpf:TextBlock>

                    <dxc:SimpleButton   Grid.Column="1"
                                        Content="인증 확인"
                                        Command="{Binding RequestVerifyCheckCommand}">
                        <dxc:SimpleButton.Style>
                            <Style TargetType="{x:Type dxc:SimpleButton}" BasedOn="{StaticResource SecondaryButtonStyle}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerifyManager.IsRequestVerifyCode}" Value="True">
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </dxc:SimpleButton.Style>
                    </dxc:SimpleButton>
                </Xpf:StyleGrid>
            </Xpf:StyleGrid>

        </Xpf:StyleGrid>

        <!-- 2단계: 새 비밀번호 재설정 -->
        <Xpf:StyleGrid  Grid.Row="2"
                        LayoutDefinitions="1,1"
                        ColumnSizeDefinitions="*"
                        RowSizeDefinitions="Auto">
            <Xpf:StyleGrid.Style>
                <Style TargetType="{x:Type Xpf:StyleGrid}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPasswordResetStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Xpf:StyleGrid.Style>

            <Xpf:StyleGrid  Grid.Row="0"
                            LayoutDefinitions="1,9"
                            ColumnSizeDefinitions="*"
                            RowSizeDefinitions="24,12,1,20,38,Auto,8,38,Auto">

                <TextBlock  Grid.Row="0"
                            Text="새 비밀번호 설정"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryTextBrush}"
                            VerticalAlignment="Center"/>

                <TextBlock  Grid.Row="0"
                            Text="영문 대·소문자, 숫자, 특수문자를 포함해 8~20자로 설정해 주세요."
                            FontSize="11"
                            Foreground="{StaticResource SecondaryTextBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"/>

                <Border Grid.Row="2"
                        BorderBrush="{StaticResource SeparatorBrush}"
                        BorderThickness="0,1,0,0"/>

                <!-- 새 비밀번호 -->
                <TextBlock  Grid.Row="4"
                            Text="새 비밀번호"
                            Style="{StaticResource FieldLabelStyle}"/>

                <dxe:PasswordBoxEdit    x:Name="pwMUR_Password"
                                        Grid.Row="4"
                                        EditValue="{Binding Model.MUR_PassWord, UpdateSourceTrigger=PropertyChanged}"
                                        NullText="새 비밀번호를 입력해 주세요."
                                        HorizontalAlignment="Stretch"
                                        Background="{StaticResource EditorBackgroundBrush}"
                                        BorderBrush="#DDE5EF"
                                        BorderThickness="1.5"
                                        CornerRadius="4"
                                        PasswordChar="*"
                                        Padding="5"
                                        Margin="90,0,0,0"
                                        ShowPasswordButtonVisibility="Always"
                                        PreviewTextInput="OnPreviewTextInput_PasswordEdit"
                                        EditValueChanged="OnEditValueChanged_PasswordEdit">
                    <dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                        <DataTemplate>
                            <local:ShowPasswordButtonTemplate/>
                        </DataTemplate>
                    </dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                </dxe:PasswordBoxEdit>


                <Xpf:Label  x:Name="lblUnUsablePassword"
                            Grid.Row="5"
                            Content="사용할 수 없는 비밀번호입니다."
                            Foreground="IndianRed"
                            FontSize="11"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Margin="90,0,0,0">

                    <Xpf:Label.Style>
                        <Style TargetType="{x:Type Xpf:Label}">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding PasswordInputState.IsChangedPassword}" Value="True"/>
                                        <Condition Binding="{Binding PasswordInputState.UsablePassword}" Value="False"/>
                                    </MultiDataTrigger.Conditions>

                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Xpf:Label.Style>
                </Xpf:Label>

                <!-- 새 비밀번호 확인 -->
                <TextBlock  Grid.Row="7"
                            Text="비밀번호 확인"
                            Style="{StaticResource FieldLabelStyle}"/>

                <dxe:PasswordBoxEdit    x:Name="pwMUR_PasswordCheck"
                                        Grid.Row="7"
                                        EditValue="{Binding Model.MUR_PassWordCheck, UpdateSourceTrigger=PropertyChanged}"
                                        NullText="새 비밀번호를 다시 입력해 주세요."
                                        HorizontalAlignment="Stretch"
                                        Background="{StaticResource EditorBackgroundBrush}"
                                        BorderBrush="#DDE5EF"
                                        BorderThickness="1.5"
                                        CornerRadius="4"
                                        PasswordChar="*"
                                        Padding="5"
                                        Margin="90,0,0,0"
                                        ShowPasswordButtonVisibility="Always"
                                        EditValueChanged="OnEditValueChanged_PasswordEdit">
                    <dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                        <DataTemplate>
                            <local:ShowPasswordButtonTemplate/>
                        </DataTemplate>
                    </dxe:PasswordBoxEdit.ShowPasswordButtonTemplate>
                </dxe:PasswordBoxEdit>

                <Xpf:Label Grid.Row="8"
                           Margin="90,0,0,0"
                           FontSize="11">
                    <Xpf:Label.Style>
                        <Style TargetType="{x:Type Xpf:Label}">
                            <Setter Property="Content" Value="새 비밀번호를 입력하고 확인해 주세요."/>
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PasswordInputState.IsPasswordMatch}" Value="True">
                                    <Setter Property="Content" Value="비밀번호가 일치합니다."/>
                                    <Setter Property="Foreground" Value="Blue"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Xpf:Label.Style>
                </Xpf:Label>
            </Xpf:StyleGrid>

        </Xpf:StyleGrid>

        <!-- 하단 구분선 -->
        <Border Grid.Row="3"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,12,0,0"
                Margin="0,10,0,0"/>

        <!-- 하단 버튼 -->
        <Xpf:StyleGrid  Grid.Row="4"
                        LayoutDefinitions="3,1"
                        ColumnSizeDefinitions="Auto,*,Auto"
                        Margin="0,5,0,0">

            <StackPanel Grid.Column="0"
                        Orientation="Vertical">

                <Xpf:Button x:Name="btnBackToLogin"
                            Content="←  로그인 화면으로"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#607A9A"
                            FontSize="11"
                            Cursor="Hand"
                            Click="OnClick_Button"/>

                <Xpf:Button x:Name="btnBackToSelectFindType"
                            Content="←  계정 찾기 화면으로"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#607A9A"
                            FontSize="11"
                            Cursor="Hand"
                            Click="OnClick_Button"/>

                <Xpf:Button x:Name="btnBackToVerificationStep"
                            Content="←  인증 화면으로"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#607A9A"
                            FontSize="11"
                            Cursor="Hand"
                            Command="{Binding BackToVerificationStepCommand}">
                    <Xpf:Button.Style>
                        <Style TargetType="{x:Type Xpf:Button}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPasswordResetStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Xpf:Button.Style>
                </Xpf:Button>
            </StackPanel>

            <!-- 인증 완료 후 다음 단계로 이동 -->
            <dxc:SimpleButton   x:Name="btnNextStep"
                                Grid.Column="2"
                                Content="다음"
                                Command="{Binding MoveToResetPasswordCommand}">
                
                <dxc:SimpleButton.Style>
                    <Style TargetType="{x:Type dxc:SimpleButton}" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VerifyManager.IsIdentityVerified}" Value="True">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPasswordResetStep}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxc:SimpleButton.Style>
            </dxc:SimpleButton>

            <!-- 새 비밀번호 저장 -->
            <dxc:SimpleButton   x:Name="btnResetPassword"
                                Grid.Column="2"
                                Content="비밀번호 변경"
                                Command="{Binding ResetPasswordCommand}">
                <dxc:SimpleButton.Style>
                    <Style TargetType="{x:Type dxc:SimpleButton}" BasedOn="{StaticResource PrimaryButtonStyle}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="IsEnabled" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPasswordResetStep}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding PasswordInputState.IsPasswordMatch}" Value="True">
                                <Setter Property="IsEnabled" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </dxc:SimpleButton.Style>
            </dxc:SimpleButton>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
