<base:ModelViewLayout   x:TypeArguments="vm:FindMemberUserViewModel"
                        x:Class="SmartEMR.Application.Views.Authentication.Find.vFindMemberUser"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.Authentication.Find"
                        xmlns:auth="clr-namespace:SmartEMR.Application.Views.Authentication"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:common="clr-namespace:SmartEMR.Application.Common"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:StyleGrid  LayoutDefinitions="2,1"
                    ColumnSizeDefinitions="0.3*,0.7*">

        <auth:SmartEMRBrandPanel Grid.Column="0"/>

        <Border Grid.Column="1"
                Background="#FFFFFF"
                CornerRadius="0,0,12,0">

            <Xpf:StyleGrid  Grid.Column="1">
                <StackPanel x:Name="SelectFindTypePanel"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">

                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FindType}" Value="{x:Static vm:FindType.None}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>                                     
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Xpf:TextBlock  Text="계정 찾기"    
                                    FontSize="21"
                                    FontWeight="Bold"
                                    Foreground="#193458"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,6"/>

                    <Xpf:TextBlock  Text="찾으실 항목을 선택해주세요."
                                    FontSize="12"
                                    Foreground="#607A9A"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,22"/>

                    <dxc:SimpleButton   x:Name="btnFindId"
                                        Width="370"
                                        Height="125"
                                        Margin="0,0,0,12"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="#FFFFFF"
                                        BorderBrush="#DDE5EF"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="18"
                                        Cursor="Hand"
                                        Command="{Binding SetFindTypeCommand}"
                                        CommandParameter="{x:Static vm:FindType.Id}">

                        <dxc:SimpleButton.Style>
                            <Style TargetType="{x:Type dxc:SimpleButton}">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#DDE5EF"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#193458"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F7FAFD"/>
                                        <Setter Property="BorderBrush" Value="#8EA8C5"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#EEF4FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </dxc:SimpleButton.Style>

                        <Xpf:StyleGrid  LayoutDefinitions="2,1"
                                        ColumnSizeDefinitions="70,*">

                            <Border Grid.Column="0"
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Border.Background>
                                    <ImageBrush ImageSource="/Images/smartemr_identification.png" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0">

                                <Xpf:TextBlock  Text="아이디 찾기"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="#193458"/>

                                <Xpf:TextBlock  Text="의료기관정보 및 이메일로 아이디를 찾습니다."
                                                FontSize="12"
                                                Foreground="#607A9A"
                                                Margin="0,6,0,0"/>
                            </StackPanel>
                        </Xpf:StyleGrid>
                    </dxc:SimpleButton>


                    <dxc:SimpleButton   x:Name="btnFindPassword"
                                        Width="370"
                                        Height="125"
                                        Margin="0,0,0,0"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        Background="#FFFFFF"
                                        BorderBrush="#DDE5EF"
                                        BorderThickness="1.5"
                                        CornerRadius="8"
                                        Padding="18"
                                        Cursor="Hand"
                                        Command="{Binding SetFindTypeCommand}"
                                        CommandParameter="{x:Static vm:FindType.Password}">

                        <dxc:SimpleButton.Style>
                            <Style TargetType="{x:Type dxc:SimpleButton}">
                                <Setter Property="Background" Value="#FFFFFF"/>
                                <Setter Property="BorderBrush" Value="#DDE5EF"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                                <Setter Property="Foreground" Value="#193458"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F7FAFD"/>
                                        <Setter Property="BorderBrush" Value="#8EA8C5"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#EEF4FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </dxc:SimpleButton.Style>

                        <Xpf:StyleGrid  LayoutDefinitions="2,1"
                                        ColumnSizeDefinitions="70,*">

                            <!-- 이미지 영역 -->
                            <Border Grid.Column="0"
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">

                                <Border.Background>
                                    <ImageBrush ImageSource="/Images/smartemr_password_locker.png" Stretch="Uniform"/>
                                </Border.Background>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="14,0,0,0">

                                <Xpf:TextBlock  Text="비밀번호 찾기"
                                                FontSize="16"
                                                FontWeight="Bold"
                                                Foreground="#193458"/>

                                <Xpf:TextBlock  Text="아이디 및 이메일으로 비밀번호를 찾습니다."
                                                FontSize="12"
                                                Foreground="#607A9A"
                                                Margin="0,6,0,0"/>
                            </StackPanel>
                        </Xpf:StyleGrid>
                    </dxc:SimpleButton>

                    <dxc:SimpleButton   x:Name="btnBackToLogin"
                                        Content="로그인 화면으로"
                                        Width="180"
                                        Height="38"
                                        Margin="0,22,0,0"
                                        HorizontalAlignment="Center"
                                        Background="#294A70"
                                        BorderBrush="#294A70"
                                        BorderThickness="1"
                                        Foreground="#FFFFFF"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        CornerRadius="5"
                                        Cursor="Hand"
                                        Click="OnClick_SimpleButton">

                        <dxc:SimpleButton.Style>
                            <Style TargetType="{x:Type dxc:SimpleButton}">
                                <Setter Property="Background" Value="#294A70"/>
                                <Setter Property="BorderBrush" Value="#294A70"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#193458"/>
                                        <Setter Property="BorderBrush" Value="#193458"/>
                                    </Trigger>

                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#102640"/>
                                        <Setter Property="BorderBrush" Value="#102640"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </dxc:SimpleButton.Style>
                    </dxc:SimpleButton>
                </StackPanel>

                <Xpf:StyleGrid  x:Name="FindMemberUserContentGrid"
                                LayoutDefinitions="1,2"
                                RowSizeDefinitions="*,Auto">

                    <Xpf:StyleGrid.Style>
                        <Style TargetType="{x:Type Xpf:StyleGrid}">
                            <Setter Property="Visibility" Value="Visible"/>

                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FindType}" Value="{x:Static vm:FindType.None}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Xpf:StyleGrid.Style>

                    <local:vFindMemberUserId>
                        <local:vFindMemberUserId.Style>
                            <Style TargetType="{x:Type base:ModelViewLayout}">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding vm.FindType, RelativeSource={RelativeSource AncestorType={x:Type local:vFindMemberUser}}}" Value="{x:Static vm:FindType.Id}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:vFindMemberUserId.Style>
                    </local:vFindMemberUserId>

                    <local:vFindMemberUserPassword>
                        <local:vFindMemberUserPassword.Style>
                            <Style TargetType="{x:Type base:ModelViewLayout}">
                                <Setter Property="Visibility" Value="Collapsed"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding vm.FindType, RelativeSource={RelativeSource AncestorType={x:Type local:vFindMemberUser}}}" Value="{x:Static vm:FindType.Password}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </local:vFindMemberUserPassword.Style>
                    </local:vFindMemberUserPassword>
                </Xpf:StyleGrid>
            </Xpf:StyleGrid>
        </Border>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
