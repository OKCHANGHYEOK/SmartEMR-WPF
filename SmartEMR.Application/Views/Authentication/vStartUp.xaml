<base:ModelViewLayout x:TypeArguments="vm:StartUpViewModel"
                      x:Class="SmartEMR.Application.Views.Authentication.vStartUp"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.Authentication"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid Background="Transparent">
        <local:vLogin x:Name="LoginView"/>
        <local:vSignUp x:Name="SignUpView" Visibility="Collapsed"/>
    </Xpf:StyleGrid>
</base:ModelViewLayout>