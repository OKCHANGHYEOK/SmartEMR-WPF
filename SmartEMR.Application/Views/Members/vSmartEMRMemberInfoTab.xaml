<base:ModelViewLayout   x:TypeArguments="vm:MemberInfoViewModel"
                        x:Class="SmartEMR.Application.Views.Members.vSmartEMRMemberInfoTab"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.Members"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:memberuser="clr-namespace:SmartEMR.Application.Views.MemberUsers"
                        xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        ViewTitle="정보관리"
                        ViewSize="500,650"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">

    <dxc:DXTabControl   Padding="0"
                        dxc:ThemeManager.ThemeName="Office2019Colorful"
                        SelectionChanged="OnSelectionChanged_TaControl">
        <dxc:DXTabItem Header="회원사정보"
                       FontWeight="SemiBold"
                       Tag="MEM">
            
        </dxc:DXTabItem>
        <dxc:DXTabItem  Header="회원정보"
                        FontWeight="SemiBold"
                        Tag="MUR">
            <memberuser:vMemberUserInfo x:Name="MemberUserInfo"/>
        </dxc:DXTabItem>
    </dxc:DXTabControl>
</base:ModelViewLayout>
