<base:ModelViewLayout   x:TypeArguments="vm:MemberUserInfoViewModel"
                        x:Class="SmartEMR.Application.Views.MemberUsers.vMemberUserInfo_ChangePassword"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.MemberUsers"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        mc:Ignorable="d" 
                        ViewSize="350,540"
                        ViewTitle="비밀번호 변경"
                        d:DesignWidth="540"
                        d:DesignHeight="560"
                        d:DataContext="{d:DesignInstance Type={x:Type vm:MemberUserInfoViewModel}}">
    
    <Xpf:LayoutPanel ShowCaption="False"
                     Margin="2">

        <Xpf:StyleGrid  LayoutDefinitions="1,3"
                        RowSizeDefinitions="Auto,Auto,*">

            <Xpf:StyleGrid Grid.Row="0" 
                           LayoutDefinitions="2,1"
                           ColumnSizeDefinitions="Auto,*"
                           Height="80"
                           Margin="4,0">

                <Border Grid.Column="0"
                        Grid.Row="0"
                        Width="36"
                        Height="36"
                        HorizontalAlignment="Left"
                        Margin="3">
                    
                    <Border.Background>
                        <ImageBrush ImageSource="/Images/smartemr_password_locker.png"/>
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Orientation="Vertical">

                    <Xpf:TextBlock  Grid.Column="1"
                                    Text="비밀번호 변경"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="#193458"
                                    HorizontalAlignment="Stretch"
                                    Margin="4,0,0,0"/>

                    <Xpf:TextBlock FontSize="12"
                                   Foreground="#647FA5"
                                   Margin="4,0,0,0"
                                   VerticalAlignment="Top"
                                   HorizontalAlignment="Stretch">

                        <Run>보안을 위해 현재 비밀번호를 확인한후,</Run>
                        <LineBreak/>
                        <Run>새로운 비밀번호로 변경해주세요.</Run>
                    </Xpf:TextBlock>
                </StackPanel>
            </Xpf:StyleGrid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="#E3EBF5"
                    Margin="4,0"/>
            
            <!-- 입력란 영역 -->
            <Xpf:StyleGrid  Grid.Row="2"
                            LayoutDefinitions="1,5"
                            RowSizeDefinitions="Auto,Auto,Auto,*,Auto"
                            Margin="4,16,4,0">

                <!-- 현재 비밀번호 -->
                <StackPanel Grid.Row="0" Margin="0,0,0,18">
                    <Xpf:TextBlock Text="현재 비밀번호 *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#193458"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,6"/>

                    <dxe:PasswordBoxEdit x:Name="pwCurrentPassword"
                                         Height="34"
                                         FontSize="12"
                                         EditValue="{Binding CurrentPassword}"
                                         NullText="현재 비밀번호를 입력해 주세요."
                                         Padding="10,0"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         ShowPasswordButtonVisibility="Always"/>

                    <Xpf:TextBlock Text="ⓘ  현재 비밀번호를 정확히 입력해 주세요."
                                   FontSize="11"
                                   Foreground="#647FA5"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0"/>
                </StackPanel>

                <!-- 새 비밀번호 -->
                <StackPanel Grid.Row="1"
                            Margin="0,0,0,18">

                    <Xpf:TextBlock Text="새 비밀번호 *"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#193458"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,6"/>

                    <dxe:PasswordBoxEdit x:Name="pwNewPassword"
                                         Height="34"
                                         FontSize="12"
                                         EditValue="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}"
                                         NullText="새 비밀번호를 입력해 주세요."
                                         Padding="10,0"
                                         HorizontalContentAlignment="Left"
                                         VerticalContentAlignment="Center"
                                         ShowPasswordButtonVisibility="Always"
                                         EditValueChanged="OnEditValueChanged_PasswordEdit"/>

                    <!-- 비밀번호 정책 안내 -->
                    <Border Background="#F0F5FC"
                            CornerRadius="5"
                            Padding="12,10"
                            Margin="0,8,0,0">

                        <StackPanel>
                            <TextBlock Text="●  비밀번호는 다음 조건을 충족해야 합니다."
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#365982"
                                       Margin="0,0,0,8"/>

                            <Xpf:StyleGrid LayoutDefinitions="2,2"
                                           RowSizeDefinitions="Auto,Auto">

                                <TextBlock Grid.Row="0"
                                           Grid.Column="0"
                                           Text="✓   8자 이상 20자 이하"
                                           FontSize="11"
                                           Margin="0,2">
                                    
                                   <TextBlock.Style>
                                       <Style TargetType="TextBlock">
                                           <Setter Property="Foreground" Value="#647FA5"/>
                                           
                                           <Style.Triggers>
                                               <DataTrigger Binding="{Binding IsLengthSatisfied}" Value="True">
                                                   <Setter Property="Foreground" Value="#2ECC71"/>
                                               </DataTrigger>
                                           </Style.Triggers>
                                       </Style>
                                   </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Text="✓   숫자 포함"
                                           FontSize="11"
                                           Margin="0,2">
                                    
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#647FA5"/>
                                            
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsNumberSatisfied}" Value="True">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="0"
                                           Text="✓   영문 대소문자 포함"
                                           FontSize="11"
                                           Margin="0,2">
                                    
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#647FA5"/>
                                            
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEnglishSatisfied}" Value="True">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Text="✓   특수문자(!,@,#,$,%) 포함"
                                           FontSize="11"
                                           Margin="0,2">
                                    
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#647FA5"/>
                                            
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSpecialSatisfied}" Value="True">
                                                    <Setter Property="Foreground" Value="#2ECC71"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Xpf:StyleGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 새 비밀번호 확인 -->
                <StackPanel Grid.Row="2"
                            Margin="0,0,0,12">

                    <Xpf:TextBlock  Text="새 비밀번호 확인 *"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="#193458"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,6"/>

                    <dxe:PasswordBoxEdit    x:Name="pwNewPasswordCheck"
                                            Height="34"
                                            FontSize="12"
                                            EditValue="{Binding NewPasswordCheck, UpdateSourceTrigger=PropertyChanged}"
                                            NullText="새 비밀번호를 다시 입력해 주세요."
                                            Padding="10,0"
                                            HorizontalContentAlignment="Left"
                                            VerticalContentAlignment="Center"
                                            ShowPasswordButtonVisibility="Always"
                                            EditValueChanged="OnEditValueChanged_PasswordEdit"/>

                    <Xpf:Label  x:Name="lblUnMatchPassword"
                                Content="Ⓧ  비밀번호가 일치하지 않습니다."
                                FontSize="11"
                                Foreground="IndianRed"
                                HorizontalAlignment="Left"
                                Margin="0,6,0,0"
                                Visibility="Collapsed"/>
                </StackPanel>

                <!-- 하단 버튼 -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,4">

                    <dxc:SimpleButton   x:Name="btnCancel"
                                        Content="취소"
                                        Width="80"
                                        Height="34"
                                        Margin="0,0,8,0"
                                        Background="White"
                                        Foreground="#365982"
                                        BorderBrush="#C5D4E8"
                                        FontSize="12"
                                        Cursor="Hand"
                                        Click="OnClick_SimpleButton"/>

                    <dxc:SimpleButton   Content="비밀번호 변경"
                                        Width="120"
                                        Height="34"
                                        Background="#2474ED"
                                        Foreground="White"
                                        BorderBrush="#2474ED"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Cursor="Hand"
                                        Command="{Binding ChangePasswordCommand}"/>
                </StackPanel>
            </Xpf:StyleGrid>
        </Xpf:StyleGrid>
    </Xpf:LayoutPanel>
</base:ModelViewLayout>
