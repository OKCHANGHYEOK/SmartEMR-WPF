<base:ModelViewLayout   x:TypeArguments="vm:MemberUserInfoViewModel"
                        x:Class="SmartEMR.Application.Views.MemberUsers.vMemberUserInfo"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:local="clr-namespace:SmartEMR.Application.Views.MemberUsers"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" 
                        d:DesignWidth="800"
                        d:DataContext="{d:DesignInstance Type={x:Type vm:MemberUserInfoViewModel}}">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="*,0.6*,Auto"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Margin="2">

        <dxlc:GroupBox Grid.Row="0"
                       Header="기본정보"
                       FontWeight="Bold"
                       Padding="0"
                       ShowShadow="Never">

            <Xpf:BindGrid   LayoutDefinitions="1,6"
                            BindStyle="DataCell"
                            HeaderForeground="#193458"
                            HeaderWidth="80"
                            ItemSpace="2">

                <Xpf:BindItem   FieldName="MUR_Name"
                                Header="회 원 명"
                                BindType="TextBox"
                                Col="0"
                                Row="0"/>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="MUR_Id"
                                    Header="아 이 디"
                                    BindType="TextBox"
                                    Col="0"
                                    Row="1"/>

                    <Xpf:BindItem   FieldName="MUR_Gender"
                                    BindType="ComboBox"
                                    Width="60"
                                    ItemsSource="{x:Static selection:InputOptionItems.Sexes}"
                                    DisplayMember="vPAT_Sex"
                                    ValueMember="PAT_Sex"
                                    Margin="2"/>
                </x:Array>


                <Xpf:BindItem   FieldName="MUR_PassWord"
                                Header="비 밀 번 호"
                                BindType="PasswordBox"
                                Col="0"
                                Row="2">

                    <Xpf:StyleGrid  LayoutDefinitions="2,1"
                                    ColumnSizeDefinitions="*,Auto">

                        <dxe:PasswordBoxEdit    x:Name="pwMUR_Password"
                                                Grid.Column="0"
                                                Password="00000000"
                                                HorizontalAlignment="Stretch"
                                                BorderBrush="#DDE5EF"
                                                BorderThickness="1"
                                                PasswordChar="*"
                                                ShowPasswordButtonVisibility="None"
                                                IsReadOnly="True"
                                                Focusable="False"/>

                            <dxc:SimpleButton   Grid.Column="1"
                                                Width="100"
                                                Content="비밀번호 변경"
                                                Background="#EAF0F6"
                                                FontSize="12"
                                                Foreground="#193458"
                                                FontWeight="SemiBold"
                                                BorderBrush="#D5DDE7"
                                                Cursor="Hand"
                                                SnapsToDevicePixels="True"
                                                Click="OnClick_SimpleButton">

                                <dxc:SimpleButton.Style>
                                    <Style TargetType="{x:Type Button}">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#193458"/>
                                                <Setter Property="BorderBrush" Value="#193458"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>

                                            <!-- 클릭 -->
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#122641"/>
                                                <Setter Property="BorderBrush" Value="#122641"/>
                                            </Trigger>

                                            <!-- 비활성화 -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#F3F5F7"/>
                                                <Setter Property="BorderBrush" Value="#E0E5EB"/>
                                                <Setter Property="Foreground" Value="#A0A9B5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </dxc:SimpleButton.Style>
                        </dxc:SimpleButton>
                    </Xpf:StyleGrid>
                </Xpf:BindItem>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="MUR_Email"
                                    Header="이 메 일"
                                    BindType="TextBox"
                                    Col="0"
                                    Row="3"/>

                    <Xpf:BindItem   FieldName="MUR_EmailDomain"
                                    BindType="ComboBox"
                                    Width="80"
                                    ItemsSource="{x:Static selection:InputOptionItems.EmailDomains}"
                                    DisplayMember="attrName"
                                    ValueMember="attrValue"/>

                    <Xpf:BindItem   FieldName="btnUpdateEmail"
                                    Width="100"
                                    IsBinding="False"
                                    IsBindClickEvent="True">

                        <Xpf:Button Content="이메일 변경"
                                    Background="#EAF0F6"
                                    FontSize="12"
                                    Foreground="#193458"
                                    FontWeight="SemiBold"
                                    BorderBrush="#D5DDE7"
                                    Cursor="Hand"
                                    SnapsToDevicePixels="True">

                            <Xpf:Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#193458"/>
                                            <Setter Property="BorderBrush" Value="#193458"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </Trigger>

                                        <!-- 클릭 -->
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#122641"/>
                                            <Setter Property="BorderBrush" Value="#122641"/>
                                        </Trigger>

                                        <!-- 비활성화 -->
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Background" Value="#F3F5F7"/>
                                            <Setter Property="BorderBrush" Value="#E0E5EB"/>
                                            <Setter Property="Foreground" Value="#A0A9B5"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Xpf:Button.Style>
                        </Xpf:Button>
                    </Xpf:BindItem>
                </x:Array>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="MUR_BirthYear"
                                    Header="생 년 월 일"
                                    BindType="TextBox"
                                    Col="0"
                                    Row="4"/>

                    <Xpf:BindItem   FieldName="MUR_CalendarType"
                                    BindType="ComboBox"
                                    Width="60"
                                    ItemsSource="{x:Static selection:InputOptionItems.CalendarTypes}"
                                    DisplayMember="attrName"
                                    ValueMember="attrValue"/>
                </x:Array>

                <Xpf:BindItem   FieldName="MUR_PhoneNum"
                                Header="전 화 번 호"
                                BindType="TextBox"
                                Col="0"
                                Row="5"
                                IsNumericOnly="True"/>
            </Xpf:BindGrid>
        </dxlc:GroupBox>

        <dxlc:GroupBox  Grid.Row="1"
                        MinHeight="135"
                        Header="근무정보"
                        FontWeight="Bold"
                        Padding="0"
                        ShowShadow="Never"
                        Margin="0,2,0,0">

            <Xpf:BindGrid   LayoutDefinitions="1,3"
                            BindStyle="DataCell"
                            HeaderForeground="#193458"
                            HeaderWidth="80"
                            ItemSpace="2">

                <Xpf:BindItem FieldName="MUR_Department"
                              Header="부 서"
                              BindType="ComboBox"
                              Col="0"
                              Row="0"
                              ItemsSource="{x:Static selection:InputOptionItems.Departments}"
                              DisplayMember="vMUR_Department"
                              ValueMember="MUR_Department"/>

                <Xpf:BindItem FieldName="MUR_JobCode"
                              Header="직 책"
                              BindType="ComboBox"
                              Col="0"
                              Row="1"
                              ItemsSource="{x:Static selection:InputOptionItems.JobCodes}"
                              DisplayMember="vMUR_JobCode"
                              ValueMember="MUR_JobCode"/>

                <Xpf:BindItem FieldName="MUR_LicenseNo"
                              Header="의료면허번호"
                              BindType="TextBox"
                              Col="0"
                              Row="2"/>
            </Xpf:BindGrid>
        </dxlc:GroupBox>

        <Xpf:StyleGrid  Grid.Row="2"
                        LayoutDefinitions="3,1"
                        ColumnSizeDefinitions="Auto,*,Auto"
                        Margin="0,5,0,0">

            <dxc:SimpleButton Grid.Column="0"
                              Content="초기화"
                              Glyph="/Images/smartemr_empty_paper_v2.png"
                              GlyphWidth="18"
                              GlyphHeight="18"
                              Padding="5,2"
                              Command="{Binding ClearDataCommand}"/>

            <dxc:SimpleButton Grid.Column="2"
                              Content="정보수정"
                              Glyph="/Images/smartemr_edit_paper.png"
                              GlyphWidth="18"
                              GlyphHeight="18"
                              Padding="5,2"
                              Command="{Binding SetMemberUserCommand}"/>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
