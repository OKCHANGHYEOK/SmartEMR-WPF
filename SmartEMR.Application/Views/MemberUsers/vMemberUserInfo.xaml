<base:ModelViewLayout   x:TypeArguments="vm:MemberUserInfoViewModel"
                        x:Class="SmartEMR.Application.Views.MemberUsers.vMemberUserInfo"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                        xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                        xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                        mc:Ignorable="d"
                        d:DesignHeight="600"
                        d:DesignWidth="800"
                        d:DataContext="{d:DesignInstance Type={x:Type vm:MemberUserInfoViewModel}}">

    <Xpf:StyleGrid  LayoutDefinitions="1,7"
                    RowSizeDefinitions="Auto,12,Auto,24,Auto,*,Auto"
                    Margin="10,8,10,6">

        <!-- 기본정보 -->
        <Xpf:StyleGrid Grid.Row="0"
                       LayoutDefinitions="1,3"
                       RowSizeDefinitions="Auto,12,Auto">

            <TextBlock Text="기본정보"
                       HorizontalAlignment="Left"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Text="회원의 기본 정보와 연락처를 관리합니다."
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Right"
                       Margin="0,4,0,0"/>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"/>
        </Xpf:StyleGrid>

        <!-- 기본정보 입력 -->
        <Xpf:StyleGrid Grid.Row="2"
                       LayoutDefinitions="3,11"
                       ColumnSizeDefinitions="90,*,90"
                       RowSizeDefinitions="38,8,38,8,38,8,38,8,38,8,38">

            <!-- 회원명 + 성별 -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="회원명"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:TextEdit Grid.Row="0" Grid.Column="1"
                          Grid.ColumnSpan="1"
                          Style="{StaticResource FormEditorStyle}"
                          EditValue="{Binding Model.MUR_Name, UpdateSourceTrigger=PropertyChanged}"/>

            <dxe:ComboBoxEdit Grid.Row="0" Grid.Column="2"
                              Margin="6,0,0,0"
                              Style="{StaticResource FormComboStyle}"
                              ItemsSource="{x:Static selection:InputOptionItems.Sexes}"
                              DisplayMember="vPAT_Sex"
                              ValueMember="PAT_Sex"
                              EditValue="{Binding Model.MUR_Gender, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- 아이디 -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="아이디"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:TextEdit Grid.Row="2" Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Style="{StaticResource FormEditorStyle}"
                          EditValue="{Binding Model.MUR_Id}"
                          IsReadOnly="True"
                          Background="{StaticResource ReadOnlyBackgroundBrush}"/>

            <!-- 비밀번호 -->
            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="비밀번호"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:StyleGrid  Grid.Row="4" 
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            LayoutDefinitions="3,1"
                            ColumnSizeDefinitions="*,8,112">
                
                <dxe:PasswordBoxEdit x:Name="pwMUR_Password"
                                     Grid.Column="0"
                                     Password="00000000"
                                     Height="34"
                                     FontSize="12"
                                     Padding="8,0"
                                     BorderBrush="{StaticResource EditorBorderBrush}"
                                     Background="{StaticResource ReadOnlyBackgroundBrush}"
                                     PasswordChar="*"
                                     ShowPasswordButtonVisibility="None"
                                     IsReadOnly="True"
                                     Focusable="False"/>

                <dxc:SimpleButton x:Name="btnChangedPassword"
                                  Grid.Column="2"
                                  Content="비밀번호 변경"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Click="OnClick_SimpleButton"/>
            </Xpf:StyleGrid>

            <!-- 이메일 -->
            <TextBlock Grid.Row="6" Grid.Column="0"
                       Text="이메일"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:StyleGrid  Grid.Row="6" 
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            LayoutDefinitions="3,1"
                            ColumnSizeDefinitions="*,8,112">

                <Xpf:TextEdit Grid.Column="0"
                              Style="{StaticResource FormEditorStyle}"
                              EditValue="{Binding Model.MUR_Email}"
                              IsReadOnly="True"
                              Background="{StaticResource ReadOnlyBackgroundBrush}"/>

                <dxc:SimpleButton Grid.Column="2"
                                  Content="이메일 변경"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Click="OnClick_SimpleButton"/>
            </Xpf:StyleGrid>

            <!-- 생년월일 + 달력 유형 -->
            <TextBlock Grid.Row="8" Grid.Column="0"
                       Text="생년월일"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:StyleGrid  Grid.Row="8" 
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            LayoutDefinitions="3,1"
                            ColumnSizeDefinitions="*,8,70">

                <Xpf:TextEdit Grid.Column="0"
                              Style="{StaticResource FormEditorStyle}"
                              MaxLength="8"
                              EditValue="{Binding Model.MUR_BirthDate, UpdateSourceTrigger=PropertyChanged}"
                              NullText="생년월일 8자리"/>

                <dxe:ComboBoxEdit Grid.Column="2"
                                  Style="{StaticResource FormComboStyle}"
                                  ItemsSource="{x:Static selection:InputOptionItems.CalendarTypes}"
                                  DisplayMember="attrName"
                                  ValueMember="attrValue"
                                  EditValue="{Binding Model.MUR_CalendarType}"/>
            </Xpf:StyleGrid>

            <!-- 전화번호 -->
            <TextBlock Grid.Row="10" Grid.Column="0"
                       Text="전화번호"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:TextEdit Grid.Row="10" Grid.Column="1"
                          Grid.ColumnSpan="2"
                          Style="{StaticResource FormEditorStyle}"
                          MaxLength="11"
                          EditValue="{Binding Model.MUR_PhoneNum, UpdateSourceTrigger=PropertyChanged}"
                          NullText="숫자만 입력해 주세요."/>
        </Xpf:StyleGrid>

        <!-- 근무정보 제목 -->
        <Xpf:StyleGrid Grid.Row="4"
                       LayoutDefinitions="1,3"
                       RowSizeDefinitions="Auto,12,1">

            <TextBlock Grid.Row="0"
                       Text="근무정보"
                       Style="{StaticResource SectionTitleStyle}"/>

            <TextBlock Grid.Row="0"
                       Text="부서와 직책, 의료면허 정보를 관리합니다."
                       FontSize="11"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"/>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource SeparatorBrush}"
                    BorderThickness="0,1,0,0"/>
        </Xpf:StyleGrid>

        <!-- 근무정보 입력 -->
        <Xpf:StyleGrid  Grid.Row="5"
                        LayoutDefinitions="2,5"
                        ColumnSizeDefinitions="90,*"
                        RowSizeDefinitions="38,10,38,10,38"
                        Margin="0,12,0,0"
                        VerticalAlignment="Top">

            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="부서"
                       Style="{StaticResource FieldLabelStyle}"/>

            <dxe:ComboBoxEdit Grid.Row="0" 
                              Grid.Column="1"
                              x:Name="cmbMUR_Department"
                              Style="{StaticResource FormComboStyle}"
                              ItemsSource="{x:Static selection:InputOptionItems.Departments}"
                              DisplayMember="vMUR_Department"
                              ValueMember="MUR_Department"
                              EditValue="{Binding Model.MUR_Department}"/>

            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="직책"
                       Style="{StaticResource FieldLabelStyle}"/>

            <dxe:ComboBoxEdit Grid.Row="2" 
                              Grid.Column="1"
                              x:Name="cmbMUR_JobCode"
                              Style="{StaticResource FormComboStyle}"
                              ItemsSource="{x:Static selection:InputOptionItems.JobCodes}"
                              DisplayMember="vMUR_JobCode"
                              ValueMember="MUR_JobCode"
                              EditValue="{Binding Model.MUR_JobCode}"/>

            <TextBlock Grid.Row="4" Grid.Column="0"
                       Text="의료면허번호"
                       Style="{StaticResource FieldLabelStyle}"/>

            <Xpf:TextEdit Grid.Row="4" 
                          Grid.Column="1"
                          x:Name="txtMUR_LicenseNo"
                          Style="{StaticResource FormEditorStyle}"
                          EditValue="{Binding Model.MUR_LicenseNo}"
                          NullText="의료인인 경우 입력해 주세요."/>

        </Xpf:StyleGrid>

        <!-- 하단 버튼 -->
        <Border Grid.Row="6"
                BorderBrush="{StaticResource SeparatorBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,10,0,0">

            <Xpf:StyleGrid  LayoutDefinitions="2,1"
                            ColumnSizeDefinitions="*,Auto">
                
                <dxc:SimpleButton Grid.Column="0"
                                  HorizontalAlignment="Left"
                                  Content="초기화"
                                  Glyph="/Images/smartemr_empty_paper_v2.png"
                                  GlyphWidth="16"
                                  GlyphHeight="16"
                                  Style="{StaticResource SecondaryButtonStyle}"
                                  Command="{Binding ClearDataCommand}"/>

                <dxc:SimpleButton Grid.Column="1"
                                  Content="정보 수정"
                                  Glyph="/Images/smartemr_edit_paper_v2.png"
                                  GlyphWidth="18"
                                  GlyphHeight="18"
                                  Style="{StaticResource PrimaryButtonStyle}"
                                  Command="{Binding SetMemberUserCommand}"/>
            </Xpf:StyleGrid>
        </Border>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
