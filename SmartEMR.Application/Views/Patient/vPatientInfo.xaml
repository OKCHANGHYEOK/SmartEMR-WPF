<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.vPatientInfo"
                        x:TypeArguments="vm:PatientInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">
    
    <Xpf:StyleGrid LayoutDefinitions="1,3"
                   RowSizeDefinitions="*,Auto,Auto"
                   Background="White">

        <Xpf:BindGrid   Grid.Row="0"
                        LayoutDefinitions="6,8"
                        BindStyle="DataCell"
                        HeaderWidth="70"
                        ItemSpace="1">

            <Xpf:BindItem   FieldName="PAT_ImageSource"
                            BindType="Image"
                            Col="0" 
                            Row="0"
                            ColSpan="2"
                            RowSpan="5"
                            IsHeader="False"
                            Margin="2"/>

            <Xpf:BindItem   FieldName="PAT_Name"
                            Header="성   명"
                            BindType="TextBox"
                            Col="2"
                            Row="0"
                            ColSpan="2"/>
            
            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="PAT_RegisterNum1"
                                BindType="TextBox"
                                Header="주 민 번 호"
                                Width="65"
                                Col="4"
                                Row="0"
                                ColSpan="2"/>
                <Xpf:BindItem   FieldName=""
                                IsHeader="False"
                                IsBinding="False">
                    <Label      Content="-"
                                FontSize="11"
                                Margin="0"
                                Width="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                </Xpf:BindItem>
                <Xpf:BindItem   FieldName="PAT_RegisterNum2"
                                BindType="TextBox"
                                Width="65"
                                IsHeader="False">
                </Xpf:BindItem>            
            </x:Array>
            
            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="PAT_PhoneNum"
                                BindType="TextBox"
                                Header="전 화 번 호"
                                Width="80"
                                Col="2"
                                Row="1"
                                ColSpan="2"/>
                
                <Xpf:BindItem   FieldName="btnSMS"
                                BindType="Button"
                                ButtonText="SMS"
                                BorderBrush="LightGray"
                                BorderThickness="1"
                                Height="28"
                                VAlignment="Center"
                                Margin="0,0,2,0"
                                IsHeader="False"
                                IsBinding="False">
                </Xpf:BindItem>
            </x:Array>

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="PAT_BirthDate"
                                BindType="ComboBox"
                                Header="생 년 월 일"
                                Col="4"
                                Row="1"
                                ColSpan="2"
                                ItemsSource="{Binding vm.arrPAT_BirthYear, RelativeSource={RelativeSource AncestorType={x:Type view:vPatientInfo}}}"
                                DisplayMember="attrName"
                                ValueMember="attrValue"/>
            </x:Array>
        </Xpf:BindGrid>

        <Border Grid.Row="1"
                BorderBrush="LightGray" 
                BorderThickness="0,0,0,1"/>

        <Xpf:StyleGrid  Grid.Row="2"
                        x:Name="ButtonPanel"
                        LayoutDefinitions="3,1"
                        ColumnSizeDefinitions="*,Auto,Auto"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">

            <Xpf:Button Grid.Column="1" 
                        Width="85"
                        Height="27"
                        Content="환자등록"
                        Glyph="/Images/smartemr_register.png"/>
            <Xpf:Button Grid.Column="2" 
                        Margin="2,0,2,0"
                        Width="85"
                        Height="27"
                        Content="환자삭제"
                        Glyph="/Images/smartemr_delete.png"/>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
