<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.vPatientInfo"
                        x:TypeArguments="vm:PatientInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">
    
    <Xpf:StyleGrid LayoutDefinitions="1,3"
                   RowSizeDefinitions="*,Auto,Auto"
                   Background="White">

        <Xpf:BindGrid   Grid.Row="0"
                        LayoutDefinitions="6,6"
                        BindStyle="DataCell"
                        HeaderWidth="70">

            <Xpf:BindItem   FieldName="PAT_ImageSource"
                            Col="0" 
                            Row="0"
                            ColSpan="2"
                            RowSpan="3"
                            BindType="Image"
                            IsHeader="False"
                            Margin="2"/>

            <Xpf:BindItem   FieldName="PAT_Name"
                            Col="2"
                            Row="0"
                            ColSpan="2"
                            Header="성   명"
                            BindType="TextBox"/>

            <Xpf:BindItem   FieldName="PAT_BirthDate"
                            Col="4"
                            Row="0"
                            ColSpan="2"
                            Header="생 년 월 일"
                            BindType="TextBox"/>

            <Xpf:BindItem   FieldName="PAT_PhoneNum"
                            Col="2"
                            Row="1"
                            ColSpan="2"
                            Header="전화번호">

                <StackPanel>
                    <Xpf:ComboBoxEdit></Xpf:ComboBoxEdit>
                </StackPanel>
            </Xpf:BindItem>
        </Xpf:BindGrid>

        <Border Grid.Row="1"
                BorderBrush="LightGray" 
                BorderThickness="0,0,0,1"/>

        <Xpf:StyleGrid  Grid.Row="2"
                        x:Name="ButtonPanel"
                        LayoutDefinitions="3,1"
                        ColumnSizeDefinitions="*,Auto,Auto"
                        VerticalAlignment="Center"
                        Margin="0,2,0,2">

            <Xpf:Button Grid.Column="1" 
                        Width="85"
                        Height="27"
                        Content="환자등록"
                        Glyph="/Images/smartemr_register.png"/>
            <Xpf:Button Grid.Column="2" 
                        Margin="2,0,2,0"
                        Width="85"
                        Height="27"
                        Content="환자삭제"
                        Glyph="/Images/smartemr_delete.png"/>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
