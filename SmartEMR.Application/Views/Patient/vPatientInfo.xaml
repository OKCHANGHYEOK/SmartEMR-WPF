<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.vPatientInfo"
                        x:TypeArguments="vm:PatientInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        xmlns:common="clr-namespace:SmartEMR.Application.Common"
                        mc:Ignorable="d" 
                        ViewSize="600,400">

    <dx:LayoutPanel ShowCaption="False">
        <Xpf:StyleGrid  LayoutDefinitions="1,3"
                        RowSizeDefinitions="*,Auto,Auto"
                        Background="White">

            <Xpf:BindGrid   Grid.Row="0"
                            LayoutDefinitions="8,9"
                            BindStyle="DataCell"
                            HeaderWidth="70"
                            ItemSpace="1">

                <Xpf:BindItem   FieldName="PAT_ImageSource"
                                Col="0" 
                                Row="0"
                                ColSpan="2"
                                RowSpan="5"
                                IsHeader="False"
                                Margin="2">

                    <Xpf:StyleGrid  LayoutDefinitions="1,2"
                                    RowSizeDefinitions="1*,Auto"
                                    Margin="2">

                        <Border Grid.Row="0"
                                BorderBrush="LightGray"
                                BorderThickness="1">

                            <Xpf:Image  HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Stretch="UniformToFill"
                                        Source="{Binding PATItem.PAT_ImageSource, RelativeSource={RelativeSource AncestorType={x:Type view:vPatientInfo}}}"/>
                        </Border>

                        <Xpf:StyleGrid  Grid.Row="1"
                                        LayoutDefinitions="2,1"
                                        ColumnSizeDefinitions="1*,Auto">

                            <Xpf:Button Grid.Column="0"
                                        x:Name="btnSelectImage"
                                        Content="이미지선택"
                                        CornerRadius="2"
                                        BorderBrush="LightGray"
                                        BorderThickness="1"
                                        Height="26"
                                        Margin="0,2,0,2"
                                        Click="OnClick_Button"/>

                            <Xpf:Button Grid.Column="1"
                                        x:Name="btnClearImage"
                                        CornerRadius="3"
                                        BorderBrush="Black"
                                        BorderThickness="1"
                                        MinWidth="24"
                                        Width="24"
                                        Height="24"
                                        Glyph="/Images/smartemr_clear.png"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        Margin="2"
                                        Click="OnClick_Button">
                            </Xpf:Button>
                        </Xpf:StyleGrid>
                    </Xpf:StyleGrid>
                </Xpf:BindItem>

                <Xpf:BindItem   FieldName="PAT_ChartNo"
                                Header="차 트 번 호"
                                BindType="TextBox"
                                Col="2"
                                Row="0"
                                ColSpan="3"
                                Placeholder="(자동생성)"
                                FontSize="11"/>

                <Xpf:BindItem   FieldName="PAT_Name"
                                Header="성   명"
                                BindType="TextBox"
                                Col="5"
                                Row="0"
                                ColSpan="3"
                                FontSize="11"/>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="PAT_RegisterNum1"
                                    BindType="TextBox"
                                    Header="주 민 번 호"
                                    Col="2"
                                    Row="1"
                                    ColSpan="3"
                                    FontSize="11"
                                    MaxLength="6"
                                    IsNumericOnly="True"/>

                    <Xpf:BindItem   FieldName="PAT_RegisterNum2"
                                    BindType="TextBox"
                                    FontSize="11"
                                    MaxLength="7"
                                    IsHeader="False"
                                    IsNumericOnly="True">
                    </Xpf:BindItem>
                </x:Array>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="PAT_BirthDate"
                                    BindType="TextBox"
                                    Header="생 년 월 일"
                                    Col="5"
                                    Row="1"
                                    ColSpan="3"
                                    FontSize="11"
                                    MaxLength="8"
                                    IsNumericOnly="True"/>

                    <Xpf:BindItem   FieldName="PAT_IsSolar"
                                    BindType="ComboBox"
                                    Width="48"
                                    Margin="2"
                                    DisplayMember="attrName"
                                    ValueMember="attrValue"
                                    IsHeader="False"/>
                </x:Array>

                <Xpf:BindItem   FieldName="PAT_Sex"
                                BindType="ComboBox"
                                Header="성   별"
                                DisplayMember="vPAT_Sex"
                                ValueMember="PAT_Sex"
                                Col="2"
                                Row="2"
                                ColSpan="3"/>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="PAT_PhoneNum"
                                    BindType="TextBox"
                                    Header="전 화 번 호"
                                    Col="5"
                                    Row="2"
                                    ColSpan="3"
                                    FontSize="11"
                                    MaxLength="11"
                                    IsNumericOnly="True"/>
                    <Xpf:BindItem   FieldName="btnSMS"
                                    BindType="Button"
                                    TextValue="SMS"
                                    FontSize="11"
                                    BorderBrush="LightGray"
                                    BorderThickness="1"
                                    Width="48" 
                                    Margin="2"
                                    IsHeader="False"
                                    IsBinding="False"
                                    IsBindClickEvent="True"/>
                </x:Array>

                <Xpf:BindItem   FieldName="PAT_SourceType"
                                BindType="ComboBox"
                                Header="내 원 경 로"
                                DisplayMember="CCC_Name"
                                ValueMember="CCC_Cd"
                                Col="2"
                                Row="3"
                                ColSpan="3"/>

                <Xpf:BindItem   FieldName="PAT_IsForegin"
                                BindType="ComboBox"
                                Header="내국인구분"
                                Col="5"
                                Row="3"
                                ColSpan="3"
                                DisplayMember="attrName"
                                ValueMember="attrValue">
                    
                </Xpf:BindItem>

                <Xpf:BindItem   FieldName="PAT_Email"
                                BindType="TextBox"
                                Header="이 메 일"
                                Col="2"
                                Row="4"
                                ColSpan="3"
                                FontSize="11"/>

                <x:Array Type="{x:Type Xpf:BindItem}">
                    <Xpf:BindItem   FieldName="PAT_IsAgreePersonalInfo"
                                    BindType="CheckBox"
                                    TextValue="개인정보제공동의"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Col="5"
                                    Row="4"
                                    ColSpan="3"
                                    IsHeader="False"
                                    IsApplyYNToBoolean="True"/>

                    <Xpf:BindItem   FieldName="PAT_IsSMS"
                                    BindType="CheckBox"
                                    TextValue="문자수신동의"
                                    FontSize="11"
                                    FontWeight="SemiBold"   
                                    IsHeader="False"
                                    IsApplyYNToBoolean="True"/>
                </x:Array>

                <Xpf:BindItem   FieldName="PAT_Address"
                                Header="주   소"
                                Width="50"
                                TextValue="검색"
                                FontSize="11"
                                Col="0"
                                Row="5"
                                ColSpan="8"
                                RowSpan="2">

                    <Xpf:StyleGrid  LayoutDefinitions="3,2"
                                    ColumnSizeDefinitions="1*,Auto,Auto">

                        <Xpf:StyleTextBox   x:Name="txtPAT_Address1"
                                            Grid.Column="0"
                                            Grid.Row="0"
                                            TextBoxType="Text"
                                            Placeholder="도로명주소 입력"
                                            FontSize="11"
                                            BorderBrush="LightGray"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Margin="1"/>
                        <Xpf:StyleTextBox   x:Name="txtPAT_Address2"
                                            Grid.Column="1"
                                            Grid.Row="0"
                                            TextBoxType="Text"
                                            Placeholder="우편번호"
                                            FontSize="11"
                                            Width="100"
                                            BorderBrush="LightGray"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Margin="1"/>

                        <Xpf:StyleTextBox   x:Name="txtPAT_Address3"
                                            Grid.Column="0"
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            TextBoxType="Text"
                                            Placeholder="상세주소 입력"
                                            FontSize="11"
                                            BorderBrush="LightGray"
                                            BorderThickness="1"
                                            CornerRadius="0"
                                            Margin="1"/>

                        <Xpf:Button x:Name="btnFindAddress"
                                    Grid.Column="2"
                                    Grid.Row="0"
                                    Grid.RowSpan="2"
                                    Content="주소검색"
                                    Background="#F1F3F5"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Glyph="/Images/smartemr_find_address.png"
                                    Width="80"
                                    Margin="2"
                                    Click="OnClick_Button"/>
                    </Xpf:StyleGrid>
                </Xpf:BindItem>

                <Xpf:BindItem   FieldName="PAT_Bigo"
                                BindType="TextBox"
                                Header="비   고"
                                Col="0"
                                Row="7"
                                ColSpan="8"
                                RowSpan="2"
                                ContentAlignment="LeftTop"
                                IsBottomLine="False"/>
            </Xpf:BindGrid>

            <Border Grid.Row="1"
                    BorderBrush="LightGray" 
                    BorderThickness="0,0,0,1"/>

            <Xpf:StyleGrid  Grid.Row="2"
                            x:Name="ButtonPanel"
                            LayoutDefinitions="3,1"
                            ColumnSizeDefinitions="Auto,*,Auto"
                            VerticalAlignment="Center"
                            Margin="0,2,0,2">

                <Xpf:Button x:Name="btnDelete"
                            Grid.Column="0" 
                            Width="85"
                            Height="27"
                            Content="환자삭제"
                            FontWeight="SemiBold"
                            Glyph="/Images/smartemr_delete_v2.png"
                            VerticalContentAlignment="Center"
                            Margin="2,0,0,0"
                            Command="{Binding SavePatientCommand}"
                            CommandParameter="DELETE"
                            IsEnabled="{Binding PATItem.PAT_Idx, RelativeSource={RelativeSource AncestorType={x:Type view:vPatientInfo}},Converter={common:IntToBooleanConverter invert=True}}">

                    <Xpf:Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFF0F2" Offset="1"/>
                        </LinearGradientBrush>
                    </Xpf:Button.Background>
                </Xpf:Button>

                <Xpf:Button x:Name="btnSave"
                            Grid.Column="2" 
                            Width="85"
                            Height="27"
                            FontWeight="SemiBold"
                            Glyph="/Images/smartemr_save.png"
                            VerticalContentAlignment="Center"
                            Margin="0,0,2,0"
                            Command="{Binding SavePatientCommand}"
                            CommandParameter="{Binding PATItem.PAT_Idx, RelativeSource={RelativeSource AncestorType={x:Type view:vPatientInfo}},Converter={converter:IntToOperaionTypeConverter}}">

                    <Xpf:Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFF0F2" Offset="1"/>
                        </LinearGradientBrush>
                    </Xpf:Button.Background>
                </Xpf:Button>
            </Xpf:StyleGrid>
        </Xpf:StyleGrid>
    </dx:LayoutPanel>
</base:ModelViewLayout>