<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRCSTInfoGrid"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRCST"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                    xmlns:common="clr-namespace:SmartEMR.Application.Common"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                    xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*"
                    Background="#F3F6FA"
                    dxc:ThemeManager.ThemeName="VS2019Blue">

        <Xpf:StyleGrid  Grid.Row="0"
                        LayoutDefinitions="20,1"
                        ColumnSizeDefinitions="*,*,*,*,*,*,*,Auto,*,*,*,*,*,*,*,*,*,*,*"
                        Height="25"
                        Margin="2">

            <dxc:SimpleButton   Grid.Column="0"
                                Grid.ColumnSpan="3"
                                Content="{Binding Model.vCST_InsuranceType, TargetNullValue='비보험'}"
                                Glyph="/Images/smartemr_insurance.png"
                                FontWeight="Bold"
                                Padding="2"
                                Margin="2,0,2,0"
                                dxc:ThemeManager.ThemeName="Office2013LightGray"/>

            <Xpf:DateEdit   Grid.Column="3"
                            Grid.ColumnSpan="3"
                            EditValue="{Binding Model.CST_YYMMDD}"
                            FontWeight="Bold"
                            DisplayFormatString="yyyy년 MM월 dd일 dddd"
                            Margin="2,0,2,0"
                            ShowClearButton="False"
                            ShowToday="False"/>


            <Xpf:DateEdit   Grid.Column="6"
                            EditValue="{Binding Model.CST_StartTime}"
                            MaskType="TimeOnly"
                            Mask="HH:mm"
                            MaskUseAsDisplayFormat="True"
                            Margin="2,0,2,0">

                <Xpf:DateEdit.StyleSettings>
                    <dxe:DateEditTimePickerStyleSettings/>
                </Xpf:DateEdit.StyleSettings>
            </Xpf:DateEdit>

            <Xpf:Label Grid.Column="7"  Content="~" FontSize="10" Foreground="DimGray" Margin="1,0,1,0"/>

            <Xpf:DateEdit   Grid.Column="8"
                            EditValue="{Binding Model.CST_EndTime}"
                            MaskType="TimeOnly"
                            Mask="HH:mm"
                            MaskUseAsDisplayFormat="True"
                            Margin="2,0,2,0">

                <Xpf:DateEdit.StyleSettings>
                    <dxe:DateEditTimePickerStyleSettings/>
                </Xpf:DateEdit.StyleSettings>
            </Xpf:DateEdit>
            
            <Xpf:ComboBoxEdit   Grid.Column="9"
                                EditValue="{Binding Model.CST_VisitType}"
                                ItemsSource="{x:Static selection:InputOptionItems.ConsultationVisitTypes}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="10"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding Model.CST_Status}"
                                ItemsSource="{x:Static selection:InputOptionItems.ConsultationStatuses}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="12"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding Model.MUR_Idx_DOC}"
                                ItemsSource="{x:Static selection:InputOptionItems.Docters}"
                                DisplayMember="MUR_Name"
                                ValueMember="MUR_Idx"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="14"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding Model.CST_Subject}"
                                ItemsSource="{x:Static selection:InputOptionItems.ConsultationSubjects}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="16"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding Model.CST_TreatResult}"
                                ItemsSource="{x:Static selection:InputOptionItems.TreatResultTypes}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <dxc:SimpleButton   Grid.Column="18"
                                Content="저장하기"
                                Glyph="/Images/smartemr_save.png"
                                GlyphWidth="18"
                                GlyphHeight="18"
                                GlyphToContentOffset="3"
                                HorizontalContentAlignment="Stretch"
                                FontSize="11"
                                FontWeight="SemiBold"
                                dxc:ThemeManager.ThemeName="Office2016Colorful"
                                Padding="2"
                                Margin="2,0,2,0"/>
            
            <dxc:SimpleButton   Grid.Column="19"
                                Content="초기화"
                                Glyph="/Images/smartemr_empty_paper.png"
                                GlyphWidth="18"
                                GlyphHeight="18"
                                GlyphToContentOffset="5"
                                HorizontalContentAlignment="Stretch"
                                FontSize="11"
                                FontWeight="SemiBold"
                                dxc:ThemeManager.ThemeName="Office2016Colorful"
                                Padding="2"
                                Margin="2,0,2,0"/>
        </Xpf:StyleGrid>

        <Border Grid.Row="1"  BorderBrush="#DDE2E8" BorderThickness="0,0,0,1" Margin="2"/>

        <Xpf:RichTextEdit Grid.Row="2"></Xpf:RichTextEdit>
    </Xpf:StyleGrid>
</Xpf:CustomControl>
