<Xpf:CustomControl x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRCSTInfoGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRCST"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:BindGrid   LayoutDefinitions="5,9"
                    BindStyle="DataCell"
                    Background="#F3F6FA"
                    HeaderWidth="70"
                    HeaderBackground="#E3EDF7">

        <Xpf:BindItem   FieldName="CST_YYMMDD"
                        Header="진 료 일 자"
                        BindType="DateEdit"
                        Col="0"
                        Row="0"
                        RowSpan="2"
                        DisplayFormatString="yyyy년 MM월 dd일 dddd"/>

        <Xpf:BindItem   FieldName="CST_InsuranceType"
                        Header="보 험 구 분"
                        BindType="ComboBox"
                        Col="1"
                        Row="0"
                        RowSpan="2"
                        ItemsSource="{x:Static selection:InputOptionItems.InsuranceTypes}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                        Header="담   당   의"
                        BindType="ComboBox"
                        Col="2"
                        Row="0"
                        RowSpan="2"
                        ItemsSource="{x:Static selection:InputOptionItems.Docters}"
                        DisplayMember="MUR_Name"
                        ValueMember="MUR_Idx"/>


        <Xpf:BindItem   FieldName="CST_Status"
                        Header="진 료 상 태"
                        BindType="ComboBox"
                        Col="3"
                        Row="0"
                        RowSpan="2"
                        ItemsSource="{x:Static selection:InputOptionItems.ConsultationStatuses}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="CST_TreatResult"
                        Header="치 료 상 태"
                        BindType="ComboBox"
                        Col="4"
                        Row="0"
                        RowSpan="2"
                        ItemsSource="{x:Static selection:InputOptionItems.TreatResultTypes}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="CST_Memo"
                        Header="진 료 메 모"
                        BindType="Label"
                        Col="0"
                        ColSpan="5"
                        Row="2"
                        RowSpan="3"/>

        <Xpf:BindItem   FieldName="CST_Opinion"
                        Header="진 료 소 견"
                        BindType="TextBox"
                        Col="0"
                        ColSpan="5"
                        Row="5"
                        RowSpan="4"/>
    </Xpf:BindGrid>
</Xpf:CustomControl>
