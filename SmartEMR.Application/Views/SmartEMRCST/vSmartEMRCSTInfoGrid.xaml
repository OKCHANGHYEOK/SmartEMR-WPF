<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRCSTInfoGrid"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRCST"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                    xmlns:common="clr-namespace:SmartEMR.Application.Common"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                    xmlns:dxre="http://schemas.devexpress.com/winfx/2008/xaml/richedit"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800"
                    x:Name="root">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*"
                    Background="#F3F6FA"
                    dxc:ThemeManager.ThemeName="VS2019Blue"
                    DataContext="{Binding SelectedCST, ElementName=root}">

        <Xpf:StyleGrid  Grid.Row="0"
                        LayoutDefinitions="20,3"
                        ColumnSizeDefinitions="*,*,*,*,*,*,*,Auto,*,*,*,*,*,*,*,*,*,*,*,*"
                        RowSizeDefinitions="*,Auto,*"
                        Height="50"
                        Margin="2">

            <dxc:SimpleButton   Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Tag="btnMoveIRCInfo"
                                Content="{Binding vCST_InsuranceType, TargetNullValue='비보험'}"
                                Glyph="/Images/smartemr_insurance.png"
                                FontWeight="Bold"
                                Padding="2"
                                Margin="2,0,2,0"
                                dxc:ThemeManager.ThemeName="Office2013LightGray"
                                Click="OnClick_SimpleButton"/>

            <Xpf:DateEdit   Grid.Column="2"
                            Grid.ColumnSpan="3"
                            EditValue="{Binding CST_YYMMDD}"
                            FontWeight="Bold"
                            DisplayFormatString="yyyy년 MM월 dd일 dddd"
                            Margin="2,0,2,0"
                            ShowClearButton="False"
                            ShowToday="False"/>


            <Xpf:DateEdit   Grid.Column="5"
                            Grid.ColumnSpan="2"
                            EditValue="{Binding CST_StartTime}"
                            MaskType="TimeOnly"
                            Mask="HH:mm"
                            MaskUseAsDisplayFormat="True"
                            Margin="2,0,2,0">

                <Xpf:DateEdit.StyleSettings>
                    <dxe:DateEditTimePickerStyleSettings/>
                </Xpf:DateEdit.StyleSettings>
            </Xpf:DateEdit>

            <Xpf:Label Grid.Column="7"  Content="~" FontSize="10" Foreground="DimGray" Margin="1,0,1,0"/>

            <Xpf:DateEdit   Grid.Column="8"
                            Grid.ColumnSpan="2"
                            EditValue="{Binding CST_EndTime}"
                            MaskType="TimeOnly"
                            Mask="HH:mm"
                            MaskUseAsDisplayFormat="True"
                            Margin="2,0,2,0">

                <Xpf:DateEdit.StyleSettings>
                    <dxe:DateEditTimePickerStyleSettings/>
                </Xpf:DateEdit.StyleSettings>
            </Xpf:DateEdit>
            
            <Xpf:ComboBoxEdit   Grid.Column="10"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding CST_VisitType}"
                                ItemsSource="{x:Static selection:InputOptionItems.ConsultationVisitTypes}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="12"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding CST_Status}"
                                ItemsSource="{x:Static selection:InputOptionItems.ConsultationStatuses}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="14"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding MUR_Idx_DOC}"
                                ItemsSource="{x:Static selection:InputOptionItems.Docters}"
                                DisplayMember="MUR_Name"
                                ValueMember="MUR_Idx"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="16"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding CST_Subject}"
                                ItemsSource="{x:Static selection:InputOptionItems.ConsultationSubjects}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Xpf:ComboBoxEdit   Grid.Column="18"
                                Grid.ColumnSpan="2"
                                EditValue="{Binding CST_TreatResult}"
                                ItemsSource="{x:Static selection:InputOptionItems.TreatResultTypes}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                HorizontalAlignment="Stretch"
                                Margin="2,0,2,0"/>

            <Border Background="#E4EBF3" Height="1" Grid.Column="0" Grid.ColumnSpan="19" Grid.Row="1" Margin="2"></Border>

            <Xpf:StyleGrid   Grid.Column="0"
                             Grid.ColumnSpan="20"
                             Grid.Row="2"
                             LayoutDefinitions="3,1"
                             ColumnSizeDefinitions="Auto,*,Auto">

                <dxc:SimpleButton   Tag="btnGetRecentCST"
                                    Grid.Column="0"
                                    Content="최근 진료 불러오기"
                                    Glyph="/Images/smartemr_recent_data.png"
                                    GlyphWidth="18"
                                    GlyphHeight="18"
                                    GlyphToContentOffset="3"
                                    GlyphAlignment="Left"
                                    HorizontalContentAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                    Margin="2,0,2,0"
                                    Cursor="Hand"
                                    Click="OnClick_SimpleButton"/>

                <dxc:SimpleButton   Grid.Column="2"
                                    Tag="btnClear"
                                    Content="초기화"
                                    Glyph="/Images/smartemr_empty_paper.png"
                                    GlyphWidth="18"
                                    GlyphHeight="18"
                                    GlyphAlignment="Left"
                                    GlyphToContentOffset="5"
                                    HorizontalContentAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                    Margin="2,0,2,0"
                                    Cursor="Hand"
                                    Click="OnClick_SimpleButton">

                    <dxc:SimpleButton.CommandParameter>
                        <sys:Boolean>
                            False
                        </sys:Boolean>
                    </dxc:SimpleButton.CommandParameter>
                </dxc:SimpleButton>
            </Xpf:StyleGrid>
        </Xpf:StyleGrid>

        <Border Grid.Row="1"  BorderBrush="#DDE2E8" BorderThickness="0,0,0,1" Margin="2"/>

        <Xpf:RichTextEdit Grid.Row="2"/>
    </Xpf:StyleGrid>
</Xpf:CustomControl>
