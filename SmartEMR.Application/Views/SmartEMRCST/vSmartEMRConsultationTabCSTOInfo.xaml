<base:ModelViewLayout x:TypeArguments="vm:ConsultationOrderViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRConsultationTabCSTOInfo"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRCST"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:template="clr-namespace:SmartEMR.Application.Template"
                      xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid LayoutDefinitions="1,3"
                   RowSizeDefinitions="Auto,Auto,*"
                   Background="#F8F9FA">
        
        <Xpf:StyleGrid LayoutDefinitions="3,1"
                       ColumnSizeDefinitions="Auto,*,Auto">

            <dxc:SimpleButton   Grid.Column="0"
                                x:Name="btnGetRecentCSTO"
                                Content="최근 처방 불러오기"
                                Glyph="/Images/smartemr_recent_data.png"
                                GlyphWidth="18"
                                GlyphHeight="18"
                                GlyphToContentOffset="3"
                                GlyphAlignment="Left"
                                HorizontalContentAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                dxc:ThemeManager.ThemeName="Office2016Colorful"
                                Margin="2"
                                Cursor="Hand"/>

            <dxc:SimpleButton   Grid.Column="2"
                                x:Name="btnClearCSTO"
                                Content="초기화"
                                Glyph="/Images/smartemr_empty_paper.png"
                                GlyphWidth="18"
                                GlyphHeight="18"
                                GlyphToContentOffset="3"
                                GlyphAlignment="Left"
                                HorizontalContentAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="2"
                                Command="{Binding ResetCSTOCommand}"
                                dxc:ThemeManager.ThemeName="Office2016Colorful"
                                Cursor="Hand"/>
        </Xpf:StyleGrid>

        <Border Grid.Row="1"  Height="1" Background="LightGray" Margin="2,0,2,0"/>

        <Xpf:DataGrid Grid.Row="2"
                      ItemsSource="{Binding ConsultationOrderItems}">
            <Xpf:ColumnItem FieldName="CSTO_InsuranceType"
                            Header=" "
                            ColumnWidth="20"
                            CellTemplateType="{x:Type template:CSTOInsuranceTypeTemplate}"/>

            <Xpf:ColumnItem FieldName="ORDC_Cd"
                            Header=" "
                            ColumnWidth="48"
                            CellTemplateType="{x:Type template:OrderTypeTemplate}"/>

            <Xpf:ColumnItem FieldName="CSTO_SugaCode"
                            Header="코드"
                            ColumnWidth="65"
                            ColumnStyle="Code"
                            Foreground="DimGray"/>

            <Xpf:ColumnItem FieldName="CSTO_Price"
                            Header="단가"
                            ColumnWidth="50"
                            ColumnStyle="Sum"
                            Foreground="DarkSlateGray"
                            DisplayFormat="#,##0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="CSTO_Name"
                            Header="오더명"
                            ColumnWidth="240"
                            ColumnStyle="Name"/>

            <Xpf:ColumnItem FieldName="CSTO_Day"
                            Header="일수"
                            ColumnType="TextEdit"
                            ColumnWidth="45"/>

            <Xpf:ColumnItem FieldName="CSTO_Count"
                            Header="일투"
                            ColumnType="TextEdit"
                            ColumnWidth="45"/>

            <Xpf:ColumnItem FieldName="CSTO_Amount"
                            Header="총투"
                            ColumnType="TextEdit"
                            ColumnWidth="45"
                            IsReadOnly="True"/>

            <Xpf:ColumnItem FieldName="CSTO_TotalPrice"
                            Header="총액"
                            ColumnType="TextEdit"
                            ColumnWidth="50"
                            IsReadOnly="True"/>

            <Xpf:ColumnItem FieldName="MUR_Idx_DOC"
                            Header="처방의"
                            ColumnType="ComboBox"
                            ColumnWidth="60"
                            ItemsSource="{x:Static selection:InputOptionItems.Docters}"
                            DisplayMember="MUR_Name"
                            ValueMember="MUR_Idx"/>

            <Xpf:ColumnItem FieldName="btnDelete"
                            Header=" "
                            ColumnWidth="24"
                            CellTemplateType="{x:Type local:btnDeleteCSTOTemplate}"/>
        </Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>