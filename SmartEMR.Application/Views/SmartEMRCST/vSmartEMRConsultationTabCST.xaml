<base:ModelViewLayout x:TypeArguments="vm:ConsultationViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRConsultationTabCST"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:sys="clr-namespace:System;assembly=mscorlib"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      xmlns:template="clr-namespace:SmartEMR.Application.Template"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*">

        <Xpf:StyleGrid  Grid.Column="0"
                        Grid.Row="0"
                        LayoutDefinitions="2,1"
                        ColumnSizeDefinitions="*,Auto"
                        Background="#EAF2F8">
            
            <Xpf:BindGrid   Grid.Column="0"
                            LayoutDefinitions="9,1"
                            MinHeight="27"
                            Height="27"
                            Margin="2"
                            ItemSpace="2">

                <Xpf:BindItem   FieldName="CST_YYMMDD"
                                BindType="DateEdit"
                                Col="0"
                                ColSpan="3"
                                FontWeight="Bold"
                                DisplayFormatString="yyyy년 MM월 dd일"/>

                <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                                BindType="ComboBox"
                                Col="3"
                                ColSpan="2"
                                ItemsSource="{x:Static selection:SearchFilterItems.Docters}"
                                DisplayMember="MUR_Name"
                                ValueMember="MUR_Idx"/>

                <Xpf:BindItem   FieldName="CST_Status"
                                BindType="ComboBox"
                                Col="5"
                                ColSpan="2"
                                ItemsSource="{x:Static selection:SearchFilterItems.ConsultationStatues}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"/>

                <Xpf:BindItem   FieldName="CST_InsuranceType"
                                BindType="ComboBox"
                                Col="7"
                                ColSpan="2"
                                ItemsSource="{x:Static selection:SearchFilterItems.InsuranceTypes}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"/>
            </Xpf:BindGrid>

            <dxc:SimpleButton Grid.Column="1"
                              Width="24"
                              Height="24"
                              Glyph="/Images/smartemr_reset.png"
                              GlyphWidth="16"
                              GlyphHeight="16"
                              Cursor="Hand"
                              Padding="2"
                              Margin="1,0,1,0"
                              Command="{Binding ClearDataCommand}">
                <dxc:SimpleButton.CommandParameter>
                    <sys:Boolean>True</sys:Boolean>
                </dxc:SimpleButton.CommandParameter>
            </dxc:SimpleButton>
        </Xpf:StyleGrid>

        <Border Grid.Column="0"  
                Grid.Row="1"  
                BorderBrush="#DDE2E8" 
                BorderThickness="0,0,0,1" 
                Margin="2"/>

        <Xpf:DataGrid   Grid.Column="0"
                        Grid.Row="2"
                        ItemsSource="{Binding Consultations}">
            
            <Xpf:ColumnItem FieldName="IRC_Type"
                            Header=" "
                            CellTemplateType="{x:Type template:InsuranceTypeTemplate}"
                            ColumnWidth="24"/>

            <Xpf:ColumnItem FieldName="CST_Status"
                            Header="상태"
                            CellTemplateType="{x:Type template:CSTStatusTemplate}"
                            ColumnWidth="45"/>

            <Xpf:ColumnItem FieldName="PAT_ChartNo"
                            Header="차트번호"
                            ColumnType="Label"
                            ColumnWidth="80"
                            ColumnStyle="Name"/>

            <Xpf:ColumnItem FieldName="PAT_Name"
                            Header="환자명"
                            ColumnType="TextLink"
                            ColumnWidth="100"
                            ColumnStyle="Name"
                            FontWeight="Bold"/>

            <Xpf:ColumnItem FieldName="vPAT_Info"
                            Header=" "
                            ColumnType="Label"
                            ColumnWidth="60"
                            HorizontalAlignment="Center"/>

            <Xpf:ColumnItem FieldName="vCST_SubjectName"
                            Header="진료과목"
                            ColumnType="Label"
                            ColumnWidth="100"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"/>

            <Xpf:ColumnItem FieldName="MUR_Name_DOC"
                            Header="담당의"
                            ColumnType="Label"
                            ColumnWidth="80"
                            HorizontalAlignment="Center"/>

        </Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>