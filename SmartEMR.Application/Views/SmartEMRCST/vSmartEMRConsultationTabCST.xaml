<base:ModelViewLayout x:TypeArguments="vm:ConsultationViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRConsultationTabCST"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Background="#EAF2F8"
                    Margin="2,0,2,0">

            <Xpf:DateEdit   EditValue="{Binding Model.CST_YYMMDD}"
                            Width="130"
                            FontWeight="Bold"
                            Mask="yyyy년 MM월 dd일"
                            MaskUseAsDisplayFormat="True"/>

            <Xpf:ComboBoxEdit   EditValue="{Binding Model.MUR_Idx_DOC}"
                                Width="90"
                                ItemsSource="{x:Static selection:SearchFilterItems.Docters}"
                                DisplayMember="MUR_Name"
                                ValueMember="MUR_Idx"
                                Margin="2,0,0,0"/>

            <Xpf:ComboBoxEdit   EditValue="{Binding Model.CST_Status}"
                                Width="90"
                                ItemsSource="{x:Static selection:SearchFilterItems.ConsultationStatues}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                Margin="2,0,0,0"/>
            
            <Xpf:ComboBoxEdit   EditValue="{Binding Model.CST_PayStatus}"
                                Width="90"
                                ItemsSource="{x:Static selection:SearchFilterItems.PayStatuses}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                Margin="2,0,0,0"/>


            <Xpf:ComboBoxEdit   EditValue="{Binding Model.CST_InsuranceType}"
                                Width="90"
                                ItemsSource="{x:Static selection:SearchFilterItems.InsuranceTypes}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                Margin="2,0,0,0"/>

        </StackPanel>

        <Border Grid.Row="1"  BorderBrush="#DDE2E8" BorderThickness="0,0,0,1" Margin="2"/>

        <Xpf:DataGrid Grid.Row="2"></Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>