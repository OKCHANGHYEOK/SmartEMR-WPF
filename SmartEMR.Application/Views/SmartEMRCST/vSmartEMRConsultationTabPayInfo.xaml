<base:ModelViewLayout x:TypeArguments="vm:PayInfoViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRConsultationTabPayInfo"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800"
                      d:DataContext="{d:DesignInstance Type=vm:PayInfoViewModel}">

    <Xpf:StyleGrid LayoutDefinitions="2,2">
        <Xpf:StyleGrid Grid.Column="0"
                       LayoutDefinitions="2,1"
                       ColumnSizeDefinitions="70,*">

            <Xpf:Label Grid.Column="0" Background="#E8EEF5" Foreground="#344454" Content="급여진료비"/>
            <Xpf:Label Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#F8FAFC">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Xpf:TextBlock HorizontalAlignment="Center">
                        <Run Text="{Binding Model.PAY_InsuredPrice, TargetNullValue=0}" FontWeight="Bold"/>
                        <Run>원</Run>
                        <Run>  </Run>
                        <Run Foreground="#356A8A">(</Run>
                        <Run Foreground="#356A8A">본인부담금 : </Run>
                        <Run Text="{Binding Model.PAY_OwnPatientPrice, TargetNullValue=0}"/>
                        <Run Foreground="#356A8A">원</Run>
                        <Run Foreground="#356A8A">)</Run>
                    </Xpf:TextBlock>
                </StackPanel>
            </Xpf:Label>
        </Xpf:StyleGrid>

        <Xpf:StyleGrid Grid.Column="1"
                       LayoutDefinitions="2,1"
                       ColumnSizeDefinitions="70,*">

            <Xpf:Label Grid.Column="0" Background="#E8EEF5" Foreground="#344454" Content="비급여진료비"/>
            <Xpf:Label Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#F8FAFC">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Xpf:TextBlock HorizontalAlignment="Center">
                        <Run Text="{Binding Model.PAY_NonInsurecPrice, TargetNullValue=0}" FontWeight="Bold"/>
                        <Run>원</Run>
                    </Xpf:TextBlock>
                </StackPanel>
            </Xpf:Label>
        </Xpf:StyleGrid>

        <Xpf:StyleGrid Grid.Column="0"
                       Grid.Row="1"
                       LayoutDefinitions="2,1"
                       ColumnSizeDefinitions="70,*">

            <Xpf:Label Grid.Column="0" Background="#E8EEF5" Foreground="#344454" Content="총진료비"/>
            <Xpf:Label Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="#F8FAFC">
                <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <Xpf:TextBlock HorizontalAlignment="Center">
                        <Run Text="{Binding Model.PAY_TotalPrice, TargetNullValue=0}" FontWeight="Bold"/>
                        <Run>원</Run>
                    </Xpf:TextBlock>
                </StackPanel>
            </Xpf:Label>
        </Xpf:StyleGrid>

        <Xpf:StyleGrid Grid.Column="1"
                       Grid.Row="1"
                       LayoutDefinitions="2,1"
                       ColumnSizeDefinitions="70,*">

            <Xpf:Label Grid.Column="0" Background="#E8EEF5" Foreground="#344454" Content="수납금액"/>
            <Xpf:StyleGrid Grid.Column="1" 
                           LayoutDefinitions="1,3"
                           RowSizeDefinitions="*,Auto,*"
                           Background="#F8FAFC">

                <Xpf:TextBlock Grid.Row="0" HorizontalAlignment="Center">
                    <Run>수납 : </Run>
                    <Run Text="{Binding Model.PAY_PaidPrice, TargetNullValue=0}" Foreground="#263746" FontWeight="Bold"/>
                    <Run>원</Run>
                </Xpf:TextBlock>

                <Border Grid.Row="1" Height="1" Background="#CBD5E1" Margin="2"/>

                <Xpf:TextBlock Grid.Row="2" HorizontalAlignment="Center">
                    <Run>미수납 :</Run>
                    <Run Text="{Binding Model.PAY_RemainPrice, TargetNullValue=0}" Foreground="#263746" FontWeight="Bold"/>
                    <Run>원</Run>
                </Xpf:TextBlock>
            </Xpf:StyleGrid>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>