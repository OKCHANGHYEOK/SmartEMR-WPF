<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.SmartEMRCST.OrderSectionTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRCST"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800"
                    x:Name="root"
                    Margin="2">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*">

        <Xpf:Label  Grid.Row="0" Content="{Binding Title, ElementName=root}" Foreground="DimGray" FontWeight="Bold" FontSize="12" Margin="4" HorizontalAlignment="Left"/>
        <Border Grid.Row="1" Height="1" Background="#CBD5E1" Margin="0,1,0,1"/>

        <ItemsControl   Grid.Row="2"
                        ItemsSource="{Binding Orders, ElementName=root}"
                        Margin="0,2,0,0">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Xpf:ToggleButton Content="{Binding ORD_Name}"
                                      Height="18"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      CornerRadius="5"
                                      Margin="2,0,2,0"
                                      Visibility="{Binding ORD_IsView, Converter={converter:BooleanToVisibilityConverter}}"
                                      IsSelected="{Binding IsSelected}"
                                      Click="OnClick_Button">

                        <Xpf:ToggleButton.Resources>
                            <Style TargetType="{x:Type Xpf:ToggleButton}">
                                <Setter Property="Background" Value="#EEF3F8"/>
                                <Setter Property="Foreground" Value="#3F4F5D"/>
                                <Setter Property="BorderBrush" Value="#D5E0EA"/>

                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Background" Value="#5B7083"/>
                                        <Setter Property="Foreground" Value="#F8F9FA"/>
                                        <Setter Property="BorderBrush" Value="#B8C9DC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Xpf:ToggleButton.Resources>
                    </Xpf:ToggleButton>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Xpf:StyleGrid>
</Xpf:CustomControl>
