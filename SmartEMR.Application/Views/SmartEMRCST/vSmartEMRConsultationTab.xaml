<base:ModelViewLayout x:TypeArguments="vm:ConsultationViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRCST.vSmartEMRConsultationTab"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRCST"
                      xmlns:patient="clr-namespace:SmartEMR.Application.Views.Patients"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                      mc:Ignorable="d"
                      d:DesignHeight="920"
                      d:DesignWidth="800">

    <dxd:DockLayoutManager dxc:ThemeManager.ThemeName="Office2010Blue">
        <dxd:LayoutGroup Orientation="Horizontal">
            <Xpf:LayoutPanel Caption="진료현황"  ItemWidth="0.5*">
                <local:vSmartEMRConsultationTabCST x:Name="SmartEMRConsultationTabCST"/>
            </Xpf:LayoutPanel>
            <Xpf:LayoutPanel Caption="오더목록" ItemWidth="0.4*">
                <local:vSmartEMRConsultationTabOrder x:Name="SmartEMRConsultationTabOrder"/>
            </Xpf:LayoutPanel>

            <dxd:LayoutGroup Orientation="Vertical">
                <dxd:LayoutGroup Orientation="Horizontal" ItemHeight="0.5*">
                    <Xpf:LayoutPanel ItemWidth="1.2*" ShowCaption="False">
                        <patient:vPatientViewSummary x:Name="PatientViewSummary"/>
                    </Xpf:LayoutPanel>
                    <Xpf:LayoutPanel Caption="진료환자 이력" ItemWidth="0.8*">
                        <patient:vPatientHistory x:Name="PatientHistory"/>
                    </Xpf:LayoutPanel>
                </dxd:LayoutGroup>

                <dxd:LayoutGroup Orientation="Horizontal">
                    <dxd:LayoutGroup Orientation="Vertical">
                        <Xpf:LayoutPanel Caption="진료정보" ItemHeight="250">
                            <local:vSmartEMRCSTInfoGrid x:Name="SmartEMRCSTInfo"/>
                        </Xpf:LayoutPanel>
                        <Xpf:LayoutPanel ShowCaption="False" ItemHeight="1*">
                            <local:vSmartEMRConsultationTabCSTOInfo x:Name="SmartEMRConulstationTabCSTOInfo"/>
                        </Xpf:LayoutPanel>
                        <Xpf:LayoutPanel ShowCaption="False" ItemHeight="0.4*">
                            <local:vSmartEMRConsultationTabPayInfo x:Name="SmartEMRPayInfo"/>
                        </Xpf:LayoutPanel>
                        <Xpf:LayoutPanel ItemHeight="Auto" Padding="2" ShowBorder="False" ShowCaption="False">
                            <Xpf:StyleGrid LayoutDefinitions="6,1" Height="27">
                                <dxc:SimpleButton   Grid.Column="0"
                                                    Tag="btnCancel"
                                                    Content="진료취소" 
                                                    Glyph="/Images/smartemr_cancel_new.png"
                                                    GlyphWidth="17"
                                                    GlyphHeight="17"
                                                    GlyphToContentOffset="2"
                                                    Padding="2"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding Model.CST_Idx, Converter={converter:IntToBooleanConverter Invert=True}}"
                                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                                    Click="OnClick_SimpleButton"/>

                                <dxc:SimpleButton   Grid.Column="1"
                                                    Content="진료대기"
                                                    Tag="btnReady"
                                                    Glyph="/Images/smartemr-wait.png"
                                                    GlyphWidth="17"
                                                    GlyphHeight="17"
                                                    GlyphToContentOffset="2"
                                                    Margin="2,0,0,0"
                                                    Padding="2"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding Model.RCP_Idx, Converter={converter:IntToBooleanConverter Invert=True}}"
                                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                                    Click="OnClick_SimpleButton"/>

                                <dxc:SimpleButton   Grid.Column="2"
                                                    Tag="btnPending"
                                                    Content="진료보류" 
                                                    Glyph="/Images/smartemr-holding.png"
                                                    GlyphWidth="17"
                                                    GlyphHeight="17"
                                                    GlyphToContentOffset="2"
                                                    Margin="2,0,0,0"
                                                    Padding="2"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding Model.RCP_Idx, Converter={converter:IntToBooleanConverter Invert=True}}"
                                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                                    Click="OnClick_SimpleButton"/>

                                <dxc:SimpleButton   Grid.Column="3"
                                                    Tag="btnContinue"
                                                    Content="진료계속" 
                                                    Glyph="/Images/smartemr-continue.png"
                                                    GlyphWidth="17"
                                                    GlyphHeight="17"
                                                    GlyphToContentOffset="2"
                                                    Margin="2,0,0,0"
                                                    Padding="2"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding Model.RCP_Idx, Converter={converter:IntToBooleanConverter Invert=True}}"
                                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                                    Click="OnClick_SimpleButton"/>

                                <dxc:SimpleButton   Grid.Column="4"
                                                    Tag="btnFinish"
                                                    Content="진료완료" 
                                                    Glyph="/Images/smartemr_save.png"
                                                    GlyphWidth="17"
                                                    GlyphHeight="17"
                                                    GlyphToContentOffset="2"
                                                    Margin="2,0,0,0"
                                                    Padding="2"
                                                    Cursor="Hand"
                                                    IsEnabled="{Binding Model.RCP_Idx, Converter={converter:IntToBooleanConverter Invert=True}}"
                                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                                    Click="OnClick_SimpleButton"/>

                                <dxc:SimpleButton   Grid.Column="5"
                                                    Tag="btnClear"
                                                    Content="진료초기화" 
                                                    Glyph="/Images/smartemr_empty_paper.png"    
                                                    GlyphWidth="17"
                                                    GlyphHeight="17"
                                                    GlyphToContentOffset="2"
                                                    Margin="2,0,0,0"
                                                    Padding="2"
                                                    Cursor="Hand"
                                                    dxc:ThemeManager.ThemeName="Office2016Colorful"
                                                    Click="OnClick_SimpleButton"/>
                            </Xpf:StyleGrid> 
                        </Xpf:LayoutPanel>
                    </dxd:LayoutGroup>
                </dxd:LayoutGroup>
            </dxd:LayoutGroup>
        </dxd:LayoutGroup>
    </dxd:DockLayoutManager>
</base:ModelViewLayout>