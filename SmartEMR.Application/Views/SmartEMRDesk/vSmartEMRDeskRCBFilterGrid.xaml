<UserControl x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskRCBFilterGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"             
             mc:Ignorable="d" 
             Height="50"
             VerticalAlignment="Center">
    
    <Xpf:BindGrid       LayoutDefinitions="6,2"
                        Background="#F5F5F5"
                        ItemSpace="1"
                        Margin="2,0,2,0">

        <x:Array Type="{x:Type Xpf:BindItem}">
            <Xpf:BindItem   FieldName="RCB_YYMMDD"
                            BindType="DateEdit"
                            Height="23"
                            Col="0"
                            Row="0"
                            DisplayFormatString="yyyy년 MM월 dd일 dddd"
                            Margin="0,2,2,0"
                            IsHeader="False"/>

            <Xpf:BindItem   FieldName="btnSetToDay"
                            BindType="Button"
                            TextValue="오늘"
                            Width="32"
                            Height="23"
                            Foreground="DimGray"
                            BackGround="TransParent"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Margin="2,2,2,0"
                            IsBinding="False"
                            IsBindClickEvent="True"/>
        </x:Array>

        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                        BindType="ComboBox"
                        Col="1"
                        Row="0"
                        DisplayMember="MUR_Name"
                        ValueMember="MUR_Idx"/>

        <Xpf:BindItem   FieldName="RES_Status"
                        BindType="ComboBox"
                        Col="2"
                        Row="0"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCP_Status"
                        BindType="ComboBox"
                        Col="3"
                        Row="0"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCP_InsuranceType"
                        BindType="ComboBox"
                        Col="0"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCB_Route"
                        BindType="ComboBox"
                        Col="1"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCB_VisitType"
                        BindType="ComboBox"
                        Col="2"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <x:Array Type="{x:Type Xpf:BindItem}">
            <Xpf:BindItem   FieldName="keyword"
                            BindType="SearchEdit"
                            Col="4"
                            Row="0"
                            ColSpan="3"
                            RowSpan="2"
                            Placeholder="환자명/차트번호로 검색하세요."/>

            <Xpf:BindItem   FieldName="btnClearFilter"
                            BorderThickness="1"
                            Width="23"
                            IsBinding="False"
                            IsBindClickEvent="True"
                            IsAutoWidth="False"
                            Margin="0">

                <Xpf:ImageButton    Width="23"
                                    Height="23"
                                    Glyph="/Images/smartemr_reset.png"
                                    BorderBrush="LightGray"/>
            </Xpf:BindItem>
        </x:Array>
    </Xpf:BindGrid>
</UserControl>
