<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskIRCInfo"
                        x:TypeArguments="vm:SmartEMRIRCInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:desk="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:common="clr-namespace:SmartEMR.Application.Common"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">
    
    <Xpf:StyleGrid  x:Name="LayoutRoot"
                    LayoutDefinitions="1,1">

        <Xpf:BindGrid   Grid.Row="0"
                        LayoutDefinitions="2,5"
                        BindStyle="DataCell"
                        ItemSpace="2">

            <Xpf:BindItem   FieldName="IRC_Type"
                            Header="보 험 구 분"
                            BindType="Label"
                            Col="0"
                            Row="0"
                            ColSpan="2"
                            FontWeight="Bold"/>

            <Xpf:BindItem   FieldName="IRC_CertNum"
                            Header="보험증번호"
                            BindType="TextBox"
                            Col="0"
                            Row="1"
                            ColSpan="2"/>

            <Xpf:BindItem   FieldName="IRC_ContractorName"
                            Header="계  약  자"
                            BindType="TextBox"
                            Col="0"
                            Row="2"/>


            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_InsuredName"
                                Header="피 보 험 자"
                                BindType="TextBox"
                                Col="1"
                                Row="2"/>

                <Xpf:BindItem   FieldName="chkIsSameAsContractor"
                                BindType="CheckBox"
                                TextValue="계약자와 동일"
                                FontSize="11"
                                Foreground="DimGray"
                                FontWeight="SemiBold"
                                IsBinding="False"/>
            </x:Array>

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_Coperation"
                                Header="보 험 사 명"
                                BindType="ComboBox"
                                DisplayMember="IRC_CoName"
                                ValueMember="IRC_CoName"
                                Col="0"
                                Row="3"/>

                <Xpf:BindItem   FieldName="IRC_CoName"
                                BindType="TextBox"
                                Placeholder="직접입력"
                                Width="80"
                                IsEnabled="False"/>
            </x:Array>

            <Xpf:BindItem   FieldName="IRC_EffectiveYYMMDD"
                            Header="유 효 일 자"
                            BindType="DateEdit"
                            Col="0"
                            Row="4"/>

            <Xpf:BindItem   FieldName="IRC_ExpiredYYMMDDD"
                            Header="만 료 일 자"
                            BindType="DateEdit"
                            Col="1"
                            Row="4"/>
        </Xpf:BindGrid>

        <Xpf:MaskControl    x:Name="MaskControl"
                            Grid.RowSpan="2"
                            MaskText="접수정보 - 비보험외의 보험을 선택시 활성화됩니다."/>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
