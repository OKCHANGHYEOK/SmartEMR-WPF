<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskIRCInfo"
                        x:TypeArguments="vm:SmartEMRIRCInfoViewModel"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:desk="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:common="clr-namespace:SmartEMR.Application.Common"
                        xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">
    
    <Xpf:StyleGrid  x:Name="LayoutRoot"
                    LayoutDefinitions="1,2"
                    RowSizeDefinitions="1*,Auto">

        <Xpf:BindGrid   Grid.Row="0"
                        LayoutDefinitions="2,8"
                        BindStyle="DataCell"
                        ItemSpace="2">

            <Xpf:BindItem   FieldName="vIRC_Type"
                            Header="보 험 구 분"
                            BindType="Label"
                            Col="0"
                            Row="0"
                            ColSpan="2"
                            FontSize="12"
                            HAlignment="Left"
                            FontWeight="Bold"/>

            <Xpf:BindItem   FieldName="IRC_CertNum"
                            Header="보험증번호"
                            BindType="TextBox"
                            Col="0"
                            Row="1"
                            ColSpan="2"/>


            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_ContractorName"
                                Header="보 험 관 계 자"
                                BindType="TextBox"
                                Col="0"
                                Row="2"
                                ColSpan="2"
                                Placeholder="가입자명"/>

                <Xpf:BindItem   FieldName="IRC_InsuredName"
                                BindType="TextBox"
                                Placeholder="피보험자명"/>

                <Xpf:BindItem   FieldName="chkIsSameAsContractor"
                                BindType="CheckBox"
                                TextValue="본인"
                                FontSize="11"
                                Foreground="DimGray"
                                FontWeight="DemiBold"
                                Width="42"
                                ToolTip="가입자가 본인과 동일함"
                                IsBinding="False"
                                IsBindClickEvent="True"/>
            </x:Array>

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_Coperation"
                                Header="보 험 사 명"
                                BindType="ComboBox"
                                DisplayMember="IRC_CoName"
                                ValueMember="IRC_CoName"
                                Col="0"
                                Row="3"
                                ColSpan="2"/>

                <Xpf:BindItem   FieldName="IRC_CoName"
                                BindType="TextBox"
                                Placeholder="직접입력"
                                Width="80"
                                IsEnabled="False"/>
            </x:Array>

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="IRC_EffectiveYYMMDD"
                                Header="유 효 기 간"
                                BindType="DateEdit"
                                Col="0"
                                Row="4"
                                ColSpan="2"/>

                <Xpf:BindItem   FieldName=""
                                BindType="Label"
                                TextValue="-"
                                FontSize="10"
                                Width="10"
                                IsBinding="False"/>

                <Xpf:BindItem   FieldName="IRC_ExpiredYYMMDDD"
                                BindType="DateEdit"/>
            </x:Array>

            <Xpf:BindItem   FieldName="IRC_Specific"
                            Header="특 정 내 역"
                            Col="0"
                            Row="5"
                            ColSpan="2"
                            RowSpan="3"
                            ContentAlignment="LeftTop"/>
        </Xpf:BindGrid>

        <Xpf:StyleGrid  Grid.Row="1"
                        LayoutDefinitions="1,1"
                        Margin="0,2,0,2">

            <Xpf:Button x:Name="btnClear"
                        Grid.Column="0"
                        Content="초기화"
                        Glyph="/Images/smartemr_empty_paper.png"
                        Width="90"
                        MinHeight="24"
                        Height="24"
                        HorizontalAlignment="Right"
                        Margin="0,0,2,0"
                        Click="OnClick_Button"/>
        </Xpf:StyleGrid>

        <Xpf:MaskControl    x:Name="MaskControl" Grid.RowSpan="2">
            <Xpf:TextBlock TextAlignment="Center">
                <Run>접수정보에서 비보험외의 보험 선택후</Run>
                <LineBreak/>
                <Run>상세입력 클릭 시 활성화됩니다.</Run>
            </Xpf:TextBlock>
        </Xpf:MaskControl>
    </Xpf:StyleGrid>
</base:ModelViewLayout>
