<base:ModelViewLayout x:TypeArguments="vm:PayViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskPAY"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:template="clr-namespace:SmartEMR.Application.Template"
                      xmlns:selections="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800"
                      d:DataContext="{d:DesignInstance Type={x:Type vm:PayViewModel}}">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*">

        <Xpf:StyleGrid LayoutDefinitions="5,1"
                       ColumnSizeDefinitions="5,Auto,10,*,5"
                       MinHeight="27"
                       Height="27"
                       Background="#F8F9FA">
            
            <Xpf:TextBlock Grid.Column="1"
                           Foreground="Gray"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           Margin="0,2,0,0">
                <Run Text="{Binding NowYYYYMMDD}"/>
                <Run>기준</Run>
            </Xpf:TextBlock>

            <Xpf:BindGrid   Grid.Column="3"
                            LayoutDefinitions="2,1"
                            ColumnSizeDefinitions="Auto,*"
                            Margin="3,3,1,0">

                <Xpf:BindItem   FieldName="PAY_Status"
                                BindType="ComboBox"
                                Col="0"
                                Width="90"
                                Height="23"
                                ItemsSource="{x:Static selections:SearchFilterItems.PayStatuses}"
                                DisplayMember="CCI_Name"
                                ValueMember="CCI_Cd"
                                Margin="2,0,0,0"/>

                <Xpf:BindItem FieldName="Keyword"
                              Col="1"
                              Height="23"
                              Margin="2,0,0,0">

                    <Xpf:SearchPanel NullText="환자명/차트번호로 검색하세요."
                                     SearchCommand="{Binding SearchCommand}"/>
                </Xpf:BindItem>
            </Xpf:BindGrid>
        </Xpf:StyleGrid>

        <Border Grid.Row="1" Height="1" Background="LightGray" Margin="0,2,0,2"/>

        <Xpf:DataGrid Grid.Row="2"
                      ItemsSource="{Binding Pays}"
                      AutoWidth="False">
            <Xpf:ColumnItem FieldName="RCP_InsuranceType"
                            Header=""
                            CellTemplateType="{x:Type template:InsuranceTypeTemplate}"
                            ColumnWidth="25"/>

            <Xpf:ColumnItem FieldName="PAY_Status"
                            Header="상태"
                            CellTemplateType="{x:Type template:PAYStatusTemplate}"
                            ColumnWidth="45"/>

            <Xpf:ColumnItem FieldName="PAT_Name"
                            Header="환자명"
                            ColumnType="TextLink"
                            ColumnWidth="70"/>

            <Xpf:ColumnItem FieldName="PAT_ChartNo"
                            Header="차트번호"
                            ColumnWidth="80"/>

            <Xpf:ColumnItem FieldName="PAY_TotalPrice"
                            Header="총수납금"
                            ColumnWidth="80"
                            ColumnStyle="Sum"
                            DisplayFormat="N0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_InsuredPrice"
                            Header="급여총액"
                            ColumnWidth="80"
                            ColumnStyle="Sum"
                            DisplayFormat="N0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_NonInsuredPrice"
                            Header="비급여총액"
                            ColumnWidth="80"
                            ColumnStyle="Sum"
                            DisplayFormat="N0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_OwnPatientPrice"
                            Header="본인부담금"
                            ColumnWidth="80"
                            ColumnStyle="Sum"
                            DisplayFormat="N0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_PaidPrice"
                            Header="수납금"
                            ColumnWidth="80"
                            ColumnStyle="Sum"
                            Foreground="Blue"
                            DisplayFormat="N0"
                            Suffix="원"></Xpf:ColumnItem>

            <Xpf:ColumnItem FieldName="PAY_RemainPrice"
                            Header="미수납"
                            ColumnWidth="80"
                            ColumnStyle="Sum"
                            Foreground="IndianRed"
                            DisplayFormat="N0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_Memo"
                            Header="메모"
                            Foreground="DimGray"/>

            <Xpf:ColumnItem FieldName="btnMovePAY"
                            Header=""
                            ColumnWidth="25"
                            CellTemplateType="{x:Type local:btnMovePAYTemplate}"/>
        </Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>