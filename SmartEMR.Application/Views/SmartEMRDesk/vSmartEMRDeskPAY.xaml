<base:ModelViewLayout x:TypeArguments="vm:PayViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskPAY"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid  LayoutDefinitions="1,3"
                    RowSizeDefinitions="Auto,Auto,*">

        <Xpf:StyleGrid LayoutDefinitions="6,1"
                       ColumnSizeDefinitions="5,Auto,10,*,Auto,5">

            <Xpf:TextBlock Grid.Column="1"
                           Foreground="Gray"
                           FontWeight="SemiBold">
                <Run Text="{Binding NowYYYYMMDD}"/>
                <Run>기준</Run>
            </Xpf:TextBlock>
            
            <Xpf:BindGrid   Grid.Column="3"
                            LayoutDefinitions="2,1"
                            ColumnSizeDefinitions="Auto,Auto">

                <Xpf:BindItem   FieldName="PAY_Status"
                                BindType="ComboBox"
                                Col="0"
                                DisplayMember="CCC_Name"
                                ValueMember="CCI_Cd"/>
            </Xpf:BindGrid>

            <Xpf:Button Grid.Column="4"
                        Content="새로고침"
                        MinHeight="21"
                        Height="21"
                        Background="White"
                        BorderBrush="LightGray"/>
        </Xpf:StyleGrid>

        <Border Grid.Row="1" Height="1" Background="LightGray" Margin="0,2,0,2"/>

        <Xpf:DataGrid Grid.Row="2">
            <Xpf:ColumnItem FieldName=""
                            ColumnWidth="25"></Xpf:ColumnItem>
        </Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>