<base:ModelViewLayout   x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskPATView"
                        x:TypeArguments="model:Patient"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                        xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                        xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                        xmlns:view="clr-namespace:SmartEMR.Application.Views"
                        xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                        xmlns:model="clr-namespace:SmartEMR.Domain.Entities;assembly=SmartEMR.Domain"
                        xmlns:desk="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
                        mc:Ignorable="d" 
                        d:DesignHeight="450" d:DesignWidth="800">

    <Border Background="White" CornerRadius="3">
        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Direction="315"
                              BlurRadius="15"
                              ShadowDepth="2"
                              Opacity="0.15"/>
        </Border.Effect>

        <Xpf:StyleGrid LayoutDefinitions="13,13" ShowGridLines="True" Padding="5">            
            <Border x:Name="PatientImageBorder" 
                    Grid.Column="0"
                    Grid.Row="0"
                    Grid.ColumnSpan="4"
                    Grid.RowSpan="8"
                    BorderBrush="Black" 
                    BorderThickness="1">
                <Image x:Name="PatientImage" Source="{Binding PAT_ImageSource}" Stretch="Uniform"/>
            </Border>
            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="9"  VerticalAlignment="Center" Margin="10,0">
                <Label FontSize="18" FontWeight="SemiBold" Foreground="SkyBlue">No.</Label>
                <Label FontSize="17" FontWeight="Bold" Foreground="DarkSlateGray">1234567</Label>
            </StackPanel>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="1" Grid.Column="4" Grid.ColumnSpan="4">
                <Label FontSize="15" FontWeight="SemiBold">성명</Label>
                <Label FontSize="15" FontWeight="Bold"  Content="{Binding PAT_Name}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="1" Grid.Column="8" Grid.ColumnSpan="4">
                <Label FontSize="15" FontWeight="SemiBold">성별/나이</Label>
                <Label FontSize="15" FontWeight="Bold"  Content="{Binding vPAT_Info}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="4">
                <Label FontSize="15" FontWeight="SemiBold">생년월일</Label>
                <Label FontSize="15" Content="{Binding PAT_BirthDate}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="2" Grid.Column="8" Grid.ColumnSpan="4">
                <Label FontSize="15" FontWeight="SemiBold">전화번호</Label>
                <Label FontSize="15" Content="{Binding PAT_PhoneNum}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="3" Grid.Column="4" Grid.ColumnSpan="8">
                <Label FontSize="15" FontWeight="SemiBold">주소</Label>
                <Label FontSize="15" Content="{Binding PAT_Address1}" Margin="5,0"/>
                <Label FontSize="15" Content="{Binding PAT_Address2}" Margin="5,0"/>
                <Label FontSize="15" Content="{Binding PAT_Address3}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <Xpf:ImageButton x:Name="btnCopyAddress"
                             Grid.Row="3" 
                             Grid.Column="12" 
                             Width="33" 
                             Height="33" 
                             Glyph="/Images/copy.png"
                             Click="OnClick_ImageButton"/>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="5" Grid.Column="4" Grid.ColumnSpan="4">
                <Label FontSize="15" FontWeight="SemiBold">최초내원일</Label>
                <Label FontSize="15" Content="{Binding PAT_FirstVisitDate}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="5" Grid.Column="8" Grid.ColumnSpan="4">
                <Label FontSize="15" FontWeight="SemiBold">최종내원일</Label>
                <Label FontSize="15" Content="{Binding PAT_LastVisitDate}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
            <desk:vSmartEMRDeskPATView_TextItem Grid.Row="6" Grid.Column="4" Grid.ColumnSpan="3">
                <Label FontSize="15" FontWeight="SemiBold">내원경로</Label>
                <Label FontSize="15" Content="{Binding PAT_SourceType}" Margin="5,0"/>
            </desk:vSmartEMRDeskPATView_TextItem>
        </Xpf:StyleGrid>
    </Border>
</base:ModelViewLayout>
