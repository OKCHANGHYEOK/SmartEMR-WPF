<base:ModelViewLayout x:TypeArguments="vm:PatientHistoryViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskPATHistory"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid x:Name="LayoutRoot">
        <dx:DXTabControl x:Name="TabControl" SelectionChanged="OnTabControl_SelectionChanged">
            <dx:DXTabItem   Tag="RES" 
                            Header="예약" 
                            IsSelected="True">
                <Xpf:DataGrid>
                    <Xpf:ColumnItem FieldName="RES_YYMMDD" Header="예약일자"/>
                </Xpf:DataGrid>
            </dx:DXTabItem>
            <dx:DXTabItem   Tag="RCP" Header="접수">
                <Xpf:DataGrid>
                    <Xpf:ColumnItem FieldName="RCP_YYMMDD" Header="접수일자"/>
                </Xpf:DataGrid>
            </dx:DXTabItem>
            <dx:DXTabItem   Tag="CST" Header="진료">
                <Xpf:DataGrid>
                    <Xpf:ColumnItem FieldName="CST_YYMMDD" Header="진료일자"/>
                </Xpf:DataGrid>
            </dx:DXTabItem>
            <dx:DXTabItem   Tag="CORD" Header="처방">
                <Xpf:DataGrid>
                    <Xpf:ColumnItem FieldName="CORD_YYMMDD" Header="처방일자"/>
                </Xpf:DataGrid>
            </dx:DXTabItem>
            <dx:DXTabItem   Tag="PAY" Header="수납">
                <Xpf:DataGrid>
                    <Xpf:ColumnItem FieldName="PAY_YYMMDD" Header="수납일자"/>
                </Xpf:DataGrid>
            </dx:DXTabItem>
        </dx:DXTabControl>
    </Xpf:StyleGrid>
</base:ModelViewLayout>