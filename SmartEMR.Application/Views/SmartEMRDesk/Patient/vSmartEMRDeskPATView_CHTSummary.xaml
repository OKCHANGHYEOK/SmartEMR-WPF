<Xpf:CustomControl x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskPATView_CHTSummary"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
             xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:StyleGrid>
        <Border Background="#D2F7FF" BorderThickness="1" CornerRadius="5">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#00BFFF" Offset="0.0" />
                    <GradientStop Color="#4169E1" Offset="0.5" />
                    <GradientStop Color="#00008B" Offset="1.0" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>
        <Border Background="AliceBlue" Opacity="0.9">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                <Label FontWeight="Bold" FontSize="13">
                    금일 접수가 존재하지 않습니다.
                </Label>
                <Xpf:Button Background="GhostWhite"
                            Margin="5"
                            Width="80"
                            Height="24"
                            HorizontalContentAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Images/smartemr_desk_register.png" Width="17" Height="17"></Image>
                        <Label FontSize="10" Content="접수하기" Margin="2,0"/>
                    </StackPanel>
                </Xpf:Button>
            </StackPanel>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NOW_CHT_Idx_RCV, Converter={StaticResource ResourceKey=IntToVisibilityConverter}}">
                            
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Xpf:StyleGrid>
</Xpf:CustomControl>
