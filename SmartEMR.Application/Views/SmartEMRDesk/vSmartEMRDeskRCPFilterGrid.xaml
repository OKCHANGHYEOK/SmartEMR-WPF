<UserControl x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskRCPFilterGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"             
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Height="36"
             VerticalAlignment="Center">
    
    <Xpf:BindGrid       LayoutDefinitions="8,1"
                        ColumnSizeDefinitions="1*,Auto,1*,1*,1*,1*,1*,Auto"
                        Background="#F5F5F5"
                        Height="36"
                        ItemSpace="1"
                        Margin="2,0,2,0">

        <Xpf:BindItem   FieldName="RCP_YYMMDD"
                        BindType="DateEdit"
                        Height="32"
                        Col="0"
                        Row="0"
                        DisplayFormatString="yyyy년 MM월 dd일 dddd"
                        Margin="0,2,2,0"
                        IsHeader="False"/>

        <Xpf:BindItem   FieldName="btnSetToDay"
                        BindType="Button"
                        TextValue="오늘"
                        Width="32"
                        Height="32"
                        Foreground="DimGray"
                        BackGround="TransParent"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        Margin="2,2,2,0"
                        Col="1"
                        Row="0"
                        IsBinding="False"
                        IsBindClickEvent="True"/>

        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                        BindType="ComboBox"
                        Col="2"
                        Row="0"
                        DisplayMember="MUR_Name"
                        ValueMember="MUR_Idx"/>

        <Xpf:BindItem   FieldName="RCP_Status"
                        BindType="ComboBox"
                        Col="3"
                        Row="0"
                        DisplayMember="CCC_Name"
                        ValueMember="CCC_Cd"/>

        <Xpf:BindItem   FieldName="RCP_Route"
                        BindType="ComboBox"
                        Col="4"
                        Row="0"
                        DisplayMember="CCC_Name"
                        ValueMember="CCC_Cd"/>

        <Xpf:BindItem   FieldName="IRC_Type"
                        BindType="ComboBox"
                        Col="5"
                        Row="0"
                        DisplayMember="CCC_Name"
                        ValueMember="CCC_Cd"/>

        <Xpf:BindItem   FieldName="RCP_VisitType"
                        BindType="ComboBox"
                        Col="6"
                        Row="0"
                        DisplayMember="CCC_Name"
                        ValueMember="CCC_Cd"/>

        <Xpf:BindItem   FieldName="btnClearFilter"
                        BorderThickness="1"
                        Col="7"
                        Row="0"
                        IsBinding="False"
                        IsBindClickEvent="True"
                        IsAutoWidth="False"
                        Margin="0">

            <Xpf:ImageButton    Width="32"
                                Height="32"
                                Glyph="/Images/smartemr_reset.png"
                                BorderBrush="LightGray"/>
        </Xpf:BindItem>
    </Xpf:BindGrid>
</UserControl>
