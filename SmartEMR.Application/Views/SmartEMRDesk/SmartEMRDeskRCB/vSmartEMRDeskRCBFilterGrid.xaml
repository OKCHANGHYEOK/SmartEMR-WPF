<UserControl x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskRCBFilterGrid"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
             xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"        
             xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
             mc:Ignorable="d" 
             Height="50"
             VerticalAlignment="Center">
    
    <Xpf:BindGrid       LayoutDefinitions="6,2"
                        Background="#F5F5F5"
                        ItemSpace="1"
                        Margin="2,0,2,0">

        <x:Array Type="{x:Type Xpf:BindItem}">
            <Xpf:BindItem   FieldName="RCB_YYMMDD"
                            BindType="DateEdit"
                            Height="23"
                            Col="0"
                            Row="0"
                            ColSpan="2"
                            FontWeight="Bold"
                            Margin="2,0,2,0"
                            Converter="{converter:DateTimeToStringConverter ValueFormat='yyyy-MM-dd',DisplayFormat='yyyy년 MM월 dd일 dddd'}"
                            IsHeader="False"/>

            <Xpf:BindItem   FieldName="btnSetToDay"
                            BindType="Button"
                            TextValue="오늘"
                            Width="32"
                            Height="23"
                            Foreground="DimGray"
                            BackGround="TransParent"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Margin="2,0,2,0"
                            IsBinding="False"
                            IsBindClickEvent="True"/>
        </x:Array>

        <x:Array Type="{x:Type Xpf:BindItem}">
            <Xpf:BindItem   FieldName="Keyword"
                            BindType="SearchEdit"
                            Height="23"
                            Col="2"
                            Row="0"
                            ColSpan="4"
                            Placeholder="환자명/차트번호로 검색하세요."/>

            <Xpf:BindItem   FieldName="ButtonPanel"
                            Width="50"
                            Height="23">

                <Xpf:StyleGrid  LayoutDefinitions="5,1"
                                ColumnSizeDefinitions="1,Auto,2,Auto,1"
                                Margin="0">

                    <Xpf:ImageButton    x:Name="btnSearch"
                                        Grid.Column="1"
                                        Width="23"
                                        Height="23"
                                        ImageWidth="18"
                                        ImageHeight="18"
                                        Glyph="/Images/smartemr_search.png"
                                        BorderBrush="LightGray"
                                        Click="OnClick_ImageButton">
                    </Xpf:ImageButton>

                    <Xpf:ImageButton    x:Name="btnClearFilter"
                                        Grid.Column="3"
                                        Width="23"
                                        Height="23"
                                        ImageWidth="18"
                                        ImageHeight="18"
                                        Glyph="/Images/smartemr_reset.png"
                                        BorderBrush="LightGray"
                                        Click="OnClick_ImageButton">
                    </Xpf:ImageButton>
                </Xpf:StyleGrid>
            </Xpf:BindItem>
        </x:Array>

        <Xpf:BindItem   FieldName="RES_Status"
                        BindType="ComboBox"
                        Col="0"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCP_Status"
                        BindType="ComboBox"
                        Col="1"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCB_Subject"
                        BindType="ComboBox"
                        Col="2"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCB_Route"
                        BindType="ComboBox"
                        Col="3"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                        BindType="ComboBox"
                        Col="4"
                        Row="1"
                        DisplayMember="MUR_Name"
                        ValueMember="MUR_Idx"/>

        <Xpf:BindItem   FieldName="RCP_InsuranceType"
                        BindType="ComboBox"
                        Col="5"
                        Row="1"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>
    </Xpf:BindGrid>
</UserControl>
