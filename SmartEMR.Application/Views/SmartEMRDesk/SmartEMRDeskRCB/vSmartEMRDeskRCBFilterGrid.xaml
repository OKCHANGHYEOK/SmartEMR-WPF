<Xpf:CustomControl  x:Class="SmartEMR.Application.Views.SmartEMRDesk.vSmartEMRDeskRCBFilterGrid"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"        
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    xmlns:common="clr-namespace:SmartEMR.Application.Common"
                    xmlns:selections="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/core"
                    mc:Ignorable="d" 
                    Height="50"
                    VerticalAlignment="Center">

    <Xpf:BindGrid       LayoutDefinitions="6,2"
                        Background="#F5F5F5"
                        ItemSpace="1"
                        Margin="2,0,2,0">

        <x:Array Type="{x:Type Xpf:BindItem}">
            <Xpf:BindItem   FieldName="RCB_YYMMDD"
                            BindType="DateEdit"
                            Height="23"
                            Col="0"
                            Row="0"
                            ColSpan="2"
                            FontWeight="Bold"
                            Margin="2,0,2,0"
                            Converter="{converter:DateTimeToStringConverter ValueFormat='yyyy-MM-dd',DisplayFormat='yyyy년 MM월 dd일 dddd'}"
                            IsHeader="False"/>

            <Xpf:BindItem   FieldName="btnSetToday"
                            BindType="Button"
                            TextValue="오늘"
                            Width="32"
                            Height="23"
                            Foreground="DimGray"
                            BackGround="White"
                            BorderBrush="LightGray"
                            BorderThickness="1"
                            Margin="2,0,2,0"
                            IsBinding="False"
                            IsBindClickEvent="True"/>
        </x:Array>

        <Xpf:BindItem  FieldName="Keyword"
                       Col="2"
                       ColSpan="4"
                       IsBinding="False">

            <Xpf:SearchPanel NullText="환자명/차트번호로 검색하세요." 
                             Margin="2,0,2,0"
                             SearchCommand="{Binding SearchCommand}"/>
        </Xpf:BindItem>

        <Xpf:BindItem   FieldName="RES_Status"
                        BindType="ComboBox"
                        Col="0"
                        Row="1"
                        ItemsSource="{x:Static selections:SearchFilterItems.ReservationStatuses}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCP_Status"
                        BindType="ComboBox"
                        Col="1"
                        Row="1"
                        ItemsSource="{x:Static selections:SearchFilterItems.ReceptionStatuses}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCB_Subject"
                        BindType="ComboBox"
                        Col="2"
                        Row="1"
                        ItemsSource="{x:Static selections:SearchFilterItems.Subjects}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="RCB_Route"
                        BindType="ComboBox"
                        Col="3"
                        Row="1"
                        ItemsSource="{x:Static selections:SearchFilterItems.RouteTypes}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>

        <Xpf:BindItem   FieldName="MUR_Idx_DOC"
                        BindType="ComboBox"
                        Col="4"
                        Row="1"
                        ItemsSource="{x:Static selections:SearchFilterItems.Docters}"
                        DisplayMember="MUR_Name"
                        ValueMember="MUR_Idx"/>

        <Xpf:BindItem   FieldName="RCP_InsuranceType"
                        BindType="ComboBox"
                        Col="5"
                        Row="1"
                        ItemsSource="{x:Static selections:SearchFilterItems.InsuranceTypes}"
                        DisplayMember="CCI_Name"
                        ValueMember="CCI_Cd"/>
    </Xpf:BindGrid>
</Xpf:CustomControl>
