<Xpf:GridTemplate   x:Class="SmartEMR.Application.Views.SmartEMRDesk.SmartEMRDeskRCB.vSmartEMRDeskRCBTemplate_RCBType"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk.SmartEMRDeskRCB"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:Label  Content="{Binding vRCB_Type}" Foreground="{Binding RCB_Type, Converter={converter:ReceptionBoardTypeToBrushConverter}}"
                BorderBrush="{Binding RCB_Type, Converter={converter:ReceptionBoardTypeToBrushConverter}}"
                BorderThickness="1"
                Background="Transparent"
                Height="23"
                Margin="2"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center">
    </Xpf:Label>
</Xpf:GridTemplate>
