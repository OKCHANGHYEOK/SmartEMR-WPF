<Xpf:GridTemplate   x:Class="SmartEMR.Application.Views.SmartEMRDesk.SmartEMRDeskRCB.vSmartEMRDeskRCBTemplate_RCBVisitType"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRDesk.SmartEMRDeskRCB"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                    mc:Ignorable="d" 
                    d:DesignHeight="450" d:DesignWidth="800">

    <Xpf:Label  Content="{Binding vRCB_VisitType}"
                Height="23"
                BorderBrush="{Binding RCB_VisitType, Converter={converter:RCBVisitTypeToBrushConverter}}"
                BorderThickness="1"
                Foreground="{Binding RCB_VisitType, Converter={converter:RCBVisitTypeToBrushConverter}}"
                Margin="2"/>
</Xpf:GridTemplate>
