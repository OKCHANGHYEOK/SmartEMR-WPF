<base:ModelViewLayout x:TypeArguments="vm:PayViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRPay.vSmartEMRPayTab"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:view="clr-namespace:SmartEMR.Application.Views"
                      xmlns:patient="clr-namespace:SmartEMR.Application.Views.Patients"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRPay"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:dxd="http://schemas.devexpress.com/winfx/2008/xaml/docking"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <dxd:DockLayoutManager dxc:ThemeManager.ThemeName="Office2019Colorful">
        <dxd:LayoutGroup Orientation="Horizontal">
            <Xpf:LayoutPanel ItemWidth="0.7*" ShowCaption="False">
                <local:vSmartEMRPayTabPAY x:Name="SmartEMRPayTabPAY"/>
            </Xpf:LayoutPanel>

            <dxd:LayoutGroup ItemWidth="Auto" Orientation="Vertical">
                <Xpf:LayoutPanel ItemHeight="Auto" ShowCaption="False">
                    <patient:vPatientViewSummary x:Name="PatientViewSummary"/>
                </Xpf:LayoutPanel>
                <Xpf:LayoutPanel ItemHeight="*" ShowCaption="False">
                    <patient:vPatientHistory x:Name="PatientHistory"/>
                </Xpf:LayoutPanel>
            </dxd:LayoutGroup>

            <Xpf:LayoutPanel ItemWidth="*" ShowCaption="False">
                <local:vSmartEMRPayTabPayInfo x:Name="SmartEMRPayTabPayInfo"/>
            </Xpf:LayoutPanel>
        </dxd:LayoutGroup>
    </dxd:DockLayoutManager>
</base:ModelViewLayout>