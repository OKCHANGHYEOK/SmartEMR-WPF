<base:ModelViewLayout x:TypeArguments="vm:PayInfoViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRPay.vSmartEMRPayTabPayInfo"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:local="clr-namespace:SmartEMR.Application.Views.SmartEMRPay"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:template="clr-namespace:SmartEMR.Application.Template"
                      xmlns:selection="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                      xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800"
                      d:DataContext="{d:DesignInstance Type=vm:PayInfoViewModel}">

    <Xpf:StyleGrid LayoutDefinitions="1,7"
                   RowSizeDefinitions="*,Auto,*,Auto,*,Auto,Auto">

        <dxlc:GroupBox  Grid.Row="0"
                        Header="진료정보"
                        FontWeight="Bold"
                        Padding="0"
                        ShowShadow="Never">

            <Xpf:BindGrid LayoutDefinitions="2,6"
                          BindStyle="DataCell"
                          DataContext="{Binding SelectedCST}">

                <Xpf:BindItem FieldName="CST_YYMMDD"
                              Header="진 료 일 자"
                              BindType="Label"
                              Col="0"
                              Row="0"
                              FontWeight="Bold"/>

                <Xpf:BindItem FieldName="CST_Time"
                              Header="진 료 시 간"
                              BindType="Label"
                              Col="1"
                              Row="0"/>

                <Xpf:BindItem FieldName="vCST_Status"
                              Header="상태"
                              BindType="Label"
                              Col="0"
                              Row="1"></Xpf:BindItem>

                <Xpf:BindItem FieldName="vCST_SubjectName"
                              Header="진 료 과 목"
                              BindType="Label"
                              Col="1"
                              Row="1"/>

                <Xpf:BindItem FieldName="vCST_TreatResult"
                              Header="치 료 결 과"
                              BindType="Label"
                              Col="0"
                              Row="2"></Xpf:BindItem>

                <Xpf:BindItem FieldName="MUR_Name_DOC"
                              Header="담 당 의 사"
                              BindType="Label"
                              Col="1"
                              Row="2"/>

                <Xpf:BindItem FieldName="CST_Opinion"
                              Header="진 료 소 견"
                              BindType="TextBox"
                              Col="0"
                              ColSpan="2"
                              Row="3"
                              RowSpan="3"
                              IsEnabled="False"/>
            </Xpf:BindGrid>
        </dxlc:GroupBox>

        <Border Grid.Row="1"
                Height="5" 
                BorderBrush="Gray" 
                BorderThickness="0,1,0,1" 
                Background="#F2F3F5"/>

        <dxlc:GroupBox Grid.Row="2"
                       Header="처방내역"
                       FontWeight="Bold"
                       Padding="0"
                       ShowShadow="Never">

            <Xpf:DataGrid   ItemsSource="{Binding ConsultationOrders}">
                <Xpf:DataGrid.RowStyle>
                    <Style TargetType="{x:Type dxg:GridRowContent}">
                        <Setter Property="Height" Value="23"/>
                        <Setter Property="MaxHeight" Value="23"/>
                        <Setter Property="Visibility" Value="Visible"/>

                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Row.IsVisible}" Value="False">
                                <Setter Property="Height" Value="0"/>
                                <Setter Property="MaxHeight" Value="0"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Xpf:DataGrid.RowStyle>

                <Xpf:DataGrid.GroupRowTemplate>
                    <DataTemplate>
                        <Xpf:StyleGrid  LayoutDefinitions="2,1"
                                        ColumnSizeDefinitions="Auto,*"
                                        Background="#C9CED3"
                                        Height="25">

                            <Xpf:Label FontSize="9"
                                       Margin="2,0,2,0"
                                       VerticalAlignment="Center">
                                <Xpf:Label.Style>
                                    <Style TargetType="Xpf:Label">
                                        <Setter Property="Content" Value="▶"/>

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRowExpanded}" Value="True">
                                                <Setter Property="Content" Value="◢"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Xpf:Label.Style>
                            </Xpf:Label>

                            <Xpf:TextBlock  Grid.Column="1"
                                            Text="{Binding Row.CSTO_InsuranceTypeName, Converter={local:InsuranceTypeNameToContentConverter}}"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Stretch"
                                            Margin="2,0,0,0">
                            </Xpf:TextBlock>
                        </Xpf:StyleGrid>
                    </DataTemplate>
                </Xpf:DataGrid.GroupRowTemplate>

                <Xpf:ColumnItem FieldName="CSTO_InsuranceTypeName"
                                Header=" "
                                GroupIndex="0"
                                ColumnWidth="0"
                                Visible="False"/>

                <Xpf:ColumnItem FieldName="ORDC_Cd"
                                Header="구분"
                                ColumnWidth="55"
                                CellTemplateType="{x:Type template:OrderTypeTemplate}"/>

                <Xpf:ColumnItem FieldName="CSTO_SugaCode"
                                Header="코드"
                                ColumnWidth="65"
                                ColumnStyle="Code"
                                Foreground="DimGray"/>

                <Xpf:ColumnItem FieldName="CSTO_Price"
                                Header="단가"
                                ColumnWidth="50"
                                ColumnStyle="Sum"
                                DisplayFormat="#,##0"
                                Suffix="원"/>

                <Xpf:ColumnItem FieldName="CSTO_Name"
                                Header="오더명"
                                ColumnWidth="200"
                                ColumnStyle="Name"/>

                <Xpf:ColumnItem FieldName="CSTO_Day"
                                Header="일수"
                                ColumnWidth="40"
                                HorizontalAlignment="Center"/>

                <Xpf:ColumnItem FieldName="CSTO_Count"
                                Header="일투"
                                ColumnWidth="40"
                                HorizontalAlignment="Center"/>

                <Xpf:ColumnItem FieldName="CSTO_Amount"
                                Header="총투"
                                ColumnWidth="40"
                                HorizontalAlignment="Center"/>

                <Xpf:ColumnItem FieldName="CSTO_TotalPrice"
                                Header="총액"
                                ColumnWidth="60"
                                ColumnStyle="Sum"
                                DisplayFormat="#,##0"
                                Suffix="원"/>

                <Xpf:ColumnItem FieldName="MUR_Name_DOC"
                                Header="처방의"
                                ColumnWidth="60"
                                HorizontalAlignment="Center"/>
            </Xpf:DataGrid>
        </dxlc:GroupBox>

        <Border Grid.Row="3"
                Height="5" 
                BorderBrush="Gray" 
                BorderThickness="0,1,0,1" 
                Background="#F2F3F5"/>

        <dxlc:GroupBox Grid.Row="4"
                       Header="수납정보"
                       FontWeight="Bold"
                       Padding="0"
                       ShowShadow="Never">

            <Xpf:StyleGrid LayoutDefinitions="1,3"
                           RowSizeDefinitions="Auto,Auto,*">

                <Xpf:BindGrid   Grid.Row="0"
                                LayoutDefinitions="2,4"
                                BindStyle="DataCell"
                                HeaderWidth="100"
                                ItemSpace="1">

                    <Xpf:BindItem   FieldName="PAY_InsuredPrice"
                                    Header="급 여 진 료 비"
                                    BindType="TextBox"
                                    HeaderFontWeight="SemiBold"
                                    Col="0"
                                    Row="0"
                                    IsReadOnly="True"/>

                    <Xpf:BindItem   FieldName="PAY_NonInsuredPrice"
                                    Header="비 급 여 진 료 비"
                                    BindType="TextBox"
                                    HeaderFontWeight="SemiBold"
                                    Col="1"
                                    Row="0"
                                    IsReadOnly="True"/>

                    <Xpf:BindItem   FieldName="PAY_TotalPrice"
                                    Header="총 진 료 비"
                                    BindType="TextBox"
                                    HeaderFontWeight="SemiBold"
                                    Col="0"
                                    Row="1"
                                    IsReadOnly="True"/>

                    <x:Array Type="{x:Type Xpf:BindItem}">
                        <Xpf:BindItem   FieldName="PAY_PaidPrice"
                                        Header="기 수 납 금"
                                        HeaderFontWeight="Bold"
                                        HeaderForeground="#007FFF"
                                        BindType="TextBox"
                                        Col="1"
                                        Row="1"
                                        IsReadOnly="True"/>

                        <Xpf:BindItem   FieldName="btnRefund"
                                        Header=""
                                        IsBinding="False"
                                        IsBindClickEvent="True">

                            <dxc:SimpleButton   Content="환불"
                                                Background="#FBECEC"
                                                Foreground="#B84242"
                                                FontWeight="SemiBold"
                                                BorderBrush="#E2B0B0"
                                                Glyph="/Images/smartemr_pay_refund.png"
                                                GlyphWidth="20"
                                                GlyphHeight="20"
                                                Padding="2"/>
                        </Xpf:BindItem>
                    </x:Array>

                    <x:Array Type="{x:Type Xpf:BindItem}">
                        <Xpf:BindItem   FieldName="PAY_RemainPrice"
                                        Header="미 수 납 금"
                                        BindType="TextBox"
                                        HeaderFontWeight="SemiBold"
                                        HeaderForeground="#DC2626"
                                        Col="0"
                                        ColSpan="2"
                                        Row="2"
                                        IsReadOnly="True"/>

                        <Xpf:BindItem   FieldName="PAY_DiscountPrice"
                                        BindType="TextBox"
                                        Width="127"
                                        Placeholder="할인금액 입력"
                                        IsNumericOnly="True"/>

                        <Xpf:BindItem   FieldName="PAY_CutUnit"
                                        BindType="ComboBox"
                                        Width="100"
                                        ItemsSource="{x:Static selection:InputOptionItems.PayCutUnits}"
                                        DisplayMember="attrName"
                                        ValueMember="attrValue"/>

                        <Xpf:BindItem   FieldName="btnDiscount"
                                        Width="100"
                                        IsBinding="False"
                                        IsBindClickEvent="True">

                            <dxc:SimpleButton   Content="할인"
                                                Background="#E8F1F8"
                                                Foreground="#3F6B89"
                                                FontWeight="SemiBold"
                                                Glyph="/Images/smartemr_discount.png"
                                                GlyphWidth="16"
                                                GlyphHeight="16"
                                                Padding="2"/>
                        </Xpf:BindItem>

                        <Xpf:BindItem   FieldName="btnCutting"
                                        Width="100"
                                        IsBinding="False"
                                        IsBindClickEvent="True">

                            <dxc:SimpleButton   Content="절사"
                                                Background="#F3F0E8"
                                                Foreground="#756A4F"
                                                FontWeight="SemiBold"
                                                Glyph="/Images/smartmer_cutting.png"
                                                GlyphWidth="16"
                                                GlyphHeight="16"
                                                Padding="2"/>
                        </Xpf:BindItem>
                    </x:Array>

                    <x:Array Type="{x:Type Xpf:BindItem}">
                        <Xpf:BindItem   FieldName="PAY_PriceForPay"
                                        Header="수 납 금 액"
                                        BindType="TextBox"
                                        Col="0"
                                        ColSpan="2"
                                        Row="3"
                                        Placeholder="금액입력"
                                        IsNumericOnly="True"/>

                        <Xpf:BindItem   FieldName="btnCash"
                                        Header=""
                                        Width="100"
                                        IsBinding="False"
                                        IsBindClickEvent="True">

                            <dxc:SimpleButton   Content="현금결제"
                                                Background="#EAF5EC"
                                                Foreground="#287A3D"
                                                BorderBrush="#A8D5B2"
                                                FontWeight="SemiBold"
                                                Glyph="/Images/smartemr_pay_cash.png"
                                                GlyphWidth="20"
                                                GlyphHeight="20"
                                                Padding="2"/>
                        </Xpf:BindItem>

                        <Xpf:BindItem   FieldName="btnCard"
                                        Header=""
                                        Width="100"
                                        IsBinding="False"
                                        IsBindClickEvent="True">

                            <dxc:SimpleButton   Content="카드결제"
                                                Background="#EAF1F8"
                                                Foreground="#32658F"
                                                BorderBrush="#A9C5DD"
                                                FontWeight="SemiBold"
                                                Glyph="/Images/smartemr_pay_card.png"
                                                GlyphWidth="20"
                                                GlyphHeight="20"
                                                Padding="2"/>
                        </Xpf:BindItem>

                        <Xpf:BindItem   FieldName="btnNaverPay"
                                        Header=""
                                        Width="100"
                                        IsBinding="False"
                                        IsBindClickEvent="True">

                            <dxc:SimpleButton   Content="네이버페이"
                                                Background="#E9F7EE"
                                                Foreground="#20803C"
                                                BorderBrush="#A5D6B5"
                                                FontWeight="SemiBold"
                                                Glyph="/Images/smartemr_pay_naver.png"
                                                GlyphWidth="20"
                                                GlyphHeight="20"
                                                Padding="2"/>
                        </Xpf:BindItem>
                    </x:Array>
                </Xpf:BindGrid>

                <Border Grid.Row="1" Height="1" Background="LightGray" Margin="0,1,0,1"/>

                <Xpf:DataGrid Grid.Row="2">
                    <Xpf:ColumnItem FieldName="PAYI_YYMMDD"
                                    Header="처리일자"
                                    ColumnWidth="80"/>

                    <Xpf:ColumnItem FieldName="PAYI_Time"
                                    Header="시간"
                                    ColumnWidth="50"/>

                    <Xpf:ColumnItem FieldName="PAYI_Type"
                                    Header="구분"
                                    ColumnWidth="50"/>

                    <Xpf:ColumnItem FieldName="PAYI_Method"
                                    Header="결제방식"
                                    ColumnWidth="45"
                                    CellTemplateType="{x:Type template:PAYIMethodTemplate}"/>

                    <Xpf:ColumnItem FieldName="PAYI_Price"
                                    Header="금액"
                                    ColumnWidth="80"
                                    DisplayFormat="#,##0"
                                    Suffix="원"/>

                    <Xpf:ColumnItem FieldName="MUR_Name"
                                    Header="처리자"
                                    ColumnWidth="80"/>
                </Xpf:DataGrid>
            </Xpf:StyleGrid>
        </dxlc:GroupBox>

        <Border Grid.Row="5"
                Height="1"
                Background="LightGray"/>

        <Xpf:StyleGrid Grid.Row="6"
                       LayoutDefinitions="5,1"
                       Margin="2">

            <dxc:SimpleButton   Grid.Column="0"
                                Content="수납취소"
                                FontWeight="SemiBold"
                                Background="#F3F3F3"
                                Margin="1,0,1,0"
                                dxc:ThemeManager.ThemeName="Office2019Colorful"/>

            <dxc:SimpleButton   Grid.Column="4"
                                Content="수납완료"
                                FontWeight="SemiBold"
                                Background="#3F6B89"
                                Foreground="#FFFFFF"
                                Margin="1,0,1,0"
                                dxc:ThemeManager.ThemeName="Office2019Colorful"/>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>