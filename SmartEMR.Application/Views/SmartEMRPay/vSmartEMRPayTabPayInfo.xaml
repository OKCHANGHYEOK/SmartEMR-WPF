<base:ModelViewLayout x:TypeArguments="vm:PayInfoViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRPay.vSmartEMRPayTabPayInfo"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:template="clr-namespace:SmartEMR.Application.Template"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      xmlns:dxlc="http://schemas.devexpress.com/winfx/2008/xaml/layoutcontrol"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800"
                      d:DataContext="{d:DesignInstance Type=vm:PayInfoViewModel}">

    <Xpf:StyleGrid LayoutDefinitions="1,7"
                   RowSizeDefinitions="*,Auto,*,Auto,*,Auto,Auto">

        <dxlc:GroupBox  Grid.Row="0"
                        Header="진료정보"
                        FontWeight="Bold"
                        Padding="0">
            
            <Xpf:BindGrid LayoutDefinitions="2,6"
                          BindStyle="DataCell"
                          DataContext="{Binding SelectedCST}">

                <Xpf:BindItem FieldName="CST_YYMMDD"
                              Header="진 료 일 자"
                              BindType="Label"
                              Col="0"
                              Row="0"/>

                <Xpf:BindItem FieldName="CST_Time"
                              Header="진 료 시 간"
                              BindType="Label"
                              Col="1"
                              Row="0"/>

                <Xpf:BindItem FieldName="CST_Status"
                              Header="상태"
                              BindType="Label"
                              Col="0"
                              Row="1"></Xpf:BindItem>

                <Xpf:BindItem FieldName="vCST_Subject"
                              Header="진 료 과 목"
                              BindType="Label"
                              Col="1"
                              Row="1"/>

                <Xpf:BindItem FieldName="CST_TreatResult"
                              Header="치 료 결 과"
                              BindType="Label"
                              Col="0"
                              Row="2"></Xpf:BindItem>

                <Xpf:BindItem FieldName="MUR_Name_DOC"
                              Header="담 당 의 사"
                              BindType="Label"
                              Col="1"
                              Row="2"/>

                <Xpf:BindItem FieldName="CST_Opinion"
                              Header="진 료 소 견"
                              BindType="TextBox"
                              Col="0"
                              ColSpan="2"
                              Row="3"
                              RowSpan="3"
                              IsEnabled="False"/>
            </Xpf:BindGrid>
        </dxlc:GroupBox>

        <Border Grid.Row="1"
                Height="5" 
                BorderBrush="Gray" 
                BorderThickness="0,1,0,1" 
                Background="#F2F3F5"/>

        <dxlc:GroupBox Grid.Row="2"
                       Header="처방내역"
                       FontWeight="Bold"
                       Padding="0">


            <Xpf:DataGrid>
                <Xpf:ColumnItem FieldName="ORDC_Cd"
                                Header=" "
                                ColumnWidth="48"
                                CellTemplateType="{x:Type template:OrderTypeTemplate}"/>

                <Xpf:ColumnItem FieldName="CSTO_SugaCode"
                                Header="코드"
                                ColumnWidth="65"
                                ColumnStyle="Code"
                                Foreground="DimGray"/>

                <Xpf:ColumnItem FieldName="CSTO_Price"
                                Header="단가"
                                ColumnWidth="50"
                                ColumnStyle="Sum"/>

                <Xpf:ColumnItem FieldName="CSTO_Name"
                                Header="오더명"
                                ColumnWidth="240"
                                ColumnStyle="Name"/>

                <Xpf:ColumnItem FieldName="CSTO_Day"
                                Header="일수"
                                ColumnWidth="45"/>

                <Xpf:ColumnItem FieldName="CSTO_Count"
                                Header="일투"
                                ColumnWidth="45"/>

                <Xpf:ColumnItem FieldName="CSTO_Amount"
                                Header="총투"
                                ColumnWidth="45"/>

                <Xpf:ColumnItem FieldName="CSTO_TotalPrice"
                                Header="총액"
                                ColumnType="TextEdit"
                                ColumnWidth="50"
                                IsReadOnly="True"/>

                <Xpf:ColumnItem FieldName="MUR_Idx_DOC"
                                Header="처방의"
                                ColumnType="ComboBox"
                                ColumnWidth="60"/>
            </Xpf:DataGrid>
        </dxlc:GroupBox>

        <Border Grid.Row="3"
                Height="5" 
                BorderBrush="Gray" 
                BorderThickness="0,1,0,1" 
                Background="#F2F3F5"/>
        
        <dxlc:GroupBox Grid.Row="4"
                       Header="수납정보"
                       FontWeight="Bold"
                       Padding="0">


            
        </dxlc:GroupBox>

        <Border Grid.Row="5"
                Height="1"
                Background="LightGray"/>

        <Xpf:StyleGrid Grid.Row="6"
                       LayoutDefinitions="3,1"
                       ColumnSizeDefinitions="Auto,*,Auto"
                       Margin="2">

            <dxc:SimpleButton Grid.Column="0"
                              Content="초기화"
                              FontWeight="SemiBold"
                              Width="100"
                              Height="23"
                              Glyph="/Images/smartemr_empty_paper_white.png"
                              GlyphWidth="16"
                              GlyphHeight="16"
                              Padding="2"
                              dxc:ThemeManager.ThemeName="Office2019Colorful"/>


            <dxc:SimpleButton Grid.Column="2"
                              Content="수납완료"
                              FontWeight="SemiBold"
                              Width="100"
                              Height="23"
                              Glyph="/Images/smartemr_payment.png"
                              GlyphWidth="16"
                              GlyphHeight="16"
                              Padding="2"
                              dxc:ThemeManager.ThemeName="Office2019Colorful"/>
        </Xpf:StyleGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>