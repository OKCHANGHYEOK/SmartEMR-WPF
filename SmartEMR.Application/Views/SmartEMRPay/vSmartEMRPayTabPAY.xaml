<base:ModelViewLayout x:TypeArguments="vm:PayViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRPay.vSmartEMRPayTabPAY"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:selections="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      xmlns:template="clr-namespace:SmartEMR.Application.Template"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800"
                      d:DataContext="{d:DesignInstance Type=vm:PayViewModel}">

    <Xpf:StyleGrid LayoutDefinitions="1,3"
                   RowSizeDefinitions="Auto,Auto,*">

        <Xpf:BindGrid Grid.Row="0"
                      LayoutDefinitions="5,2"
                      Background="#F5F5F5"
                      ItemSpace="2">

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="PAY_YYMMDD"
                                BindType="DateEdit"
                                Col="0"
                                ColSpan="3"
                                FontWeight="Bold"
                                Converter="{converter:DateTimeToStringConverter ValueFormat='yyyy-MM-dd',DisplayFormat='yyyy년 MM월 dd일 dddd'}"/>

                <Xpf:BindItem   FieldName="btnToday"
                                BindType="Button"
                                Width="40"
                                IsBinding="False"
                                IsBindClickEvent="True">

                    <dxc:SimpleButton Content="오늘"
                                      dxc:ThemeManager.ThemeName="Office2019White"/>
                </Xpf:BindItem>
            </x:Array>

            <Xpf:BindItem   FieldName="CST_Status"
                            BindType="ComboBox"
                            Col="3"
                            ItemsSource="{x:Static selections:SearchFilterItems.ConsultationStatues}"
                            DisplayMember="CCI_Name"
                            ValueMember="CCI_Cd"/>

            <Xpf:BindItem   FieldName="PAY_Status"
                            BindType="ComboBox"
                            Col="4"
                            ItemsSource="{x:Static selections:SearchFilterItems.PayStatuses}"
                            DisplayMember="CCI_Name"
                            ValueMember="CCI_Cd"/>

            <Xpf:BindItem   FieldName="Keyword"
                            Col="0"
                            ColSpan="5"
                            Row="1">
                <Xpf:SearchPanel    NullText="환자명/차트번호로 검색하세요."
                                    SearchCommand="{Binding SearchCommand}"/>
            </Xpf:BindItem>
        </Xpf:BindGrid>

        <Border Grid.Row="1" Height="1" Background="LightGray" Margin="0,2,0,2"/>

        <Xpf:DataGrid Grid.Row="2"
                      ItemsSource="{Binding Pays}">
            <Xpf:ColumnItem FieldName="vCST_Status"
                            Header="진료"
                            ColumnWidth="50"
                            CellTemplateType="{x:Type template:CSTStatusTemplate}"/>

            <Xpf:ColumnItem FieldName="vPAY_Status"
                            Header="수납"
                            ColumnWidth="50"
                            CellTemplateType="{x:Type template:PAYStatusTemplate}"/>

            <Xpf:ColumnItem FieldName="PAT_ChartNo"
                            Header="차트번호"
                            ColumnWidth="90"/>

            <Xpf:ColumnItem FieldName="PAT_Name"
                            Header="환자명"
                            ColumnType="TextLink"
                            ColumnWidth="80"/>

            <Xpf:ColumnItem FieldName="vPAT_Info"
                            Header=" "
                            ColumnWidth="45"/>

            <Xpf:ColumnItem FieldName="PAY_TotalPrice"
                            Header="총진료비"
                            ColumnWidth="90"
                            ColumnStyle="Sum"
                            Foreground="#2F3E46"
                            FontWeight="SemiBold"
                            DisplayFormat="#,##0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_PaidPrice"
                            Header="기수납금"
                            ColumnWidth="90"
                            ColumnStyle="Sum"
                            Foreground="DarkSlateGray"
                            DisplayFormat="#,##0"
                            Suffix="원"/>

            <Xpf:ColumnItem FieldName="PAY_RemainPrice"
                            Header="미수납금"
                            ColumnWidth="90"
                            ColumnStyle="Sum"
                            Foreground="#DC2626"
                            FontWeight="Bold"
                            DisplayFormat="#,##0"
                            Suffix="원"/>
        </Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>