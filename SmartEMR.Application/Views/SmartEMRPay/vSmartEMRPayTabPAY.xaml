<base:ModelViewLayout x:TypeArguments="vm:PayViewModel"
                      x:Class="SmartEMR.Application.Views.SmartEMRPay.vSmartEMRPayTabPAY"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                      xmlns:base="clr-namespace:SmartEMR.Application.ViewBase"
                      xmlns:vm="clr-namespace:SmartEMR.Application.ViewModels"
                      xmlns:common="clr-namespace:SmartEMR.Application.Common"
                      xmlns:converter="clr-namespace:SmartEMR.Application.Common.Converter"
                      xmlns:selections="clr-namespace:SmartEMR.Application.Common.SelectionItems"
                      xmlns:dxc="http://schemas.devexpress.com/winfx/2008/xaml/core"
                      mc:Ignorable="d"
                      d:DesignHeight="450"
                      d:DesignWidth="800">

    <Xpf:StyleGrid LayoutDefinitions="1,3"
                   RowSizeDefinitions="Auto,Auto,*">

        <Xpf:BindGrid Grid.Row="0"
                      LayoutDefinitions="3,1"
                      ColumnSizeDefinitions="Auto,Auto,*"
                      Background="#F5F5F5"
                      ItemSpace="2">

            <x:Array Type="{x:Type Xpf:BindItem}">
                <Xpf:BindItem   FieldName="PAY_YYMMDD"
                                BindType="DateEdit"
                                Col="0"
                                Width="200"
                                FontWeight="Bold"
                                Converter="{converter:DateTimeToStringConverter ValueFormat='yyyy-MM-dd',DisplayFormat='yyyy년 MM월 dd일 dddd'}"/>

                <Xpf:BindItem   FieldName="btnToday"
                                BindType="Button"
                                Width="40">

                    <dxc:SimpleButton Content="오늘"
                                      dxc:ThemeManager.ThemeName="Office2019White"/>
                </Xpf:BindItem>
            </x:Array>

            <Xpf:BindItem   FieldName="PAY_Status"
                            BindType="ComboBox"
                            Col="1"
                            ItemsSource="{x:Static selections:InputOptionItems.PayStatuses}"
                            DisplayMember="CCI_Name"
                            ValueMember="CCI_Cd"/>

            <Xpf:BindItem   FieldName="keyword"
                            Col="2">

                <Xpf:SearchPanel NullText="환자명/차트번호로 검색하세요."/>
            </Xpf:BindItem>
        </Xpf:BindGrid>

        <Border Grid.Row="1" Height="1" Background="LightGray" Margin="0,2,0,2"/>

        <Xpf:DataGrid Grid.Row="2">
            
        </Xpf:DataGrid>
    </Xpf:StyleGrid>
</base:ModelViewLayout>