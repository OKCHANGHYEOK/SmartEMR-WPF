<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:Xpf="clr-namespace:SmartEMR.Application.Xpf"
                    xmlns:bar="clr-namespace:SmartEMR.Application.Xpf.Bar"
                    xmlns:dxb="http://schemas.devexpress.com/winfx/2008/xaml/bars"
                    xmlns:common="clr-namespace:SmartEMR.Application.Common"
                    xmlns:Conveter="clr-namespace:SmartEMR.Application.Common.Converter"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <Conveter:StringAndFocusToVisiblityConverter x:Key="StringAndFocusToVisiblityConverter"/>

        <!--#region Xpf.Button -->
    <Style TargetType="{x:Type Xpf:Button}">
        <Setter Property="MinWidth" Value="42"></Setter>
        <Setter Property="MinHeight" Value="22"></Setter>
        <Setter Property="BorderBrush" Value="#DCDCDC"></Setter>
        <Setter Property="BorderThickness" Value="1"></Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"></Setter>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"></ScaleTransform>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Xpf:Button}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">

                        <Xpf:StyleGrid  LayoutDefinitions="4,1"
                                        ColumnSizeDefinitions="*,Auto,Auto,*"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                            <Image  x:Name="PART_IMAGE"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Source="{TemplateBinding Glyph}" 
                                    Width="18" 
                                    Height="18" 
                                    Stretch="Uniform"/>

                            <ContentPresenter   Grid.Row="0"
                                                Grid.Column="2"
                                                Margin="5,2,5,2">
                            </ContentPresenter>
                        </Xpf:StyleGrid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8"></Setter>
                            <Setter Property="Cursor" Value="Hand"></Setter>
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="1"></Setter>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>

                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="PART_IMAGE" Value="Collapsed"></Setter>
                        </Trigger>

                        <Trigger Property="ButtonTheme" Value="White">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                        <GradientStop Color="#CCCCCC" Offset="1.0"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsPressed" Value="True"/>
                                <Condition Property="IsExpandingWhenClick" Value="True"/>
                            </MultiTrigger.Conditions>

                            <Setter Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.05" ScaleY="1.05"/>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>    
            </Setter.Value>
        </Setter>
    </Style>
    <!-- #endregion -->

    <!-- #region Xpf.StyleTextBox -->
    
    <Style TargetType="{x:Type Xpf:StyleTextBox}">
        <Setter Property="TextBoxType" Value="Text"/>
        <Setter Property="MinWidth" Value="30"/>
        <Setter Property="MinHeight" Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Xpf:StyleTextBox}">
                    <Xpf:StyleGrid x:Name="TemplateRoot">
                        <Border x:Name="TemplateBorder"
                                Background="White"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Margin="{TemplateBinding Margin}">

                            <Grid>
                                <Xpf:TextEdit   x:Name="PART_TextBox"
                                                EditValue="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Foreground="{Binding TextForeground, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                BorderBrush="Transparent"
                                                BorderThickness="0"
                                                Width="{TemplateBinding Width}"
                                                HorizontalAlignment="Stretch"
                                                VerticalAlignment="Stretch"
                                                Padding="5"
                                                Focusable="{TemplateBinding Focusable}"
                                                IsReadOnly="{TemplateBinding IsReadOnly}">

                                    <Xpf:TextEdit.Style>
                                        <Style TargetType="dxe:TextEdit">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="MaskType" Value="None"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsReadOnly" Value="True">
                                                    <Setter Property="Background" Value="#E9ECEF"/>
                                                    <Setter Property="Foreground" Value="#495057"/>
                                                </Trigger>

                                                <DataTrigger Binding="{Binding IsNumericOnly, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                    <Setter Property="MaskType" Value="RegEx"/>
                                                    <Setter Property="Mask" Value="{Binding MaxLength, RelativeSource={RelativeSource TemplatedParent}, StringFormat='\\d{{0,{0}}}'}"/>
                                                    <Setter Property="MaskUseAsDisplayFormat" Value="True"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding ContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" Value="LeftTop">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding ContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" Value="LeftCenter">
                                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </DataTrigger>

                                                <DataTrigger Binding="{Binding ContentAlignment, RelativeSource={RelativeSource TemplatedParent}}" Value="CenterCenter">
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Xpf:TextEdit.Style>
                                </Xpf:TextEdit>
                                <Xpf:PasswordBox    x:Name="PART_PasswordBox"
                                                    Password="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                    Background="Transparent"
                                                    VerticalAlignment="Stretch"
                                                    VerticalContentAlignment="Center"
                                                    Padding="5">
                                </Xpf:PasswordBox>
                            </Grid>
                        </Border>
                        <Label x:Name="lblPlaceHolder" 
                               Content="{TemplateBinding Placeholder}" 
                               Foreground="#bbbbbb" 
                               HorizontalContentAlignment="{TemplateBinding PlaceHolderHorizontalAlignment}"
                               VerticalAlignment="Center" 
                               Margin="{TemplateBinding PlaceHolderMargin}"
                               Padding="{TemplateBinding PlaceHolderPadding}"
                               BorderBrush="Transparent"
                               BorderThickness="0"
                               IsHitTestVisible="False">

                            <Label.Visibility>
                                <MultiBinding Converter="{StaticResource StringAndFocusToVisiblityConverter}">
                                    <Binding Path="Text" RelativeSource="{RelativeSource TemplatedParent}"></Binding>
                                    <Binding Path="IsKeyboardFocusWithin" RelativeSource="{RelativeSource TemplatedParent}"></Binding>
                                </MultiBinding>
                            </Label.Visibility>
                        </Label>       
                    </Xpf:StyleGrid>
                    <ControlTemplate.Triggers>
                        <!-- TextBoxType에 따라 TextBox와 PasswordBox의 가시성을 제어하는 트리거 -->
                        <Trigger Property="TextBoxType" Value="Text">
                            <Setter TargetName="PART_TextBox" Property="Visibility" Value="Visible"></Setter>
                            <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Collapsed"></Setter>
                        </Trigger>
                        <Trigger Property="TextBoxType" Value="Password">
                            <Setter TargetName="PART_TextBox" Property="Visibility" Value="Collapsed"></Setter>
                            <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Visible"></Setter>
                        </Trigger>
                        
                        <!-- 포커스 있을 때 보더 색상 변경 -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="TemplateBorder" Property="BorderBrush" Value="#007ACC"></Setter>
                            <Setter TargetName="TemplateBorder" Property="BorderThickness" Value="1"></Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!--#endregion -->

    <Style TargetType="{x:Type bar:BarItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type bar:BarItem}">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            Width="80">
                        <Xpf:StyleGrid x:Name="ItemPanel" LayoutDefinitions="1,2" RowSizeDefinitions="*,Auto">
                            <Image  Grid.Row="0" 
                                    Width="{TemplateBinding ImageWidth}" 
                                    Height="{TemplateBinding ImageHeight}" 
                                    Source="{TemplateBinding Glyph}" 
                                    Stretch="UniformToFill" 
                                    VerticalAlignment="Center" 
                                    HorizontalAlignment="Center" />
                            <TextBlock  Grid.Row="1"
                                        Text="{TemplateBinding Content}"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        Margin="0,3,0,3"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"/>
                        </Xpf:StyleGrid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ItemPanel" Property="Opacity" Value="0.8"/>
                            <Setter TargetName="ItemPanel" Property="Cursor" Value="Hand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Xpf:ImageButton}">
        <Setter Property="Background" Value="#F1F3F5"/>
        <Setter Property="Padding" Value="0"/>
        <!-- 컨트롤 전체 패딩 초기화 -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Xpf:ImageButton}">
                    <Button x:Name="PART_BUTTON"
                        Width="{TemplateBinding Width}"
                        Height="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        BorderThickness="1"
                        Padding="0" 
                        HorizontalContentAlignment="Center" 
                        VerticalContentAlignment="Center">
                        <!-- Image 태그에 Margin을 0으로 설정하여 간섭 제거 -->
                        <Image Source="{TemplateBinding Glyph}" 
                           Width="{TemplateBinding ImageWidth}" 
                           Height="{TemplateBinding ImageHeight}" 
                           Stretch="Uniform"
                           Margin="0"
                           VerticalAlignment="Center" 
                           HorizontalAlignment="Center"/>
                    </Button>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type Xpf:FloatPanel}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Width" Value="{Binding Content.ViewSize.Width, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Height" Value="{Binding Content.ViewSize.Height, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Xpf:FloatPanel}">
                    <Border x:Name="PART_BORDER"
                            BorderBrush="#64748B"
                            BorderThickness="1"
                            Background="White"
                            CornerRadius="2"
                            ClipToBounds="True">

                        <Xpf:StyleGrid  LayoutDefinitions="1,3"
                                        RowSizeDefinitions="25,Auto,*">

                            <Xpf:StyleGrid x:Name="PART_TITLE"
                                       LayoutDefinitions="3,1"
                                       ColumnSizeDefinitions="Auto,*,Auto"
                                       Grid.Row="0" 
                                       Grid.Column="0"
                                       Background="#3A414A"
                                       Padding="8,0,6,0">
                                <TextBlock  Grid.Column="0"
                                            FontSize="11" 
                                            Foreground="#FFFFFF"
                                            Text="{Binding Content.ViewTitle, RelativeSource={RelativeSource TemplatedParent}}" 
                                            VerticalAlignment="Center"
                                            Margin="5,0,0,0"/>

                                <Button Grid.Column="2"
                                        Width="16"
                                        Height="16"
                                        Background="Transparent"
                                        BorderBrush="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Margin="0,0,3,0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="Transparent" x:Name="btnBorder">
                                                            <TextBlock Text="✕" 
                                                                   Foreground="#DDE6F2" 
                                                                   FontSize="11" 
                                                                   HorizontalAlignment="Center" 
                                                                   VerticalAlignment="Center"
                                                                   x:Name="btnText"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="btnText" Property="Foreground" Value="White"/>
                                                                <Setter TargetName="btnBorder" Property="Background" Value="#3D6CB4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Xpf:StyleGrid>

                            <Border x:Name="PART_SPLITBORDER"
                                Grid.Row="1"
                                Grid.Column="0"
                                Background="#1F447B"
                                Height="1"/>

                            <ContentPresenter   Grid.Row="2" 
                                                Grid.Column="0" 
                                                Content="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                                Margin="5"/>
                        </Xpf:StyleGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>